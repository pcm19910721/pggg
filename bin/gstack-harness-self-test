#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TEMPLATE_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
INIT="$SCRIPT_DIR/gstack-harness-init"

TMP_ROOT="${TMPDIR:-/tmp}/gstack-harness-self-test-$$"
INSTALL_DIR="$TMP_ROOT/install"
PRESERVE_DIR="$TMP_ROOT/preserve"
FAKE_BIN="$TMP_ROOT/fake-bin"

cleanup() {
  rm -rf "$TMP_ROOT"
}
trap cleanup EXIT

log() {
  printf '%s\n' "$*"
}

fail() {
  printf 'FAIL %s\n' "$*" >&2
  exit 1
}

pass() {
  printf 'PASS %s\n' "$*"
}

assert_file() {
  [ -f "$1" ] || fail "missing file: $1"
}

assert_contains() {
  local file="$1"
  local pattern="$2"
  if ! grep -Fq -- "$pattern" "$file"; then
    fail "expected '$pattern' in $file"
  fi
}

assert_json_field() {
  local file="$1"
  local expr="$2"
  local message="$3"
  node -e "
    const fs = require('fs');
    const state = JSON.parse(fs.readFileSync(process.argv[1], 'utf8'));
    if (!($expr)) {
      console.error(process.argv[2]);
      process.exit(1);
    }
  " "$file" "$message" || fail "$message"
}

assert_no_trailing_whitespace() {
  local file="$1"
  if grep -nE '[[:blank:]]+$' "$file" >/tmp/gstack-harness-trailing.$$ 2>/dev/null; then
    sed -n '1,20p' /tmp/gstack-harness-trailing.$$ >&2
    rm -f /tmp/gstack-harness-trailing.$$
    fail "trailing whitespace in $file"
  fi
  rm -f /tmp/gstack-harness-trailing.$$
}

require_node() {
  command -v node >/dev/null 2>&1 || fail "node is required for JSON validation"
}

setup_fake_tools() {
  mkdir -p "$FAKE_BIN"
  cat > "$FAKE_BIN/gbrain" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

case "${1:-}" in
  --version)
    printf 'gbrain-test 0.0.0\n'
    ;;
  list)
    for project in install preserve indexed runtime; do
      printf 'project/%s/overview\n' "$project"
      printf 'project/%s/state\n' "$project"
      printf 'project/%s/foundation-readiness\n' "$project"
      printf 'project/%s/code-context\n' "$project"
      printf 'project/%s/quality-gates\n' "$project"
      printf 'project/%s/gitnexus-index\n' "$project"
      printf 'project/%s/architecture\n' "$project"
      printf 'project/%s/hotspots\n' "$project"
      printf 'project/%s/handoff\n' "$project"
    done
    if [ -n "${GBRAIN_STORE_PATH:-}" ] && [ -f "$GBRAIN_STORE_PATH" ]; then
      cat "$GBRAIN_STORE_PATH"
    fi
    printf 'system/orchestration-principles\n'
    ;;
  get)
    slug="${2:-}"
    if [ -n "${GBRAIN_CONTENT_DIR:-}" ]; then
      file="$GBRAIN_CONTENT_DIR/${slug//\//__}.md"
      if [ -f "$file" ]; then
        cat "$file"
        exit 0
      fi
    fi
    case "$slug" in
      project/install/*|project/preserve/*|project/indexed/*|project/runtime/*)
        if [ -n "${GBRAIN_STORE_PATH:-}" ] && [ -f "$GBRAIN_STORE_PATH" ] && grep -Fxq "$slug" "$GBRAIN_STORE_PATH"; then
          printf '# %s\n' "$slug"
        fi
        ;;
      *)
        if [ -n "${GBRAIN_STORE_PATH:-}" ] && [ -f "$GBRAIN_STORE_PATH" ] && grep -Fxq "$slug" "$GBRAIN_STORE_PATH"; then
          printf '# %s\n' "$slug"
        else
          exit 1
        fi
        ;;
    esac
    ;;
  query)
    printf 'query completed\n'
    ;;
  put)
    slug="${2:-}"
    if [ -n "${GBRAIN_FAIL_PUT:-}" ]; then
      printf 'simulated gbrain put failure for %s\n' "$slug" >&2
      exit 42
    fi
    content=""
    shift 2 || true
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --content)
          content="${2:-}"
          shift 2
          ;;
        *)
          shift
          ;;
      esac
    done
    if [ -n "${GBRAIN_LOG_PATH:-}" ]; then
      printf 'put\t%s\n' "$slug" >> "$GBRAIN_LOG_PATH"
    fi
    if [ -n "${GBRAIN_STORE_PATH:-}" ]; then
      touch "$GBRAIN_STORE_PATH"
      if ! grep -Fxq "$slug" "$GBRAIN_STORE_PATH"; then
        printf '%s\n' "$slug" >> "$GBRAIN_STORE_PATH"
      fi
    fi
    if [ -z "$content" ]; then
      content="$(cat)"
    fi
    if [ -n "${GBRAIN_CONTENT_DIR:-}" ]; then
      mkdir -p "$GBRAIN_CONTENT_DIR"
      printf '%s\n' "$content" > "$GBRAIN_CONTENT_DIR/${slug//\//__}.md"
    fi
    exit 0
    ;;
  tag)
    if [ -n "${GBRAIN_LOG_PATH:-}" ]; then
      printf 'tag\t%s\t%s\n' "${2:-}" "${3:-}" >> "$GBRAIN_LOG_PATH"
    fi
    exit 0
    ;;
  *)
    exit 0
    ;;
esac
EOF
  chmod +x "$FAKE_BIN/gbrain"
  cat > "$FAKE_BIN/gitnexus" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

case "${1:-}" in
  --version)
    printf '1.6.3-test\n'
    ;;
  detect-changes)
    risk="${GITNEXUS_DETECT_RISK:-low}"
    printf 'Changes: 1 files, 1 symbols\n'
    printf 'Affected processes: 0\n'
    printf 'Risk level: %s\n' "$risk"
    printf '\nChanged symbols:\n'
    printf '  Function demo → demo.js\n'
    ;;
  impact)
    printf 'Risk level: low\n'
    printf 'Direct callers: 0\n'
    ;;
  analyze)
    repo_path="${2:-.}"
    mkdir -p "$repo_path/.gitnexus"
    head="$(git -C "$repo_path" rev-parse HEAD 2>/dev/null || printf 'unknown')"
    printf '{"lastCommit":"%s","indexedAt":"2026-05-10T00:00:00Z","stats":{"files":1,"nodes":1,"edges":0}}\n' "$head" > "$repo_path/.gitnexus/meta.json"
    printf 'Indexed %s\n' "$repo_path"
    ;;
  *)
    exit 0
    ;;
esac
EOF
  chmod +x "$FAKE_BIN/gitnexus"
}

run_init() {
  local target="$1"
  GSTACK_HARNESS_REGISTRY="$TMP_ROOT/projects.jsonl" PATH="$FAKE_BIN:$PATH" "$INIT" --target "$target" --mode docs-only --no-start-codex > "$target/init.out" 2> "$target/init.err"
  if [ -s "$target/init.err" ]; then
    sed -n '1,120p' "$target/init.err" >&2
    fail "init wrote to stderr for $target"
  fi
}

test_fresh_install() {
  mkdir -p "$INSTALL_DIR"
  run_init "$INSTALL_DIR"

  local required_files=(
    "HARNESS_PRODUCT_USAGE.md"
    "GSTACK_SKILL_REGISTRY.md"
    "WORKFLOW_RECIPES.md"
    "ORCHESTRATOR_RUNBOOK.md"
    "SYSTEM_TUNING_LOOP.md"
    "MEMORY_ARCHITECTURE.md"
    "GBRAIN_SCHEMA.md"
    "CLAUDE.md"
    "PROJECT_STATE.md"
    ".gstack/project-state.json"
    ".gstack/harness/agents/TEAM.md"
    ".gstack/harness/agents/problem-handling.md"
    ".gstack/harness/bin/pggg"
    ".gstack/harness/bin/pggg.ps1"
    ".gstack/harness/bin/pggg.cmd"
    ".gstack/harness/bin/pcm-harness"
    ".gstack/harness/bin/pcm-harness.ps1"
    ".gstack/harness/bin/pcm-harness.cmd"
    ".gstack/harness/bin/gstack-harness-record-run"
    ".gstack/harness/bin/gstack-harness-usage-report"
    ".gstack/harness/bin/gstack-harness-enable-report-timer"
    ".gstack/harness/bin/gstack-harness-remediate"
    ".gstack/harness/bin/gstack-harness-readiness"
    ".gstack/harness/bin/gstack-harness-agent-status"
    ".gstack/harness/bin/gstack-harness-schedule"
    ".gstack/harness/bin/gstack-harness-workspace-hygiene"
    ".gstack/harness/bin/gstack-harness-atomic-commit"
    ".ai-context/project.json"
    ".ai-context/FIELD_CONTRACT.md"
    ".ai-context/gitnexus-status.json"
    ".gitnexusignore"
    "scripts/ai-context-bridge.mjs"
    "scripts/gstack-scheduler.mjs"
    "docs/SCHEDULER_MODEL.md"
    ".gstack/usage-runs/README.md"
    ".gstack/usage-runs/index.jsonl"
    "docs/AGENT_ORCHESTRATOR.md"
    "docs/AGENT_WORKFLOWS.md"
    "docs/FOUNDATION_READINESS_REPORT.md"
    "docs/FOUNDATION_REMEDIATION_REPORT.md"
    "docs/CODEX_START_PROMPT.md"
    "docs/CODE_CONTEXT_REPORT.md"
    "docs/CODEBASE_MAP_REPORT.md"
    "docs/PROBLEM_HANDLING_REPORT.md"
    "docs/SYSTEM_TUNING_REPORT.md"
    "docs/AGENTS_STATUS.md"
    "docs/agents/orchestrator.json"
    "docs/agents/foundation-readiness.json"
    "docs/agents/memory-gbrain.json"
    "docs/agents/release.json"
  )

  local rel
  for rel in "${required_files[@]}"; do
    assert_file "$INSTALL_DIR/$rel"
  done
  [ ! -e "$INSTALL_DIR/docs/SOURCE_REHEARSAL_METHOD.md" ] || fail "source-only rehearsal method leaked into install target"
  if grep -R "huanzhuang" "$INSTALL_DIR" >/dev/null 2>&1; then
    fail "source-only rehearsal target leaked into install target"
  fi

  assert_contains "$INSTALL_DIR/CLAUDE.md" "<!-- GSTACK_HARNESS_START -->"
  assert_contains "$INSTALL_DIR/CLAUDE.md" "<!-- GSTACK_HARNESS_END -->"
  assert_contains "$INSTALL_DIR/.gstack/harness/agents/TEAM.md" "Problem Handling Agent"
  assert_contains "$INSTALL_DIR/.gstack/harness/agents/TEAM.md" "Code Context Agent"
  assert_contains "$INSTALL_DIR/.gstack/harness/agents/problem-handling.md" "gbrain_query_timeout"
  assert_contains "$INSTALL_DIR/docs/CODEX_START_PROMPT.md" ".gstack/harness/agents/TEAM.md"
  assert_contains "$INSTALL_DIR/docs/CODEX_START_PROMPT.md" ".gstack/harness/bin/gstack-harness-readiness"
  assert_contains "$INSTALL_DIR/docs/CODEX_START_PROMPT.md" ".gstack/harness/bin/gstack-harness-remediate"
  assert_contains "$INSTALL_DIR/docs/CODEX_START_PROMPT.md" "Problem Handling Agent"
  assert_contains "$INSTALL_DIR/docs/CODEX_START_PROMPT.md" "docs/CODE_CONTEXT_REPORT.md"
  assert_contains "$INSTALL_DIR/docs/CODEX_START_PROMPT.md" "轻量接管原则"
  assert_contains "$INSTALL_DIR/docs/CODEX_START_PROMPT.md" "接管只恢复导航状态"
  assert_contains "$INSTALL_DIR/docs/CODE_CONTEXT_REPORT.md" "gbrain_write_candidates"
  assert_contains "$INSTALL_DIR/.ai-context/FIELD_CONTRACT.md" "sync-gbrain --dry-run"
  assert_contains "$INSTALL_DIR/docs/CODE_CONTEXT_REPORT.md" "project/"
  assert_contains "$INSTALL_DIR/docs/CODE_CONTEXT_REPORT.md" "GitNexus"
  assert_contains "$INSTALL_DIR/docs/CODEBASE_MAP_REPORT.md" "compatibility pointer"
  assert_contains "$INSTALL_DIR/docs/SCHEDULER_MODEL.md" "gstack-harness-schedule"
  (cd "$INSTALL_DIR" && .gstack/harness/bin/gstack-harness-schedule init --target . > "$TMP_ROOT/scheduler-init.out")
  assert_json_field "$TMP_ROOT/scheduler-init.out" "state.swarm.strategy === 'evidence-gated'" "scheduler init did not create evidence-gated swarm"
  (cd "$INSTALL_DIR" && .gstack/harness/bin/gstack-harness-schedule register-agent --target . --agent-id build --role "Build Agent" --domain integration --capabilities coding,implementation > "$TMP_ROOT/scheduler-agent.out")
  assert_json_field "$TMP_ROOT/scheduler-agent.out" "state.agentId === 'build' && state.domain === 'integration'" "scheduler agent registration failed"
  (cd "$INSTALL_DIR" && .gstack/harness/bin/gstack-harness-schedule schedule --target . --task-id test-build --type coding --priority high --description "Implement scheduler self-test with verification evidence" > "$TMP_ROOT/scheduler-task.out")
  assert_json_field "$TMP_ROOT/scheduler-task.out" "state.status === 'assigned' && state.primaryAgent.agentId === 'build'" "scheduler task assignment failed"
  assert_contains "$INSTALL_DIR/init.out" '"code_context_agent": "code-context"'
  assert_contains "$INSTALL_DIR/init.out" '"code_context_report": "docs/CODE_CONTEXT_REPORT.md"'
  assert_contains "$INSTALL_DIR/init.out" '"codebase_map_report": "docs/CODEBASE_MAP_REPORT.md"'
  assert_contains "$INSTALL_DIR/init.out" '"code_context"'
  assert_contains "$INSTALL_DIR/init.out" '"provider": "gitnexus"'
  assert_contains "$INSTALL_DIR/init.out" '"config": ".ai-context/project.json"'
  assert_contains "$INSTALL_DIR/.gstack/usage-runs/index.jsonl" "harness_init"
  (cd "$INSTALL_DIR" && PATH="$FAKE_BIN:$PATH" .gstack/harness/bin/pggg --dry-run --no-start-codex > "$TMP_ROOT/pggg-local.out")
  assert_contains "$TMP_ROOT/pggg-local.out" "DRY_RUN"
  (cd "$INSTALL_DIR" && PATH="$FAKE_BIN:$PATH" .gstack/harness/bin/pcm-harness --dry-run --no-start-codex > "$TMP_ROOT/pcm-local.out")
  assert_contains "$TMP_ROOT/pcm-local.out" "DRY_RUN"

  node -e "JSON.parse(require('fs').readFileSync(process.argv[1], 'utf8'))" "$INSTALL_DIR/.gstack/project-state.json"
  assert_json_field "$INSTALL_DIR/.gstack/project-state.json" "state.agents.required_core.includes('problem-handling')" "missing problem-handling required core agent"
  assert_json_field "$INSTALL_DIR/.gstack/project-state.json" "state.agents.project_defined.includes('code-context')" "missing code-context project-defined agent"
  assert_json_field "$INSTALL_DIR/.gstack/project-state.json" "state.artifacts.problem_handling_report === 'docs/PROBLEM_HANDLING_REPORT.md'" "missing problem handling artifact link"
  assert_json_field "$INSTALL_DIR/.gstack/project-state.json" "state.artifacts.foundation_remediation_report === 'docs/FOUNDATION_REMEDIATION_REPORT.md'" "missing foundation remediation artifact link"
  assert_json_field "$INSTALL_DIR/.gstack/project-state.json" "state.artifacts.code_context_report === 'docs/CODE_CONTEXT_REPORT.md'" "missing code context report artifact link"
  assert_json_field "$INSTALL_DIR/.gstack/project-state.json" "state.artifacts.ai_context_project === '.ai-context/project.json'" "missing ai context project artifact link"
  assert_json_field "$INSTALL_DIR/.gstack/project-state.json" "state.quality_gates.code_context === 'missing'" "missing code context gate"
  assert_json_field "$INSTALL_DIR/.ai-context/project.json" "state.gitnexus.command.length === 1 && state.gitnexus.command[0] === 'gitnexus'" "GitNexus config is not local-first"
  assert_json_field "$INSTALL_DIR/.ai-context/project.json" "state.gitnexus.fallback_command.join(' ') === 'npx -y gitnexus@latest'" "GitNexus fallback command missing"
  assert_json_field "$INSTALL_DIR/.ai-context/project.json" "state.gitnexus.prefer_local === true" "GitNexus prefer_local missing"
  assert_json_field "$INSTALL_DIR/.ai-context/project.json" "state.gitnexus.no_stats === true" "GitNexus no_stats missing"
  assert_json_field "$INSTALL_DIR/.gstack/project-state.json" "state.artifacts.system_tuning_report === 'docs/SYSTEM_TUNING_REPORT.md'" "missing system tuning artifact link"
  assert_json_field "$INSTALL_DIR/.gstack/project-state.json" "state.artifacts.agents_status_report === 'docs/AGENTS_STATUS.md'" "missing agents status artifact link"
  assert_json_field "$INSTALL_DIR/.gstack/project-state.json" "state.release.status === 'blocked_by_environment' && state.quality_gates.deployment === 'blocked'" "project release state was not structured as blocked_by_environment"
  assert_json_field "$INSTALL_DIR/docs/agents/release.json" "state.status === 'blocked_by_environment' && state.blockers.includes('no_remote_repository') && state.blockers.includes('no_deploy_target')" "release agent did not record blocked_by_environment"
  assert_json_field "$INSTALL_DIR/.gstack/project-state.json" "state.artifacts.usage_runs === '.gstack/usage-runs'" "missing usage runs artifact link"
  assert_json_field "$INSTALL_DIR/.gstack/project-state.json" "state.artifacts.foundation_readiness_runner === '.gstack/harness/bin/gstack-harness-readiness'" "missing readiness runner artifact link"
  assert_json_field "$INSTALL_DIR/.gstack/project-state.json" "state.usage && state.usage.latest_event === 'harness_init'" "missing latest usage run state"
  assert_contains "$INSTALL_DIR/init.out" '"status": "ready"'

  local usage_count
  usage_count="$(find "$INSTALL_DIR/.gstack/usage-runs" -maxdepth 1 -name '*.json' | wc -l | tr -d ' ')"
  [ "$usage_count" -ge 1 ] || fail "expected at least one usage run JSON"

  (cd "$INSTALL_DIR" && node scripts/ai-context-bridge.mjs status > "$TMP_ROOT/code-context-status.out")
  assert_contains "$INSTALL_DIR/docs/CODE_CONTEXT_REPORT.md" "operation: status"
  assert_contains "$INSTALL_DIR/docs/CODE_CONTEXT_REPORT.md" "test_evidence: []"
  assert_no_trailing_whitespace "$INSTALL_DIR/docs/CODE_CONTEXT_REPORT.md"
  assert_json_field "$INSTALL_DIR/.gstack/project-state.json" "state.code_context && state.code_context.provider === 'gitnexus'" "bridge status did not update code context state"

  (cd "$INSTALL_DIR" && node scripts/ai-context-bridge.mjs sync-gbrain --dry-run --page overview --page gitnexus_index > "$TMP_ROOT/sync-gbrain-dry-run.out")
  assert_json_field "$TMP_ROOT/sync-gbrain-dry-run.out" "state.event === 'sync_gbrain'" "sync-gbrain dry run missing event"
  assert_json_field "$TMP_ROOT/sync-gbrain-dry-run.out" "state.status === 'planned' && state.dry_run === true" "sync-gbrain dry run did not report planned status"
  assert_json_field "$TMP_ROOT/sync-gbrain-dry-run.out" "state.pages_planned.length === 2 && state.pages_planned.some((p) => p.slug === 'project/install/overview') && state.pages_planned.some((p) => p.slug === 'project/install/gitnexus-index')" "sync-gbrain dry run did not honor repeated --page selection"

  (cd "$INSTALL_DIR" && GBRAIN_LOG_PATH="$TMP_ROOT/sync-gbrain.log" PATH="$FAKE_BIN:$PATH" node scripts/ai-context-bridge.mjs sync-gbrain --page overview --page code_context > "$TMP_ROOT/sync-gbrain.out")
  assert_json_field "$TMP_ROOT/sync-gbrain.out" "state.event === 'sync_gbrain' && state.status === 'synced'" "sync-gbrain did not emit synced JSON"
  assert_json_field "$TMP_ROOT/sync-gbrain.out" "state.pages_written.length === 2 && state.pages_written.some((p) => p.slug === 'project/install/code-context')" "sync-gbrain did not write selected pages"
  assert_contains "$TMP_ROOT/sync-gbrain.log" $'put\tproject/install/overview'
  assert_contains "$TMP_ROOT/sync-gbrain.log" $'put\tproject/install/code-context'

  (cd "$INSTALL_DIR" && GBRAIN_FAIL_PUT=1 PATH="$FAKE_BIN:$PATH" node scripts/ai-context-bridge.mjs sync-gbrain --page overview > "$TMP_ROOT/sync-gbrain-fallback.out" 2> "$TMP_ROOT/sync-gbrain-fallback.err")
  assert_json_field "$TMP_ROOT/sync-gbrain-fallback.out" "state.event === 'sync_gbrain' && state.status === 'fallback'" "sync-gbrain did not downgrade gbrain write failure to fallback status"
  assert_json_field "$TMP_ROOT/sync-gbrain-fallback.out" "state.warnings.includes('gbrain_project_memory_sync_failed')" "sync-gbrain fallback did not record warning"
  assert_json_field "$TMP_ROOT/sync-gbrain-fallback.out" "state.fallback_artifacts.some((p) => p.includes('.ai-context/gbrain-fallback/'))" "sync-gbrain fallback did not write local artifact"
  assert_file "$INSTALL_DIR/.ai-context/gbrain-fallback/project-install-overview.md"
  assert_contains "$INSTALL_DIR/.ai-context/gbrain-fallback/project-install-overview.md" "slug: \"project/install/overview\""

  local legacy_content_dir="$TMP_ROOT/legacy-gbrain-content"
  mkdir -p "$legacy_content_dir"
  cat > "$legacy_content_dir/project__install__overview.md" <<EOF
---
type: project
title: Overview
tags:
  - project:install
  - scope:project
---

# Project Overview: install

Harness project id: install. Target path: $INSTALL_DIR.
EOF
  (cd "$INSTALL_DIR" && GBRAIN_CONTENT_DIR="$legacy_content_dir" PATH="$FAKE_BIN:$PATH" node scripts/ai-context-bridge.mjs sync-gbrain --page overview > "$TMP_ROOT/sync-gbrain-legacy.out")
  assert_json_field "$TMP_ROOT/sync-gbrain-legacy.out" "state.event === 'sync_gbrain' && state.status === 'synced' && state.pages_written.some((p) => p.slug === 'project/install/overview')" "sync-gbrain rejected legacy overview path with trailing punctuation"

  cat > "$legacy_content_dir/project__install__overview.md" <<EOF
---
type: project
title: Overview
tags:
  - project:install
  - scope:project
---

# Project Overview: install

Harness project id: install. Target path: $INSTALL_DIR.
EOF
  (cd "$INSTALL_DIR" && GBRAIN_CONTENT_DIR="$legacy_content_dir" PATH="$FAKE_BIN:$PATH" node scripts/ai-context-bridge.mjs repair-gbrain --page overview > "$TMP_ROOT/repair-gbrain.out")
  assert_json_field "$TMP_ROOT/repair-gbrain.out" "state.event === 'repair_gbrain' && state.status === 'repaired' && state.pages_repaired.some((p) => p.slug === 'project/install/overview')" "repair-gbrain did not repair legacy project memory"
  assert_contains "$legacy_content_dir/project__install__overview.md" "project_uid:"
  assert_contains "$legacy_content_dir/project__install__overview.md" "repo_path:"

  PATH="$FAKE_BIN:$PATH" "$INSTALL_DIR/.gstack/harness/bin/gstack-harness-remediate" --target "$INSTALL_DIR" > "$TMP_ROOT/remediate.out"
  assert_contains "$TMP_ROOT/remediate.out" "Foundation remediation status:"
  assert_contains "$INSTALL_DIR/docs/FOUNDATION_REMEDIATION_REPORT.md" "foundation_remediation:"
  assert_json_field "$INSTALL_DIR/.gstack/project-state.json" "state.foundation && state.foundation.remediation" "remediation did not update foundation state"
  PATH="$FAKE_BIN:$PATH" "$INSTALL_DIR/.gstack/harness/bin/gstack-harness-readiness" --target "$INSTALL_DIR" > "$TMP_ROOT/readiness.out"
  assert_contains "$TMP_ROOT/readiness.out" '"status"'
  assert_json_field "$INSTALL_DIR/docs/agents/foundation-readiness.json" "state.event === 'foundation_readiness' && state.evidence.length > 0" "readiness did not refresh agent status artifacts"

  local seed_dir="$TMP_ROOT/seeded"
  local seed_store="$TMP_ROOT/seeded-gbrain-store.txt"
  local seed_content_dir="$TMP_ROOT/seeded-gbrain-content"
  mkdir -p "$seed_dir" "$seed_content_dir"
  GSTACK_HARNESS_REGISTRY="$TMP_ROOT/projects.jsonl" GBRAIN_STORE_PATH="$seed_store" GBRAIN_CONTENT_DIR="$seed_content_dir" PATH="$FAKE_BIN:$PATH" "$INIT" --target "$seed_dir" --project-id seeded --mode docs-only --no-start-codex > "$seed_dir/init.out"
  assert_contains "$seed_dir/init.out" '"status": "ready"'
  assert_contains "$seed_content_dir/project__seeded__overview.md" "project_uid:"
  assert_contains "$seed_content_dir/project__seeded__overview.md" "repo_path: \"$seed_dir\""
  assert_contains "$seed_content_dir/project__seeded__state.md" "Next recommended agent: Orchestrator"
  assert_contains "$seed_content_dir/project__seeded__handoff.md" "Next recipe: R0 Restore / Resume Context"
  GBRAIN_STORE_PATH="$seed_store" GBRAIN_CONTENT_DIR="$seed_content_dir" PATH="$FAKE_BIN:$PATH" "$seed_dir/.gstack/harness/bin/gstack-harness-remediate" --target "$seed_dir" > "$TMP_ROOT/seeded-remediate.out"
  assert_contains "$seed_content_dir/project__seeded__state.md" "project_uid:"
  assert_contains "$seed_content_dir/project__seeded__state.md" "repo_path: \"$seed_dir\""

  local slow_dir="$TMP_ROOT/slow-gbrain"
  local slow_bin="$TMP_ROOT/slow-bin"
  mkdir -p "$slow_dir" "$slow_bin"
  cp "$FAKE_BIN/gbrain" "$slow_bin/gbrain"
  cat > "$slow_bin/gbrain" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
case "${1:-}" in
  --version)
    printf 'gbrain-test 0.0.0\n'
    ;;
  list)
    exit 0
    ;;
  get|query|tag)
    exit 0
    ;;
  put)
    sleep 2
    exit 0
    ;;
  *)
    exit 0
    ;;
esac
EOF
  chmod +x "$slow_bin/gbrain"
  GSTACK_HARNESS_REGISTRY="$TMP_ROOT/projects.jsonl" PATH="$FAKE_BIN:$PATH" "$INIT" --target "$slow_dir" --project-id slow-gbrain --mode docs-only --no-start-codex > "$slow_dir/init.out"
  GSTACK_SYNC_GBRAIN_TIMEOUT=1s PATH="$slow_bin:$PATH" "$slow_dir/.gstack/harness/bin/gstack-harness-remediate" --target "$slow_dir" > "$TMP_ROOT/slow-remediate.out"
  assert_contains "$TMP_ROOT/slow-remediate.out" "Foundation remediation status:"
  assert_contains "$slow_dir/docs/FOUNDATION_REMEDIATION_REPORT.md" "gbrain_project_memory_sync_timeout"

  pass "fresh install writes protocol, agent team, pggg entrypoint, reports, managed block, usage run, and valid JSON"
}

test_readiness_invariants() {
  local indexed_dir="$TMP_ROOT/indexed"
  mkdir -p "$indexed_dir"
  printf '%s\n' '{"scripts":{"test":"echo ok","dev":"echo dev","lint":"echo lint","typecheck":"echo type"}}' > "$indexed_dir/package.json"
  git -C "$indexed_dir" init -q
  git -C "$indexed_dir" config user.email test@example.com
  git -C "$indexed_dir" config user.name Test
  printf '%s\n' "hello" > "$indexed_dir/README.md"
  git -C "$indexed_dir" add README.md package.json
  git -C "$indexed_dir" commit -q -m init
  local head
  head="$(git -C "$indexed_dir" rev-parse HEAD)"
  mkdir -p "$indexed_dir/.gitnexus"
  printf '{"lastCommit":"%s","indexedAt":"2026-05-03T00:00:00Z","stats":{"files":2,"nodes":1,"edges":0}}\n' "$head" > "$indexed_dir/.gitnexus/meta.json"

  GSTACK_HARNESS_REGISTRY="$TMP_ROOT/projects.jsonl" PATH="$FAKE_BIN:$PATH" "$INIT" --target "$indexed_dir" --project-id indexed --mode app --no-start-codex > "$indexed_dir/init.out"
  assert_json_field "$indexed_dir/.gstack/project-state.json" "state.quality_gates.code_context === 'ready'" "indexed GitNexus state did not become ready"
  assert_json_field "$indexed_dir/.gstack/project-state.json" "state.code_context && state.code_context.provider === 'gitnexus'" "indexed GitNexus state missing provider"
  assert_json_field "$indexed_dir/.gstack/project-state.json" "state.runtime.test === 'npm test'" "package test script was not detected without jq"
  assert_json_field "$indexed_dir/.gstack/project-state.json" "state.runtime.dev === 'npm run dev'" "package dev script was not detected without jq"
  assert_contains "$indexed_dir/docs/CODE_CONTEXT_REPORT.md" "Status: ready"
  printf '%s\n' "preexisting dirty" > "$indexed_dir/preexisting-dirty.txt"
  (cd "$indexed_dir" && PATH="$FAKE_BIN:$PATH" node scripts/ai-context-bridge.mjs baseline > "$TMP_ROOT/change-baseline.out")
  printf '%s\n' "session change" > "$indexed_dir/session-change.txt"
  (cd "$indexed_dir" && GITNEXUS_DETECT_RISK=high PATH="$FAKE_BIN:$PATH" node scripts/ai-context-bridge.mjs postchange --scope all --run-id test-postchange-raw-high > "$TMP_ROOT/postchange-raw-high.out")
  assert_json_field "$indexed_dir/.ai-context/runs/test-postchange-raw-high/run.json" "state.detect_risk === 'high' && state.harness_scope_risk === 'needs_review' && state.risk_source === 'session_baseline_delta_raw_high'" "postchange incorrectly downgraded raw high all-scope risk"
  (cd "$indexed_dir" && PATH="$FAKE_BIN:$PATH" node scripts/ai-context-bridge.mjs postchange --scope all --run-id test-postchange --test-command "npm test" --test-exit-code 0 --test-artifact "docs/test-output.log" > "$TMP_ROOT/postchange-test-evidence.out")
  assert_contains "$indexed_dir/.ai-context/runs/test-postchange/gbrain-note.md" "npm test"
  assert_contains "$indexed_dir/.ai-context/runs/test-postchange/gbrain-note.md" "docs/test-output.log"
  assert_json_field "$indexed_dir/.ai-context/runs/test-postchange/run.json" "state.tests && state.tests[0].command === 'npm test' && state.tests[0].exit_code === 0 && state.tests[0].artifact === 'docs/test-output.log'" "postchange did not preserve test evidence in run JSON"
  assert_json_field "$indexed_dir/.ai-context/runs/test-postchange/run.json" "state.harness_scope_risk === 'low' && state.risk_source === 'session_baseline_delta' && state.session_changed_files.includes('session-change.txt') && state.preexisting_dirty_files.includes('preexisting-dirty.txt')" "postchange did not preserve baseline session delta"
  assert_contains "$indexed_dir/docs/CODE_CONTEXT_REPORT.md" "test_evidence:"
  (cd "$indexed_dir" && PATH="$FAKE_BIN:$PATH" node scripts/ai-context-bridge.mjs postchange --scope all --run-id test-postchange-impact --impact demo --test-command "npm test" --test-exit-code 0 --test-artifact "docs/test-output.log" > "$TMP_ROOT/postchange-impact-risk.out")
  assert_contains "$indexed_dir/docs/CODE_CONTEXT_REPORT.md" "detect_risk: low"
  assert_contains "$indexed_dir/docs/CODE_CONTEXT_REPORT.md" 'impact_risks: [{"target":"demo","risk":"low"}]'
  assert_json_field "$indexed_dir/.ai-context/runs/test-postchange-impact/run.json" "state.detect_risk === 'low' && state.impact_risks && state.impact_risks[0].target === 'demo' && state.impact_risks[0].risk === 'low'" "postchange did not distinguish detect risk from target impact risk"
  (cd "$indexed_dir" && git add session-change.txt && PATH="$FAKE_BIN:$PATH" node scripts/ai-context-bridge.mjs postchange --scope staged --run-id test-staged-gate > "$TMP_ROOT/postchange-staged-gate.out")
  assert_json_field "$indexed_dir/.ai-context/runs/test-staged-gate/run.json" "state.commit_gate === 'pass' && state.risk_source === 'staged_detect_changes' && state.harness_scope_risk === 'low'" "staged postchange did not produce commit gate"
  (cd "$indexed_dir" && PATH="$FAKE_BIN:$PATH" node scripts/ai-context-bridge.mjs memory-check > "$TMP_ROOT/memory-check.out")
  assert_json_field "$TMP_ROOT/memory-check.out" "state.schema === 'gstack-harness.memory_check.v1' && ['ready','partial','blocked'].includes(state.verdict) && state.gitnexus && state.gbrain && state.local_artifacts" "memory-check did not produce memory health report"

  local empty_gbrain_dir="$TMP_ROOT/empty-gbrain"
  local empty_fake_bin="$TMP_ROOT/empty-fake-bin"
  mkdir -p "$empty_gbrain_dir" "$empty_fake_bin"
  cat > "$empty_fake_bin/gbrain" <<'EOF'
#!/usr/bin/env bash
case "${1:-}" in
  --version) printf 'gbrain-test 0.0.0\n' ;;
  list) exit 0 ;;
  query) printf 'query completed\n' ;;
  put|tag) exit 0 ;;
  *) exit 0 ;;
esac
EOF
  chmod +x "$empty_fake_bin/gbrain"
  GSTACK_HARNESS_REGISTRY="$TMP_ROOT/projects.jsonl" PATH="$empty_fake_bin:$PATH" "$INIT" --target "$empty_gbrain_dir" --project-id emptybrain --mode docs-only --no-start-codex > "$empty_gbrain_dir/init.out"
  assert_json_field "$empty_gbrain_dir/.gstack/project-state.json" "state.foundation.gbrain === 'empty'" "empty gbrain was not detected"
  assert_json_field "$empty_gbrain_dir/.gstack/project-state.json" "state.foundation.readiness === 'partial'" "empty gbrain did not downgrade readiness"

  local home_fallback_dir="$TMP_ROOT/home-fallback-gbrain"
  local home_fallback_home="$TMP_ROOT/home-fallback-home"
  local home_fallback_store="$TMP_ROOT/home-fallback-pages.txt"
  mkdir -p "$home_fallback_dir" "$home_fallback_home/.bun/bin" "$home_fallback_home/.codex/skills/gstack"
  printf '# test gstack skill\n' > "$home_fallback_home/.codex/skills/gstack/SKILL.md"
  cp "$FAKE_BIN/gbrain" "$home_fallback_home/.bun/bin/gbrain-real"
  cat > "$home_fallback_home/.bun/bin/bun" <<'EOF'
#!/usr/bin/env bash
case "${1:-}" in
  */cli.ts) shift ;;
esac
exec "$(dirname "$0")/gbrain-real" "$@"
EOF
  cat > "$home_fallback_home/.bun/bin/gbrain" <<'EOF'
#!/usr/bin/env bash
BUN_BIN="${BUN_BIN:-}"
if [ -z "$BUN_BIN" ]; then
  if [ -x "$HOME/.bun/bin/bun" ]; then
    BUN_BIN="$HOME/.bun/bin/bun"
  elif command -v bun >/dev/null 2>&1; then
    BUN_BIN="$(command -v bun)"
  elif [ -x /usr/local/bin/bun ]; then
    BUN_BIN="/usr/local/bin/bun"
  else
    echo "gbrain: bun not found. Install bun or set BUN_BIN." >&2
    exit 127
  fi
fi

exec "$BUN_BIN" "$HOME/gbrain/src/cli.ts" "$@"
EOF
  chmod +x "$home_fallback_home/.bun/bin/bun" "$home_fallback_home/.bun/bin/gbrain" "$home_fallback_home/.bun/bin/gbrain-real"
  HOME="$home_fallback_home" PATH="/usr/bin:/bin" "$home_fallback_home/.bun/bin/gbrain" --version > "$TMP_ROOT/home-fallback-wrapper-version.out"
  assert_contains "$TMP_ROOT/home-fallback-wrapper-version.out" "gbrain-test 0.0.0"
  GBRAIN_STORE_PATH="$home_fallback_store" "$home_fallback_home/.bun/bin/gbrain-real" put "project/homefallback/overview" --content "# overview"
  GBRAIN_STORE_PATH="$home_fallback_store" "$home_fallback_home/.bun/bin/gbrain-real" put "project/homefallback/state" --content "# state"
  GBRAIN_STORE_PATH="$home_fallback_store" "$home_fallback_home/.bun/bin/gbrain-real" put "project/homefallback/foundation-readiness" --content "# readiness"
  GBRAIN_STORE_PATH="$home_fallback_store" "$home_fallback_home/.bun/bin/gbrain-real" put "project/homefallback/code-context" --content "# code context"
  GBRAIN_STORE_PATH="$home_fallback_store" "$home_fallback_home/.bun/bin/gbrain-real" put "project/homefallback/quality-gates" --content "# gates"
  GBRAIN_STORE_PATH="$home_fallback_store" "$home_fallback_home/.bun/bin/gbrain-real" put "project/homefallback/gitnexus-index" --content "type: gitnexus_index"
  GBRAIN_STORE_PATH="$home_fallback_store" "$home_fallback_home/.bun/bin/gbrain-real" put "project/homefallback/architecture" --content "# architecture"
  GBRAIN_STORE_PATH="$home_fallback_store" "$home_fallback_home/.bun/bin/gbrain-real" put "project/homefallback/hotspots" --content "# hotspots"
  GBRAIN_STORE_PATH="$home_fallback_store" "$home_fallback_home/.bun/bin/gbrain-real" put "project/homefallback/handoff" --content "# handoff"
  GSTACK_HARNESS_REGISTRY="$TMP_ROOT/projects.jsonl" GBRAIN_STORE_PATH="$home_fallback_store" HOME="$home_fallback_home" PATH="/usr/bin:/bin" "$INIT" --target "$home_fallback_dir" --project-id homefallback --mode docs-only --no-start-codex > "$home_fallback_dir/init.out"
  assert_json_field "$home_fallback_dir/.gstack/project-state.json" "state.foundation.gbrain === 'ready'" "readiness did not discover gbrain from HOME/.bun/bin when PATH omitted it"
  assert_json_field "$home_fallback_dir/.gstack/project-state.json" "!state.blockers.includes('gbrain_unavailable')" "HOME/.bun/bin gbrain fallback still reported gbrain_unavailable"
  (cd "$home_fallback_dir" && GBRAIN_STORE_PATH="$home_fallback_store" HOME="$home_fallback_home" PATH="/usr/bin:/bin" node scripts/ai-context-bridge.mjs sync-gbrain --page overview > "$TMP_ROOT/home-fallback-sync.out")
  assert_json_field "$TMP_ROOT/home-fallback-sync.out" "state.event === 'sync_gbrain' && state.status === 'synced'" "bridge sync-gbrain did not use HOME/.bun/bin gbrain fallback"
  assert_json_field "$TMP_ROOT/home-fallback-sync.out" "!state.warnings.includes('gbrain_unavailable')" "bridge sync-gbrain fallback still reported gbrain_unavailable"

  local repaired_gbrain_dir="$TMP_ROOT/repaired-gbrain"
  local repaired_fake_bin="$TMP_ROOT/repaired-fake-bin"
  local repaired_store="$TMP_ROOT/repaired-gbrain-pages.txt"
  mkdir -p "$repaired_gbrain_dir" "$repaired_fake_bin"
  cat > "$repaired_fake_bin/gbrain" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
case "${1:-}" in
  --version)
    printf 'gbrain-test 0.0.0\n'
    ;;
  list)
    [ -f "${GBRAIN_STORE_PATH:?}" ] && cat "$GBRAIN_STORE_PATH" || true
    ;;
  query)
    printf 'query completed\n'
    ;;
  put)
    slug="${2:-}"
    [ -n "$slug" ] || exit 2
    touch "$GBRAIN_STORE_PATH"
    if ! grep -Fxq "$slug" "$GBRAIN_STORE_PATH"; then
      printf '%s\n' "$slug" >> "$GBRAIN_STORE_PATH"
    fi
    cat >/dev/null
    ;;
  tag)
    exit 0
    ;;
  *)
    exit 0
    ;;
esac
EOF
  chmod +x "$repaired_fake_bin/gbrain"
  GSTACK_HARNESS_REGISTRY="$TMP_ROOT/projects.jsonl" GBRAIN_STORE_PATH="$repaired_store" PATH="$repaired_fake_bin:$PATH" "$INIT" --target "$repaired_gbrain_dir" --project-id repaired --mode docs-only --no-start-codex > "$repaired_gbrain_dir/init.out"
  assert_json_field "$repaired_gbrain_dir/.gstack/project-state.json" "state.foundation.gbrain === 'ready'" "remediated gbrain was not detected as ready"
  assert_json_field "$repaired_gbrain_dir/.gstack/project-state.json" "state.foundation.readiness === 'ready'" "remediated gbrain did not restore readiness"
  assert_json_field "$repaired_gbrain_dir/.gstack/project-state.json" "!state.warnings.includes('gbrain_empty')" "stale gbrain_empty warning survived readiness recheck"
  assert_json_field "$repaired_gbrain_dir/.gstack/project-state.json" "state.problem_handling_required === false" "ready foundation incorrectly required problem handling"

  pass "readiness invariants keep reports, JSON state, gbrain status, and runtime detection aligned"
}

test_usage_registry_failure_is_nonfatal() {
  local registry_dir="$TMP_ROOT/registry"
  mkdir -p "$registry_dir/.gstack" "$TMP_ROOT/not-a-directory"
  printf '%s\n' '{"project_id":"registry","artifacts":{}}' > "$registry_dir/.gstack/project-state.json"
  GSTACK_HARNESS_REGISTRY="$TMP_ROOT/not-a-directory" "$SCRIPT_DIR/gstack-harness-record-run" --target "$registry_dir" --event registry_failure --status completed --warning test_warning > "$TMP_ROOT/registry-record.out"
  assert_contains "$TMP_ROOT/registry-record.out" ".gstack/usage-runs/"
  assert_json_field "$registry_dir/.gstack/project-state.json" "state.warnings.includes('test_warning')" "record-run did not merge explicit warning into state"
  assert_json_field "$registry_dir/.gstack/project-state.json" "state.warnings.includes('usage_global_registry_write_failed')" "record-run did not downgrade registry failure to warning"

  pass "usage recorder keeps local run success when global registry append fails"
}

test_usage_recorder_records_agents_skills_and_tools() {
  local record_dir="$TMP_ROOT/record-tools"
  mkdir -p "$record_dir/.gstack"
  printf '%s\n' '{"project_id":"record-tools","artifacts":{}}' > "$record_dir/.gstack/project-state.json"

  GSTACK_HARNESS_REGISTRY="$TMP_ROOT/projects.jsonl" "$SCRIPT_DIR/gstack-harness-record-run" \
    --target "$record_dir" \
    --event agent_chain \
    --status blocked \
    --agent "Code Context Agent" \
    --agent "Review Agent" \
    --skill "gitnexus.detect_changes" \
    --skill "ai-context-bridge.postchange" \
    --tool "npm test" \
    --tool "gstack-harness-readiness" \
    > "$TMP_ROOT/record-tools.out"

  local run_file
  run_file="$record_dir/$(cat "$TMP_ROOT/record-tools.out")"
  assert_json_field "$run_file" "state.agents_used.includes('Code Context Agent') && state.agents_used.includes('Review Agent')" "record-run did not preserve repeatable agents"
  assert_json_field "$run_file" "state.skills_used.includes('gitnexus.detect_changes') && state.skills_used.includes('ai-context-bridge.postchange')" "record-run did not preserve repeatable skills"
  assert_json_field "$run_file" "state.tools_used.includes('npm test') && state.tools_used.includes('gstack-harness-readiness')" "record-run did not preserve repeatable tools"
  assert_json_field "$record_dir/.gstack/project-state.json" "state.usage && state.usage.latest_tools && state.usage.latest_tools.includes('npm test')" "record-run did not summarize latest tools into project state"

  pass "usage recorder records repeatable agents, skills, and tools"
}

test_reinit_preserves_runtime_state() {
  mkdir -p "$PRESERVE_DIR/.gstack" "$PRESERVE_DIR/docs"

  node <<'NODE' > "$PRESERVE_DIR/.gstack/project-state.json"
const state = {
  phase: "foundation",
  last_completed_agent: "Foundation Remediation Agent",
  runtime: {
    install: "npm install",
    dev: "",
    test: "npm test",
    lint: "",
    typecheck: "",
    local_url: "",
    production_url: ""
  },
  quality_gates: {
    foundation_readiness: "ready",
    code_context: "ready",
    health: "unknown",
    browser_qa: "not_run",
    review: "not_run",
    security: "not_run",
    performance: "not_run",
    deployment: "not_started"
  },
  warnings: ["gbrain_query_timeout"],
  problem_handling: {
    status: "completed",
    issue_id: "gbrain_query_timeout"
  },
  system_tuning: {
    active_issue: "harness-gbrain-timeout-state-template",
    capability_gaps: [
      { id: "harness-gbrain-timeout-state-template", status: "open" }
    ]
  },
  next_recommended_agent: "System Tuning Agent",
  next_recommended_recipe: "R14 System / Agent Capability Tuning"
};
process.stdout.write(JSON.stringify(state, null, 2) + "\n");
NODE

  printf '%s\n' "REAL PROBLEM REPORT" > "$PRESERVE_DIR/docs/PROBLEM_HANDLING_REPORT.md"
  printf '%s\n' "REAL TUNING REPORT" > "$PRESERVE_DIR/docs/SYSTEM_TUNING_REPORT.md"
  cat > "$PRESERVE_DIR/PROJECT_STATE.md" <<'EOF'
# Project State

## Current

- Phase: acceptance
- Goal: Full gstack-multiagent agent-chain acceptance on a real target project.
- Branch: master
- Last updated: 2026-05-03
- Last completed agent: Full Agent Acceptance Run
- Next recommended agent: Orchestrator
- Next recommended recipe: R0 Restore / Resume Context
- Workspace mode: target_project

## Foundation

- Readiness: ready
- Problem handling: completed (docs/PROBLEM_HANDLING_REPORT.md)

## Runtime

- Install command: npm install
- Dev command:
- Test command: npm test
- Lint command:
- Typecheck command:
- Local URL: http://127.0.0.1:8788
- Production URL:

## Quality Gates

- Foundation Readiness: ready
- Code Context: ready
- Health: passing
- Browser QA: passing
- Windows QA: skipped
- Review: passing
- Security: warning
- Performance: passing
- Deployment: blocked

## Gate Evidence

- Health:
  - Command: npm test
  - Exit code: 0
  - Artifact: docs/FULL_AGENT_ACCEPTANCE_REPORT.md
- Browser QA:
  - URL: http://127.0.0.1:8788
  - Artifact: docs/FULL_AGENT_ACCEPTANCE_REPORT.md
- Review:
  - Base: HEAD baseline abc123
  - Artifact: docs/FULL_AGENT_ACCEPTANCE_REPORT.md
- Security:
  - Artifact: docs/FULL_AGENT_ACCEPTANCE_REPORT.md
- Performance:
  - Artifact: docs/FULL_AGENT_ACCEPTANCE_REPORT.md

## Artifacts

- QA report: docs/FULL_AGENT_ACCEPTANCE_REPORT.md
- Review report: docs/FULL_AGENT_ACCEPTANCE_REPORT.md
- Security report: docs/FULL_AGENT_ACCEPTANCE_REPORT.md
- Performance report: docs/FULL_AGENT_ACCEPTANCE_REPORT.md
- Release status: docs/FULL_AGENT_ACCEPTANCE_REPORT.md
EOF

  run_init "$PRESERVE_DIR"

  assert_contains "$PRESERVE_DIR/docs/PROBLEM_HANDLING_REPORT.md" "REAL PROBLEM REPORT"
  assert_contains "$PRESERVE_DIR/docs/SYSTEM_TUNING_REPORT.md" "REAL TUNING REPORT"
  assert_contains "$PRESERVE_DIR/PROJECT_STATE.md" "- Phase: acceptance"
  assert_contains "$PRESERVE_DIR/PROJECT_STATE.md" "- Last completed agent: Full Agent Acceptance Run"
  assert_contains "$PRESERVE_DIR/PROJECT_STATE.md" "- Test command: npm test"
  assert_contains "$PRESERVE_DIR/PROJECT_STATE.md" "- Local URL: http://127.0.0.1:8788"
  assert_contains "$PRESERVE_DIR/PROJECT_STATE.md" "- Health: passing"
  assert_contains "$PRESERVE_DIR/PROJECT_STATE.md" "- Browser QA: passing"
  assert_contains "$PRESERVE_DIR/PROJECT_STATE.md" "- Review: passing"
  assert_contains "$PRESERVE_DIR/PROJECT_STATE.md" "- Security: warning"
  assert_contains "$PRESERVE_DIR/PROJECT_STATE.md" "- Performance: passing"
  assert_contains "$PRESERVE_DIR/PROJECT_STATE.md" "- Deployment: blocked"
  assert_contains "$PRESERVE_DIR/PROJECT_STATE.md" "- Next recommended recipe: R0 Restore / Resume Context"
  assert_contains "$PRESERVE_DIR/PROJECT_STATE.md" "- Problem handling: completed (docs/PROBLEM_HANDLING_REPORT.md)"

  node -e "JSON.parse(require('fs').readFileSync(process.argv[1], 'utf8'))" "$PRESERVE_DIR/.gstack/project-state.json"
  assert_json_field "$PRESERVE_DIR/.gstack/project-state.json" "state.phase === 'acceptance'" "re-init did not preserve phase"
  assert_json_field "$PRESERVE_DIR/.gstack/project-state.json" "state.last_completed_agent === 'Full Agent Acceptance Run'" "re-init did not preserve last completed agent"
  assert_json_field "$PRESERVE_DIR/.gstack/project-state.json" "state.runtime.test === 'npm test' && state.runtime.local_url === 'http://127.0.0.1:8788'" "re-init downgraded runtime evidence"
  assert_json_field "$PRESERVE_DIR/.gstack/project-state.json" "state.quality_gates.health === 'passing' && state.quality_gates.browser_qa === 'passing' && state.quality_gates.review === 'passing' && state.quality_gates.security === 'warning' && state.quality_gates.performance === 'passing' && state.quality_gates.deployment === 'blocked'" "re-init downgraded completed quality gates"
  assert_json_field "$PRESERVE_DIR/.gstack/project-state.json" "state.artifacts.qa_report === 'docs/FULL_AGENT_ACCEPTANCE_REPORT.md' && state.artifacts.release_status === 'docs/FULL_AGENT_ACCEPTANCE_REPORT.md'" "re-init dropped high-level evidence artifacts"
  assert_json_field "$PRESERVE_DIR/.gstack/project-state.json" "state.gate_evidence.health.artifact === 'docs/FULL_AGENT_ACCEPTANCE_REPORT.md' && state.gate_evidence.browser_qa.url === 'http://127.0.0.1:8788'" "re-init did not lift markdown gate evidence into JSON"
  assert_json_field "$PRESERVE_DIR/.gstack/project-state.json" "state.next_recommended_agent === 'Orchestrator'" "re-init did not clear recovered next agent"
  assert_json_field "$PRESERVE_DIR/.gstack/project-state.json" "state.next_recommended_recipe === 'R0 Restore / Resume Context'" "re-init did not clear recovered next recipe"
  assert_json_field "$PRESERVE_DIR/.gstack/project-state.json" "!state.warnings.includes('gbrain_query_timeout')" "re-init did not clear stale readiness warning"
  assert_json_field "$PRESERVE_DIR/.gstack/project-state.json" "state.problem_handling && state.problem_handling.issue_id === 'gbrain_query_timeout'" "re-init did not preserve problem handling state"
  assert_json_field "$PRESERVE_DIR/.gstack/project-state.json" "state.system_tuning && state.system_tuning.active_issue === 'harness-gbrain-timeout-state-template'" "re-init did not preserve system tuning state"
  assert_json_field "$PRESERVE_DIR/.gstack/project-state.json" "state.usage && state.usage.latest_event === 'harness_init'" "re-init did not record latest usage run"

  PATH="$FAKE_BIN:$PATH" "$PRESERVE_DIR/.gstack/harness/bin/gstack-harness-readiness" --target "$PRESERVE_DIR" > "$TMP_ROOT/preserve-readiness.out"
  PATH="$FAKE_BIN:$PATH" "$PRESERVE_DIR/.gstack/harness/bin/gstack-harness-remediate" --target "$PRESERVE_DIR" > "$TMP_ROOT/preserve-remediate.out"
  assert_json_field "$PRESERVE_DIR/.gstack/project-state.json" "state.last_completed_agent === 'Full Agent Acceptance Run'" "readiness/remediation rerun downgraded last completed agent"
  assert_json_field "$PRESERVE_DIR/.gstack/project-state.json" "state.quality_gates.review === 'passing' && state.quality_gates.security === 'warning' && state.quality_gates.performance === 'passing' && state.quality_gates.deployment === 'blocked'" "readiness/remediation rerun downgraded completed gates"
  assert_contains "$PRESERVE_DIR/PROJECT_STATE.md" "- Last completed agent: Full Agent Acceptance Run"
  assert_contains "$PRESERVE_DIR/PROJECT_STATE.md" "- Review: passing"
  assert_contains "$PRESERVE_DIR/PROJECT_STATE.md" "- Deployment: blocked"

  pass "re-init/readiness/remediation preserve reports, completed gates, and resolved issue history while clearing recovered routing state"
}

test_usage_report() {
  local report="$TMP_ROOT/usage-report.md"
  local summary="$TMP_ROOT/usage-summary.json"

  "$SCRIPT_DIR/gstack-harness-usage-report" --registry "$TMP_ROOT/projects.jsonl" --output "$report" --json-output "$summary" > "$TMP_ROOT/usage-report.out"
  GSTACK_HARNESS_REGISTRY="$TMP_ROOT/projects.jsonl" "$INSTALL_DIR/.gstack/harness/bin/gstack-harness-usage-report" --stdout > "$TMP_ROOT/usage-report-local.out"

  assert_file "$report"
  assert_file "$summary"
  assert_contains "$report" "Usage Feedback Report"
  assert_contains "$TMP_ROOT/usage-report-local.out" "Usage Feedback Report"
  assert_contains "$report" "Usage runs found"
  node -e "JSON.parse(require('fs').readFileSync(process.argv[1], 'utf8'))" "$summary"
  assert_json_field "$summary" "state.usage_runs_found >= 2" "usage report did not aggregate recorded runs"

  pass "usage report aggregates registered target-project run records"
}

test_report_timer_installer() {
  local unit_dir="$TMP_ROOT/systemd-user"
  local runner_dir="$TMP_ROOT/runner"
  local report="$TMP_ROOT/timer-report.md"

  "$SCRIPT_DIR/gstack-harness-enable-report-timer" \
    --unit-dir "$unit_dir" \
    --runner-dir "$runner_dir" \
    --registry "$TMP_ROOT/projects.jsonl" \
    --output "$report" \
    --no-enable > "$TMP_ROOT/timer.out"

  assert_file "$runner_dir/gstack-harness-usage-report.sh"
  assert_file "$unit_dir/gstack-harness-usage-report.service"
  assert_file "$unit_dir/gstack-harness-usage-report.timer"
  assert_contains "$runner_dir/gstack-harness-usage-report.sh" "gstack-harness-usage-report"
  assert_contains "$unit_dir/gstack-harness-usage-report.service" "Type=oneshot"
  assert_contains "$unit_dir/gstack-harness-usage-report.timer" "OnBootSec=5min"
  assert_contains "$unit_dir/gstack-harness-usage-report.timer" "OnUnitActiveSec=1h"
  assert_contains "$TMP_ROOT/timer.out" "Enabled GStack Harness usage report timer."

  local local_unit_dir="$TMP_ROOT/local-systemd-user"
  local local_runner_dir="$TMP_ROOT/local-runner"
  GSTACK_HARNESS_REGISTRY="$TMP_ROOT/projects.jsonl" "$INSTALL_DIR/.gstack/harness/bin/gstack-harness-enable-report-timer" \
    --unit-dir "$local_unit_dir" \
    --runner-dir "$local_runner_dir" \
    --output "$TMP_ROOT/local-timer-report.md" \
    --no-enable > "$TMP_ROOT/local-timer.out"

  assert_file "$local_runner_dir/gstack-harness-usage-report.sh"
  assert_contains "$local_runner_dir/gstack-harness-usage-report.sh" "$TEMPLATE_ROOT/bin/gstack-harness-usage-report"

  pass "report timer installer writes user systemd units without enabling real timers"
}

main() {
  log "GStack Harness self-test"
  require_node
  setup_fake_tools
  bash -n "$INIT"
  bash -n "$SCRIPT_DIR/pggg"
  bash -n "$SCRIPT_DIR/pcm-harness"
  bash -n "$SCRIPT_DIR/gstack-harness-record-run"
  bash -n "$SCRIPT_DIR/gstack-harness-usage-report"
  bash -n "$SCRIPT_DIR/gstack-harness-enable-report-timer"
  bash -n "$SCRIPT_DIR/gstack-harness-remediate"
  bash -n "$SCRIPT_DIR/gstack-harness-readiness"
  bash -n "$SCRIPT_DIR/gstack-harness-agent-status"
  bash -n "$SCRIPT_DIR/gstack-harness-schedule"
  bash -n "$SCRIPT_DIR/gstack-harness-workspace-hygiene"
  bash -n "$SCRIPT_DIR/gstack-harness-atomic-commit"
  node --check "$TEMPLATE_ROOT/scripts/ai-context-bridge.mjs" >/dev/null
  node --check "$TEMPLATE_ROOT/scripts/gstack-scheduler.mjs" >/dev/null
  pass "init script syntax"

  test_fresh_install
  test_readiness_invariants
  test_usage_registry_failure_is_nonfatal
  test_usage_recorder_records_agents_skills_and_tools
  test_reinit_preserves_runtime_state
  test_usage_report
  test_report_timer_installer

  log "OK all harness self-tests passed"
}

main "$@"
