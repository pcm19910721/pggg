#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
gstack-harness-init - run the standard GStack Harness onboarding flow

Usage:
  cd /path/to/target-project
  gstack-harness-init

Flow:
  1. Detect the current project and foundation readiness.
  2. Upgrade harness protocol files with centralized .gstack/backups snapshots.
  3. Merge the CLAUDE.md managed block.
  4. Render PROJECT_STATE.md, .gstack/project-state.json, readiness report, and Codex start prompt.
  5. Record a structured usage run for feedback aggregation.
  6. Open Codex in the target project with the first Orchestrator prompt.
EOF
}

TARGET="."
PROJECT_ID=""
MODE="auto"
FORCE=0
DRY_RUN=0
UPGRADE=1
START_CODEX=1

while [ "$#" -gt 0 ]; do
  case "$1" in
    --target)
      TARGET="${2:-}"
      shift 2
      ;;
    --project-id)
      PROJECT_ID="${2:-}"
      shift 2
      ;;
    --mode)
      MODE="${2:-}"
      shift 2
      ;;
    --force)
      FORCE=1
      shift
      ;;
    --no-upgrade)
      UPGRADE=0
      shift
      ;;
    --dry-run)
      DRY_RUN=1
      shift
      ;;
    --start-codex)
      START_CODEX=1
      shift
      ;;
    --no-start-codex)
      START_CODEX=0
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "ERROR: unknown argument: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

case "$MODE" in
  auto|app|docs-only) ;;
  *)
    echo "ERROR: --mode must be auto, app, or docs-only" >&2
    exit 2
    ;;
esac

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TEMPLATE_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
TARGET_DIR="$(mkdir -p "$TARGET" && cd "$TARGET" && pwd)"

if [ -z "$PROJECT_ID" ]; then
  PROJECT_ID="$(basename "$TARGET_DIR" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9._-' '-')"
  PROJECT_ID="${PROJECT_ID%-}"
  PROJECT_ID="${PROJECT_ID:-project}"
fi

DATE="$(date +%Y-%m-%d)"
STAMP="$(date +%Y%m%d-%H%M%S)"
GENERATED_AT="$(date -Iseconds)"
INSTALL_LOG="$TARGET_DIR/.gstack/install-log.txt"
mkdir -p "$TARGET_DIR/.gstack"
: > "$INSTALL_LOG"

log() {
  if [ "${GSTACK_HARNESS_VERBOSE:-0}" = "1" ]; then
    printf '%s\n' "$*"
  fi
  printf '%s\n' "$*" >> "$INSTALL_LOG"
}

say() {
  printf '%s\n' "$*"
}

json_escape() {
  printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

json_array() {
  local first=1
  local item
  printf '['
  for item in "$@"; do
    if [ "$first" -ne 1 ]; then
      printf ', '
    fi
    printf '"%s"' "$(json_escape "$item")"
    first=0
  done
  printf ']'
}

array_contains() {
  local needle="$1"
  local item
  shift
  for item in "$@"; do
    [ "$item" = "$needle" ] && return 0
  done
  return 1
}

is_readiness_warning() {
  case "$1" in
    gbrain_empty|gbrain_core_pages_missing|gbrain_project_memory_missing|gbrain_project_memory_stale|gbrain_project_memory_sync_failed|gbrain_project_memory_sync_timeout|gbrain_query_timeout|gbrain_query_failed|gbrain_sync_off|runtime_missing|not_git_repo|browse_missing|code_context_status_failed|gbrain_seed_failed|gbrain_seed_timeout|github_cli_missing|github_cli_unauthenticated)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

is_completed_gate() {
  case "$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')" in
    accepted|complete|completed|done|passed|passing|ready|released|shipped)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

detect_gstack_root() {
  for root in \
    "$HOME/.claude/skills/gstack" \
    "$HOME/.codex-gstack/skills/gstack" \
    "$HOME/.codex/skills/gstack" \
    "$HOME/.claude/skills/gstack/.agents/skills/gstack"
  do
    if [ -d "$root" ] && [ -f "$root/SKILL.md" ]; then
      printf '%s\n' "$root"
      return 0
    fi
  done
  return 1
}

detect_gbrain_bin() {
  if command -v gbrain >/dev/null 2>&1; then
    command -v gbrain
    return 0
  fi
  if [ -x "$HOME/.bun/bin/gbrain" ]; then
    printf '%s\n' "$HOME/.bun/bin/gbrain"
    return 0
  fi
  return 1
}

detect_bun_bin() {
  if command -v bun >/dev/null 2>&1; then
    command -v bun
    return 0
  fi
  for candidate in \
    "${BUN_INSTALL:-}/bin/bun" \
    "$HOME/.bun/bin/bun" \
    "/usr/local/bin/bun" \
    "/opt/homebrew/bin/bun" \
    "/usr/bin/bun"
  do
    if [ -n "$candidate" ] && [ -x "$candidate" ]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  return 1
}

detect_github_cli() {
  if command -v gh >/dev/null 2>&1; then
    command -v gh
    return 0
  fi
  return 1
}

activate_gbrain_path() {
  local gbrain_bin="$1"
  local bun_bin=""
  PATH="$(dirname "$gbrain_bin"):$PATH"
  if bun_bin="$(detect_bun_bin 2>/dev/null)"; then
    PATH="$(dirname "$bun_bin"):$PATH"
  fi
}

has_file() {
  [ -f "$1" ] || [ -d "$1" ]
}

backup_existing() {
  local path="$1"
  if [ -e "$path" ] && [ "$DRY_RUN" -ne 1 ]; then
    local rel="${path#$TARGET_DIR/}"
    local backup="$TARGET_DIR/.gstack/backups/$STAMP/$rel"
    mkdir -p "$(dirname "$backup")"
    cp -a "$path" "$backup"
    log "backup $rel -> .gstack/backups/$STAMP/$rel"
  fi
}

ensure_gitignore_entry() {
  local pattern="$1"
  local gitignore="$TARGET_DIR/.gitignore"
  if [ "$GIT_STATUS" != "ready" ] && [ ! -f "$gitignore" ]; then
    return 0
  fi
  if [ "$DRY_RUN" -eq 1 ]; then
    log "DRY_RUN ensure .gitignore contains $pattern"
    return 0
  fi
  mkdir -p "$(dirname "$gitignore")"
  touch "$gitignore"
  if ! grep -Fxq "$pattern" "$gitignore" 2>/dev/null; then
    printf '%s\n' "$pattern" >> "$gitignore"
    log "updated .gitignore with $pattern"
  fi
}

write_file() {
  local rel="$1"
  local content="$2"
  local dest="$TARGET_DIR/$rel"
  local final="$dest"

  if [ -e "$dest" ] && [ "$FORCE" -ne 1 ] && [ "$UPGRADE" -ne 1 ]; then
    final="$dest.new"
  fi

  if [ "$DRY_RUN" -eq 1 ]; then
    if [ -e "$dest" ] && [ "$final" = "$dest" ]; then
      log "DRY_RUN upgrade ${final#$TARGET_DIR/} (backup would be created)"
    else
      log "DRY_RUN write ${final#$TARGET_DIR/}"
    fi
    return 0
  fi

  mkdir -p "$(dirname "$final")"
  if [ -e "$final" ] && [ "$final" = "$dest" ]; then
    backup_existing "$final"
  fi
  printf '%s\n' "$content" > "$final"
  log "wrote ${final#$TARGET_DIR/}"
}

write_file_if_missing() {
  local rel="$1"
  local content="$2"
  local dest="$TARGET_DIR/$rel"

  if [ -e "$dest" ]; then
    log "preserve ${dest#$TARGET_DIR/}"
    return 0
  fi

  if [ "$DRY_RUN" -eq 1 ]; then
    log "DRY_RUN write ${dest#$TARGET_DIR/}"
    return 0
  fi

  mkdir -p "$(dirname "$dest")"
  printf '%s\n' "$content" > "$dest"
  log "wrote ${dest#$TARGET_DIR/}"
}

copy_file() {
  local src_rel="$1"
  local dest_rel="$2"
  local src="$TEMPLATE_ROOT/$src_rel"
  local dest="$TARGET_DIR/$dest_rel"
  local final="$dest"

  if [ ! -f "$src" ]; then
    log "warning: template missing $src_rel"
    return 0
  fi

  if [ "$(realpath -m "$src")" = "$(realpath -m "$dest")" ]; then
    log "skip $dest_rel (source and target are the same file)"
    return 0
  fi

  if [ -e "$dest" ] && [ "$FORCE" -ne 1 ] && [ "$UPGRADE" -ne 1 ]; then
    final="$dest.new"
  fi

  if [ "$DRY_RUN" -eq 1 ]; then
    if [ -e "$dest" ] && [ "$final" = "$dest" ]; then
      log "DRY_RUN upgrade $dest_rel from $src_rel (backup would be created)"
    else
      log "DRY_RUN copy $src_rel -> ${final#$TARGET_DIR/}"
    fi
    return 0
  fi

  mkdir -p "$(dirname "$final")"
  if [ -e "$final" ] && [ "$final" = "$dest" ]; then
    backup_existing "$final"
  fi
  cp "$src" "$final"
  log "copied $src_rel -> ${final#$TARGET_DIR/}"
}

write_managed_block() {
  local rel="$1"
  local content="$2"
  local dest="$TARGET_DIR/$rel"
  local block
  block="$(cat <<EOF
<!-- GSTACK_HARNESS_START -->
$content
<!-- GSTACK_HARNESS_END -->
EOF
)"

  if [ -e "$dest" ] && [ "$FORCE" -ne 1 ] && [ "$UPGRADE" -ne 1 ]; then
    write_file "$rel" "$block"
    return 0
  fi

  if [ "$DRY_RUN" -eq 1 ]; then
    if [ -e "$dest" ]; then
      if grep -q '<!-- GSTACK_HARNESS_START -->' "$dest" 2>/dev/null; then
        log "DRY_RUN replace managed block in $rel"
      else
        log "DRY_RUN append managed block to $rel"
      fi
    else
      log "DRY_RUN write managed $rel"
    fi
    return 0
  fi

  mkdir -p "$(dirname "$dest")"
  if [ ! -e "$dest" ]; then
    printf '%s\n' "$block" > "$dest"
    log "wrote managed $rel"
    return 0
  fi

  backup_existing "$dest"
  if grep -q '<!-- GSTACK_HARNESS_START -->' "$dest" 2>/dev/null; then
    awk -v block="$block" '
      BEGIN { in_block=0; printed=0 }
      /<!-- GSTACK_HARNESS_START -->/ {
        if (!printed) {
          print block
          printed=1
        }
        in_block=1
        next
      }
      /<!-- GSTACK_HARNESS_END -->/ {
        in_block=0
        next
      }
      !in_block { print }
      END {
        if (!printed) print block
      }
    ' "$dest" > "$dest.tmp-$STAMP"
    mv "$dest.tmp-$STAMP" "$dest"
    log "updated managed block in $rel"
  else
    {
      printf '%s\n\n' "$(cat "$dest")"
      printf '%s\n' "$block"
    } > "$dest.tmp-$STAMP"
    mv "$dest.tmp-$STAMP" "$dest"
    log "appended managed block to $rel"
  fi
}

has_runtime_manifest() {
  local dir
  for dir in "$TARGET_DIR" "$TARGET_DIR/backend" "$TARGET_DIR/frontend" "$TARGET_DIR/app" "$TARGET_DIR/api" "$TARGET_DIR/server" "$TARGET_DIR/web"; do
    [ -d "$dir" ] || continue
    if [ -f "$dir/package.json" ] || [ -f "$dir/pyproject.toml" ] || [ -f "$dir/go.mod" ] || [ -f "$dir/Cargo.toml" ] || [ -f "$dir/Makefile" ]; then
      return 0
    fi
    if [ -f "$dir/web_app.py" ] || [ -f "$dir/app.py" ] || [ -f "$dir/main.py" ] || [ -f "$dir/run_web.ps1" ] || [ -f "$dir/run_web.bat" ]; then
      return 0
    fi
  done
  return 1
}

detect_runtime() {
  local mode="$1"
  local runtime_dir="$TARGET_DIR"
  local runtime_rel=""
  local prefix=""
  local candidate_rel
  INSTALL_COMMAND=""
  DEV_COMMAND=""
  TEST_COMMAND=""
  LINT_COMMAND=""
  TYPECHECK_COMMAND=""
  LOCAL_URL=""
  PRODUCTION_URL=""
  RUNTIME_STATUS="missing_commands"

  if [ "$mode" = "docs-only" ]; then
    INSTALL_COMMAND="not_required"
    DEV_COMMAND="not_required"
    TEST_COMMAND="not_required"
    LINT_COMMAND="not_required"
    TYPECHECK_COMMAND="not_required"
    LOCAL_URL="not_required"
    PRODUCTION_URL="not_required"
    RUNTIME_STATUS="not_required"
    return
  fi

  for candidate_rel in "" "backend" "frontend" "app" "api" "server" "web"; do
    runtime_dir="$TARGET_DIR"
    [ -n "$candidate_rel" ] && runtime_dir="$TARGET_DIR/$candidate_rel"
    [ -d "$runtime_dir" ] || continue
    if [ -f "$runtime_dir/package.json" ] || [ -f "$runtime_dir/pyproject.toml" ] || [ -f "$runtime_dir/go.mod" ] || [ -f "$runtime_dir/Cargo.toml" ] || [ -f "$runtime_dir/Makefile" ] || [ -f "$runtime_dir/web_app.py" ] || [ -f "$runtime_dir/app.py" ] || [ -f "$runtime_dir/main.py" ] || [ -f "$runtime_dir/run_web.ps1" ] || [ -f "$runtime_dir/run_web.bat" ]; then
      runtime_rel="$candidate_rel"
      break
    fi
  done
  [ -n "$runtime_rel" ] && prefix="cd $runtime_rel && "

  if [ -f "$runtime_dir/package.json" ]; then
    if command -v jq >/dev/null 2>&1; then
      local scripts
      scripts="$(jq -r '.scripts // {} | keys[]?' "$runtime_dir/package.json" 2>/dev/null || true)"
      if printf '%s\n' "$scripts" | grep -qx "dev"; then DEV_COMMAND="${prefix}npm run dev"; fi
      if printf '%s\n' "$scripts" | grep -qx "test"; then TEST_COMMAND="${prefix}npm test"; fi
      if printf '%s\n' "$scripts" | grep -qx "lint"; then LINT_COMMAND="${prefix}npm run lint"; fi
      if printf '%s\n' "$scripts" | grep -qx "typecheck"; then TYPECHECK_COMMAND="${prefix}npm run typecheck"; fi
    fi
    if [ -f "$runtime_dir/pnpm-lock.yaml" ]; then
      INSTALL_COMMAND="${prefix}pnpm install"
      [ -n "$DEV_COMMAND" ] && DEV_COMMAND="${DEV_COMMAND/npm run/pnpm}"
      [ -n "$TEST_COMMAND" ] && TEST_COMMAND="${TEST_COMMAND/npm test/pnpm test}"
      [ -n "$LINT_COMMAND" ] && LINT_COMMAND="${LINT_COMMAND/npm run/pnpm}"
      [ -n "$TYPECHECK_COMMAND" ] && TYPECHECK_COMMAND="${TYPECHECK_COMMAND/npm run/pnpm}"
    elif [ -f "$runtime_dir/yarn.lock" ]; then
      INSTALL_COMMAND="${prefix}yarn install"
      [ -n "$DEV_COMMAND" ] && DEV_COMMAND="${DEV_COMMAND/npm run/yarn}"
      [ -n "$TEST_COMMAND" ] && TEST_COMMAND="${TEST_COMMAND/npm test/yarn test}"
      [ -n "$LINT_COMMAND" ] && LINT_COMMAND="${LINT_COMMAND/npm run/yarn}"
      [ -n "$TYPECHECK_COMMAND" ] && TYPECHECK_COMMAND="${TYPECHECK_COMMAND/npm run/yarn}"
    elif [ -f "$runtime_dir/bun.lock" ] || [ -f "$runtime_dir/bun.lockb" ]; then
      INSTALL_COMMAND="${prefix}bun install"
      [ -n "$DEV_COMMAND" ] && DEV_COMMAND="${DEV_COMMAND/npm run/bun run}"
      [ -n "$TEST_COMMAND" ] && TEST_COMMAND="${TEST_COMMAND/npm test/bun test}"
      [ -n "$LINT_COMMAND" ] && LINT_COMMAND="${LINT_COMMAND/npm run/bun run}"
      [ -n "$TYPECHECK_COMMAND" ] && TYPECHECK_COMMAND="${TYPECHECK_COMMAND/npm run/bun run}"
    else
      INSTALL_COMMAND="${prefix}npm install"
    fi
  elif [ -f "$runtime_dir/pyproject.toml" ]; then
    if grep -q '^\[project.optional-dependencies\]' "$runtime_dir/pyproject.toml" 2>/dev/null && grep -q '^dev[[:space:]]*=' "$runtime_dir/pyproject.toml" 2>/dev/null; then
      INSTALL_COMMAND="${prefix}pip install -e '.[dev]'"
    else
      INSTALL_COMMAND="${prefix}pip install -e ."
    fi
    if [ -f "$runtime_dir/app/main.py" ] && grep -qi 'fastapi' "$runtime_dir/pyproject.toml" 2>/dev/null; then
      DEV_COMMAND="${prefix}uvicorn app.main:app --reload"
    fi
    TEST_COMMAND="${prefix}pytest"
  elif [ -f "$runtime_dir/go.mod" ]; then
    TEST_COMMAND="${prefix}go test ./..."
  elif [ -f "$runtime_dir/Cargo.toml" ]; then
    TEST_COMMAND="${prefix}cargo test"
  elif [ -f "$runtime_dir/Makefile" ]; then
    INSTALL_COMMAND="${prefix}make install"
    TEST_COMMAND="${prefix}make test"
  elif [ -f "$runtime_dir/web_app.py" ] || [ -f "$runtime_dir/app.py" ] || [ -f "$runtime_dir/main.py" ]; then
    local entry="web_app.py"
    [ -f "$runtime_dir/app.py" ] && entry="app.py"
    [ -f "$runtime_dir/main.py" ] && entry="main.py"
    [ -f "$runtime_dir/web_app.py" ] && entry="web_app.py"
    INSTALL_COMMAND="not_required"
    DEV_COMMAND="${prefix}python3 $entry"
    TEST_COMMAND="${prefix}python3 -m py_compile *.py modules/*/service.py apps/server/*.py"
    LOCAL_URL="http://127.0.0.1:8787"
  fi

  if [ -n "$INSTALL_COMMAND$DEV_COMMAND$TEST_COMMAND$LINT_COMMAND$TYPECHECK_COMMAND" ]; then
    RUNTIME_STATUS="ready"
  fi
}

if [ "$MODE" = "auto" ]; then
  if has_runtime_manifest; then
    EFFECTIVE_MODE="app"
  else
    EFFECTIVE_MODE="docs-only"
  fi
else
  EFFECTIVE_MODE="$MODE"
fi

GIT_STATUS="missing"
BRANCH="none"
GIT_REMOTE_URL=""
if git -C "$TARGET_DIR" rev-parse --show-toplevel >/dev/null 2>&1; then
  GIT_STATUS="ready"
  BRANCH="$(git -C "$TARGET_DIR" branch --show-current 2>/dev/null || true)"
  BRANCH="${BRANCH:-unknown}"
  GIT_REMOTE_URL="$(git -C "$TARGET_DIR" config --get remote.origin.url 2>/dev/null || true)"
fi
ensure_gitignore_entry ".gstack/backups/"

GITHUB_CLI_STATUS="missing"
GITHUB_CLI_AUTH="unknown"
GITHUB_CLI_COMMAND="gh"
GITHUB_CLI_BIN=""
if GITHUB_CLI_BIN="$(detect_github_cli 2>/dev/null)"; then
  if "$GITHUB_CLI_BIN" --version >/dev/null 2>&1; then
    if "$GITHUB_CLI_BIN" auth status >/dev/null 2>&1; then
      GITHUB_CLI_STATUS="ready"
      GITHUB_CLI_AUTH="authenticated"
    else
      GITHUB_CLI_STATUS="unauthenticated"
      GITHUB_CLI_AUTH="unauthenticated"
    fi
  fi
fi

REPOSITORY_STATUS="ready"
REPOSITORY_NEXT_ACTION="none"
CODE_CONTEXT_GATE="missing"
LONG_TERM_READINESS_STATUS="ready"
LONG_TERM_BLOCKERS=()
if [ "$EFFECTIVE_MODE" = "app" ] && [ "$GIT_STATUS" != "ready" ]; then
  REPOSITORY_STATUS="needs_git_baseline"
  REPOSITORY_NEXT_ACTION="initialize git baseline after user confirmation"
  CODE_CONTEXT_GATE="blocked_until_git"
  LONG_TERM_READINESS_STATUS="blocked_until_git"
  LONG_TERM_BLOCKERS=("needs_git_baseline")
fi

PROJECT_SIZE_BYTES="$(du -sb "$TARGET_DIR" 2>/dev/null | awk '{print $1}' || printf '0')"
SENSITIVE_PATHS_JSON="$(
  TARGET_DIR="$TARGET_DIR" node <<'NODE'
const fs = require('fs');
const path = require('path');
const root = process.env.TARGET_DIR;
const findings = [];
const sensitiveName = /(^|[._-])(token|secret|password|passwd|apikey|api-key|credential|credentials)([._-]|$)/i;
function add(file, reason) {
  findings.push({ path: file.split(path.sep).join('/'), reason });
}
function walk(dir, rel = '') {
  let entries = [];
  try { entries = fs.readdirSync(dir, { withFileTypes: true }); } catch { return; }
  for (const entry of entries) {
    const childRel = rel ? path.join(rel, entry.name) : entry.name;
    const child = path.join(dir, entry.name);
    const normalized = childRel.split(path.sep).join('/');
    if (normalized.startsWith('.git/') || normalized.startsWith('.gstack/') || normalized.startsWith('.ai-context/')) continue;
    if (entry.isDirectory()) {
      if (normalized === 'server_materials/10-access' || normalized.endsWith('/10-access')) add(normalized, 'server access directory');
      walk(child, childRel);
      continue;
    }
    if (!entry.isFile()) continue;
    if (/\.(pem|key|p12|pfx)$/i.test(entry.name)) add(normalized, 'private key material');
    else if (entry.name === '.env' || entry.name.startsWith('.env.')) add(normalized, 'environment secret file');
    else if (entry.name.toLowerCase() === 'mima.txt') add(normalized, 'password file name');
    else if (sensitiveName.test(entry.name)) add(normalized, 'sensitive file name');
  }
}
walk(root);
process.stdout.write(JSON.stringify(findings));
NODE
)"
SENSITIVE_CANDIDATES_JSON="$(printf '%s' "$SENSITIVE_PATHS_JSON" | node -e 'const fs=require("fs"); const items=JSON.parse(fs.readFileSync(0,"utf8")||"[]"); process.stdout.write(JSON.stringify(items.map((item)=>item.path).filter(Boolean)));')"
INSTALL_PREFLIGHT_JSON="$(cat <<EOF
{
  "schema": "gstack-harness.install_preflight.v1",
  "generated_at": "$(json_escape "$GENERATED_AT")",
  "target": "$(json_escape "$TARGET_DIR")",
  "project": {
    "id": "$(json_escape "$PROJECT_ID")",
    "size_bytes": ${PROJECT_SIZE_BYTES:-0}
  },
  "git": {
    "status": "$GIT_STATUS",
    "branch": "$(json_escape "$BRANCH")",
    "remote_url": "$(json_escape "$GIT_REMOTE_URL")"
  },
  "github_cli": {
    "status": "$(json_escape "$GITHUB_CLI_STATUS")",
    "auth": "$(json_escape "$GITHUB_CLI_AUTH")",
    "command": "$(json_escape "$GITHUB_CLI_COMMAND")"
  },
  "sensitive_paths": $SENSITIVE_PATHS_JSON,
  "planned_writes": [
    "PROJECT_STATE.md",
    "CLAUDE.md",
    ".gstack/project-state.json",
    ".gstack/harness/**",
    ".ai-context/project.json",
    "docs/FOUNDATION_READINESS_REPORT.md",
    "docs/CODEX_START_PROMPT.md"
  ]
}
EOF
)"
write_file ".gstack/install-preflight.json" "$INSTALL_PREFLIGHT_JSON"

GBRAIN_STATUS="unavailable"
GBRAIN_PAGES="0"
GBRAIN_QUERY_STATUS="not_run"
GBRAIN_QUERY_EVIDENCE="gbrain unavailable"
GBRAIN_BIN=""
if GBRAIN_BIN="$(detect_gbrain_bin 2>/dev/null)"; then
  activate_gbrain_path "$GBRAIN_BIN"
  if "$GBRAIN_BIN" --version >/dev/null 2>&1; then
    GBRAIN_STATUS="ready"
    if GBRAIN_LIST_OUTPUT="$(timeout 6s "$GBRAIN_BIN" list 2>&1)"; then
      if [ -n "$GBRAIN_LIST_OUTPUT" ]; then
        GBRAIN_PAGES="$(printf '%s\n' "$GBRAIN_LIST_OUTPUT" | wc -l | tr -d ' ')"
      else
        GBRAIN_PAGES="0"
      fi
    else
      GBRAIN_PAGES="unknown"
    fi
    if GBRAIN_QUERY_OUTPUT="$(timeout 20s "$GBRAIN_BIN" query "gbrain healthcheck project memory" --no-expand --limit 1 2>&1)"; then
      GBRAIN_QUERY_STATUS="ready"
      GBRAIN_QUERY_EVIDENCE="health query completed"
    else
      GBRAIN_QUERY_RC="$?"
      if [ "$GBRAIN_QUERY_RC" -eq 124 ]; then
        GBRAIN_QUERY_STATUS="timeout"
        GBRAIN_QUERY_EVIDENCE="query timed out; possible PGLite lock"
      else
        GBRAIN_QUERY_STATUS="failed"
        GBRAIN_QUERY_EVIDENCE="query failed with exit code $GBRAIN_QUERY_RC"
      fi
    fi
  fi
fi

GSTACK_STATUS="unavailable"
GSTACK_ROOT=""
GSTACK_SKILLS="0"
BROWSE_STATUS="missing_browser"
DESIGN_STATUS="missing"
GBRAIN_SYNC_MODE="unknown"
if GSTACK_ROOT="$(detect_gstack_root 2>/dev/null)"; then
  GSTACK_STATUS="ready"
  GSTACK_SKILLS="$(find "$GSTACK_ROOT" -maxdepth 2 -name SKILL.md 2>/dev/null | wc -l | tr -d ' ')"
  [ -x "$GSTACK_ROOT/browse/dist/browse" ] && BROWSE_STATUS="ready"
  [ -x "$GSTACK_ROOT/design/dist/design" ] && DESIGN_STATUS="ready"
  if [ -x "$GSTACK_ROOT/bin/gstack-config" ]; then
    GBRAIN_SYNC_MODE="$("$GSTACK_ROOT/bin/gstack-config" get gbrain_sync_mode 2>/dev/null || echo unknown)"
  fi
fi

