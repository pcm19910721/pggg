#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
gstack-harness-agent-status - write auditable per-agent status artifacts

Usage:
  gstack-harness-agent-status [--target DIR] [--event NAME]

Writes docs/agents/*.json and docs/AGENTS_STATUS.md from the current
.gstack/project-state.json and local reports. It does not edit business code.
EOF
}

TARGET="."
EVENT="agent_status_refresh"

while [ "$#" -gt 0 ]; do
  case "$1" in
    --target)
      TARGET="${2:-}"
      shift 2
      ;;
    --event)
      EVENT="${2:-}"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "ERROR: unknown argument: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

if ! command -v node >/dev/null 2>&1; then
  echo "ERROR: node is required for agent status generation" >&2
  exit 2
fi

TARGET_DIR="$(mkdir -p "$TARGET" && cd "$TARGET" && pwd)"
TARGET_DIR="$TARGET_DIR" EVENT="$EVENT" node <<'NODE'
const fs = require('fs');
const path = require('path');

const target = process.env.TARGET_DIR;
const event = process.env.EVENT || 'agent_status_refresh';
const generatedAt = new Date().toISOString();
const statePath = path.join(target, '.gstack/project-state.json');
const agentsDir = path.join(target, 'docs/agents');

function readJson(file, fallback = {}) {
  try {
    return JSON.parse(fs.readFileSync(file, 'utf8'));
  } catch {
    return fallback;
  }
}

function exists(rel) {
  return fs.existsSync(path.join(target, rel));
}

function writeJson(rel, value) {
  const file = path.join(target, rel);
  fs.mkdirSync(path.dirname(file), { recursive: true });
  fs.writeFileSync(file, JSON.stringify(value, null, 2) + '\n');
}

function compact(items) {
  return Array.from(new Set((items || []).filter(Boolean).map(String)));
}

function artifactEvidence(rel, label) {
  return exists(rel) ? `${label}: ${rel}` : '';
}

function statusFromGate(value, fallback = 'not_run') {
  const normalized = String(value || '').toLowerCase();
  if (!normalized) return fallback;
  if (['ready', 'passing', 'passed', 'accepted', 'complete', 'completed', 'done', 'synced', 'fixed', 'not_needed'].includes(normalized)) {
    return 'completed';
  }
  if (['blocked', 'failed', 'error'].includes(normalized)) return 'blocked';
  if (['partial', 'warning', 'stale', 'fallback'].includes(normalized)) return 'warning';
  if (['skipped', 'not_required'].includes(normalized)) return 'skipped';
  return normalized;
}

function nextActionFor(status, fallback) {
  if (status === 'completed' || status === 'skipped') return 'none';
  return fallback;
}

const state = readJson(statePath, {});
const gates = state.quality_gates || {};
const foundation = state.foundation || {};
const runtime = state.runtime || {};
const blockers = compact(state.blockers || []);
const warnings = compact(state.warnings || []);
const release = state.release || {};
const agentFiles = {};

const definitions = [
  {
    slug: 'orchestrator',
    name: 'Orchestrator Agent',
    status: state.next_recommended_agent ? 'completed' : 'warning',
    evidence: [
      artifactEvidence('PROJECT_STATE.md', 'project state'),
      artifactEvidence('.gstack/project-state.json', 'structured state'),
      `next agent: ${state.next_recommended_agent || 'unknown'}`,
      `next recipe: ${state.next_recommended_recipe || 'unknown'}`,
    ],
    blockers: [],
    next_action: state.next_recommended_agent ? 'route next recipe from PROJECT_STATE.md' : 'set next recommended agent and recipe',
  },
  {
    slug: 'foundation-readiness',
    name: 'Foundation Readiness Agent',
    status: statusFromGate(gates.foundation_readiness || foundation.readiness, 'unknown'),
    evidence: [
      artifactEvidence('docs/FOUNDATION_READINESS_REPORT.md', 'readiness report'),
      `readiness: ${foundation.readiness || gates.foundation_readiness || 'unknown'}`,
      `gbrain: ${foundation.gbrain || 'unknown'}`,
      `runtime: ${foundation.runtime || 'unknown'}`,
    ],
    blockers,
    next_action: nextActionFor(statusFromGate(gates.foundation_readiness || foundation.readiness, 'unknown'), 'run gstack-harness-readiness'),
  },
  {
    slug: 'foundation-remediation',
    name: 'Foundation Remediation Agent',
    status: statusFromGate(foundation.remediation, 'not_run'),
    evidence: [
      artifactEvidence('docs/FOUNDATION_REMEDIATION_REPORT.md', 'remediation report'),
      `remediation: ${foundation.remediation || 'not_run'}`,
    ],
    blockers,
    next_action: nextActionFor(statusFromGate(foundation.remediation, 'not_run'), 'run gstack-harness-remediate for remaining foundation gaps'),
  },
  {
    slug: 'problem-handling',
    name: 'Problem Handling Agent',
    status: state.problem_handling_required ? 'warning' : statusFromGate(state.problem_handling?.status, 'not_needed'),
    evidence: [
      artifactEvidence('docs/PROBLEM_HANDLING_REPORT.md', 'problem handling report'),
      `problem_handling_required: ${Boolean(state.problem_handling_required)}`,
    ],
    blockers: state.problem_handling_required ? blockers : [],
    next_action: state.problem_handling_required ? 'triage blockers and warnings before high-risk work' : 'none',
  },
  {
    slug: 'memory-gbrain',
    name: 'Memory / GBrain Agent',
    status: foundation.gbrain === 'ready' && !warnings.includes('gbrain_project_memory_missing') && !warnings.includes('gbrain_project_memory_stale') ? 'completed' : 'warning',
    evidence: [
      `gbrain: ${foundation.gbrain || 'unknown'}`,
      `gbrain query: ${foundation.gbrain_query || 'unknown'}`,
      artifactEvidence('.ai-context/gitnexus-index.md', 'index summary'),
      artifactEvidence('.ai-context/gbrain-fallback', 'fallback artifacts'),
    ],
    blockers: blockers.filter((item) => item.includes('gbrain')),
    next_action: foundation.gbrain === 'ready' ? 'run sync-gbrain or repair-gbrain if pages are stale' : 'restore gbrain availability',
  },
  {
    slug: 'system-tuning',
    name: 'System Tuning Agent',
    status: statusFromGate(state.system_tuning?.status, state.system_tuning?.active_issue ? 'warning' : 'not_needed'),
    evidence: [
      artifactEvidence('docs/SYSTEM_TUNING_REPORT.md', 'system tuning report'),
      `active issue: ${state.system_tuning?.active_issue || 'none'}`,
    ],
    blockers: [],
    next_action: state.system_tuning?.active_issue ? 'resolve or monitor active tuning issue' : 'none',
  },
  {
    slug: 'code-context',
    name: 'Code Context Agent',
    status: statusFromGate(gates.code_context, 'missing'),
    evidence: [
      artifactEvidence('docs/CODE_CONTEXT_REPORT.md', 'code context report'),
      artifactEvidence('.ai-context/gitnexus-status.json', 'gitnexus status'),
      `provider: ${state.code_context?.provider || 'gitnexus'}`,
      `status: ${gates.code_context || 'missing'}`,
    ],
    blockers: [],
    next_action: nextActionFor(statusFromGate(gates.code_context, 'missing'), 'run node scripts/ai-context-bridge.mjs status'),
  },
  {
    slug: 'product',
    name: 'Product Agent',
    status: exists('docs/PRODUCT_BRIEF.md') ? 'completed' : 'not_run',
    evidence: [artifactEvidence('docs/PRODUCT_BRIEF.md', 'product brief')],
    blockers: [],
    next_action: exists('docs/PRODUCT_BRIEF.md') ? 'none' : 'create product brief when product scope is requested',
  },
  {
    slug: 'planning',
    name: 'Planning Agent',
    status: exists('docs/IMPLEMENTATION_PLAN.md') ? 'completed' : 'not_run',
    evidence: [artifactEvidence('docs/IMPLEMENTATION_PLAN.md', 'implementation plan')],
    blockers: [],
    next_action: exists('docs/IMPLEMENTATION_PLAN.md') ? 'none' : 'create implementation plan for non-trivial changes',
  },
  {
    slug: 'design',
    name: 'Design Agent',
    status: exists('docs/DESIGN.md') ? 'completed' : 'not_run',
    evidence: [artifactEvidence('docs/DESIGN.md', 'design source of truth')],
    blockers: [],
    next_action: exists('docs/DESIGN.md') ? 'none' : 'run design workflow when UI/UX is in scope',
  },
  {
    slug: 'architecture',
    name: 'Architecture Agent',
    status: exists('docs/ARCHITECTURE.md') || exists('docs/CODE_CONTEXT_REPORT.md') ? 'completed' : 'not_run',
    evidence: [
      artifactEvidence('docs/ARCHITECTURE.md', 'architecture report'),
      artifactEvidence('docs/CODE_CONTEXT_REPORT.md', 'code context report'),
    ],
    blockers: [],
    next_action: 'refresh architecture plan before broad implementation',
  },
  {
    slug: 'build',
    name: 'Build Agent',
    status: state.build?.status || 'not_run',
    evidence: compact([state.build?.artifact, state.gate_evidence?.health?.command ? `health command: ${state.gate_evidence.health.command}` : '']),
    blockers: [],
    next_action: state.build?.status ? 'none' : 'implement scoped code changes when requested',
  },
  {
    slug: 'reality-test',
    name: 'Reality Test Agent',
    status: statusFromGate(gates.health, 'not_run'),
    evidence: [
      state.gate_evidence?.health?.command ? `command: ${state.gate_evidence.health.command}` : '',
      state.gate_evidence?.health?.artifact ? `artifact: ${state.gate_evidence.health.artifact}` : '',
      runtime.test ? `runtime test: ${runtime.test}` : '',
    ],
    blockers: [],
    next_action: nextActionFor(statusFromGate(gates.health, 'not_run'), 'run recorded health/test command'),
  },
  {
    slug: 'review',
    name: 'Review Agent',
    status: statusFromGate(gates.review, 'not_run'),
    evidence: [
      state.gate_evidence?.review?.artifact ? `artifact: ${state.gate_evidence.review.artifact}` : '',
      artifactEvidence('.ai-context/runs', 'GitNexus runs'),
    ],
    blockers: [],
    next_action: nextActionFor(statusFromGate(gates.review, 'not_run'), 'run review before release'),
  },
  {
    slug: 'security-perf',
    name: 'Security/Perf Agent',
    status: ['completed', 'warning'].includes(statusFromGate(gates.security, 'not_run')) || ['completed', 'warning'].includes(statusFromGate(gates.performance, 'not_run')) ? 'completed' : 'not_run',
    evidence: [
      state.gate_evidence?.security?.artifact ? `security artifact: ${state.gate_evidence.security.artifact}` : '',
      state.gate_evidence?.performance?.artifact ? `performance artifact: ${state.gate_evidence.performance.artifact}` : '',
    ],
    blockers: [],
    next_action: 'run security/performance checks before release when risk warrants',
  },
  {
    slug: 'release',
    name: 'Release Agent',
    status: release.status || (gates.deployment === 'blocked' ? 'blocked_by_environment' : statusFromGate(gates.deployment, 'not_started')),
    evidence: [
      `deployment gate: ${gates.deployment || 'not_started'}`,
      `remote: ${release.remote_url || 'missing'}`,
      `production_url: ${runtime.production_url || 'missing'}`,
    ],
    blockers: compact(release.blockers || (gates.deployment === 'blocked' ? ['release_environment_missing'] : [])),
    next_action: release.next_action || 'configure remote/deploy target or mark deployment intentionally skipped',
  },
  {
    slug: 'maintenance',
    name: 'Maintenance Agent',
    status: exists('docs/MAINTENANCE_REPORT.md') ? 'completed' : 'not_run',
    evidence: [artifactEvidence('docs/MAINTENANCE_REPORT.md', 'maintenance report')],
    blockers: [],
    next_action: exists('docs/MAINTENANCE_REPORT.md') ? 'none' : 'use for bugs, regressions, and ongoing upkeep',
  },
];

fs.mkdirSync(agentsDir, { recursive: true });
for (const item of definitions) {
  const payload = {
    schema: 'gstack-harness.agent_status.v1',
    generated_at: generatedAt,
    event,
    project_id: state.project_id || path.basename(target),
    agent: item.slug,
    name: item.name,
    status: item.status,
    evidence: compact(item.evidence),
    blockers: compact(item.blockers),
    warnings: warnings.filter((warning) => {
      if (item.slug === 'memory-gbrain') return warning.includes('gbrain');
      if (item.slug === 'foundation-readiness') return true;
      if (item.slug === 'release') return warning.includes('release') || warning.includes('deploy') || warning.includes('remote');
      return false;
    }),
    next_action: item.next_action || 'none',
  };
  const rel = `docs/agents/${item.slug}.json`;
  writeJson(rel, payload);
  agentFiles[item.slug] = rel;
}

const rows = definitions.map((item) => {
  const file = agentFiles[item.slug];
  const payload = readJson(path.join(target, file), {});
  return `| ${payload.name} | ${payload.status} | ${file} | ${payload.next_action || 'none'} |`;
});
const md = `# Agent Status

Generated: ${generatedAt}
Project: ${state.project_id || path.basename(target)}
Event: ${event}

| Agent | Status | Evidence Artifact | Next Action |
|---|---|---|---|
${rows.join('\n')}
`;
fs.writeFileSync(path.join(target, 'docs/AGENTS_STATUS.md'), md, 'utf8');

state.artifacts = {
  ...(state.artifacts || {}),
  agents_status_report: 'docs/AGENTS_STATUS.md',
  agents_status_dir: 'docs/agents',
  ...Object.fromEntries(Object.entries(agentFiles).map(([key, rel]) => [`agent_${key.replace(/-/g, '_')}_status`, rel])),
};
fs.mkdirSync(path.dirname(statePath), { recursive: true });
fs.writeFileSync(statePath, JSON.stringify(state, null, 2) + '\n');

process.stdout.write(JSON.stringify({
  status: 'written',
  event,
  project_id: state.project_id || path.basename(target),
  report: 'docs/AGENTS_STATUS.md',
  agents: agentFiles,
}, null, 2) + '\n');
NODE
