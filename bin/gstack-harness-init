if [ -f "$TARGET_DIR/.gstack/project-state.json" ] && command -v node >/dev/null 2>&1; then
  PROJECT_STATE_JSON="$(GENERATED_STATE_JSON="$PROJECT_STATE_JSON" EXISTING_MARKDOWN_EVIDENCE_JSON="$EXISTING_MARKDOWN_EVIDENCE_JSON" node - "$TARGET_DIR/.gstack/project-state.json" <<'NODE'
const fs = require('fs');
const existingPath = process.argv[2];
const generated = JSON.parse(process.env.GENERATED_STATE_JSON);
if (generated.repository?.status === 'needs_git_baseline') {
  generated.quality_gates = {
    ...(generated.quality_gates || {}),
    code_context: 'blocked_until_git',
  };
  generated.long_term_readiness = {
    status: 'blocked_until_git',
    blockers: ['needs_git_baseline'],
  };
  generated.next_recommended_agent = 'Foundation Remediation Agent';
  generated.next_recommended_recipe = 'Repository Baseline Gate';
}
const markdownEvidence = JSON.parse(process.env.EXISTING_MARKDOWN_EVIDENCE_JSON || '{}');
let existing = {};
try {
  existing = JSON.parse(fs.readFileSync(existingPath, 'utf8'));
} catch {}

const preserveTopLevel = [
  'status',
  'acceptance',
  'qa',
  'review',
  'security',
  'performance',
  'release',
  'deployment',
  'gate_evidence',
  'evidence',
];
const enrichedExisting = { ...existing };
if (markdownEvidence.phase) enrichedExisting.phase = markdownEvidence.phase;
if (markdownEvidence.goal) enrichedExisting.goal = markdownEvidence.goal;
if (markdownEvidence.last_completed_agent) enrichedExisting.last_completed_agent = markdownEvidence.last_completed_agent;
enrichedExisting.quality_gates = {
  ...(existing.quality_gates || {}),
  ...(markdownEvidence.quality_gates || {}),
};
enrichedExisting.runtime = {
  ...(existing.runtime || {}),
  ...(markdownEvidence.runtime || {}),
};
enrichedExisting.artifacts = {
  ...(existing.artifacts || {}),
  ...(markdownEvidence.artifacts || {}),
};
if (Object.keys(markdownEvidence.gate_evidence || {}).length) {
  enrichedExisting.gate_evidence = {
    ...(existing.gate_evidence || {}),
    ...markdownEvidence.gate_evidence,
  };
}

const next = { ...enrichedExisting, ...generated };
for (const key of preserveTopLevel) {
  if (enrichedExisting[key] !== undefined) next[key] = enrichedExisting[key];
}
next.quality_gates = {
  ...(generated.quality_gates || {}),
  ...(enrichedExisting.quality_gates || {}),
  foundation_readiness: generated.quality_gates?.foundation_readiness,
  code_context: generated.quality_gates?.code_context,
};
const completedGates = new Set(['accepted', 'complete', 'completed', 'done', 'passed', 'passing', 'ready', 'released', 'shipped']);
if (
  generated.release?.status === 'blocked_by_environment'
  && !completedGates.has(String(enrichedExisting.quality_gates?.deployment || '').toLowerCase())
) {
  next.quality_gates.deployment = generated.quality_gates?.deployment;
  next.release = generated.release;
}
next.artifacts = {
  ...(enrichedExisting.artifacts || {}),
  ...(generated.artifacts || {}),
};
const runtime = { ...(enrichedExisting.runtime || {}) };
for (const [key, value] of Object.entries(generated.runtime || {})) {
  const hasExisting = runtime[key] !== undefined && runtime[key] !== null && runtime[key] !== '';
  if (hasExisting && (value === undefined || value === null || value === '' || value === 'not_required')) continue;
  if (value !== undefined && value !== null && value !== '') runtime[key] = value;
}
next.runtime = runtime;
next.repeat_work = {
  ...(generated.repeat_work || {}),
  ...(enrichedExisting.repeat_work || {}),
};
try {
  const preflightPath = `${process.argv[2].replace(/\/\.gstack\/project-state\.json$/, '')}/.gstack/install-preflight.json`;
  const preflight = JSON.parse(fs.readFileSync(preflightPath, 'utf8'));
  next.file_ownership = {
    ...(generated.file_ownership || {}),
    ...(enrichedExisting.file_ownership || {}),
    do_not_commit_candidates: Array.from(new Set([
      ...((generated.file_ownership || {}).do_not_commit_candidates || []),
      ...((enrichedExisting.file_ownership || {}).do_not_commit_candidates || []),
      ...(preflight.sensitive_paths || []).map((item) => item.path).filter(Boolean),
    ])),
  };
} catch {}
next.phase = enrichedExisting.phase || generated.phase;
next.goal = enrichedExisting.goal || generated.goal;
next.last_completed_agent = enrichedExisting.last_completed_agent || generated.last_completed_agent;
process.stdout.write(`${JSON.stringify(next, null, 2)}\n`);
NODE
)"
fi

write_file ".gstack/project-state.json" "$PROJECT_STATE_JSON"

READINESS_REPORT="$(cat <<EOF
# Foundation Readiness Report

Generated: $DATE
Project: $PROJECT_ID
Workspace mode: target_project
Install mode: $EFFECTIVE_MODE
Verdict: $FOUNDATION_VERDICT

## Capability Sources

| Area | Status | Evidence |
|---|---|---|
| gbrain | $GBRAIN_STATUS | pages visible before init: $GBRAIN_PAGES |
| gbrain query | $GBRAIN_QUERY_STATUS | $GBRAIN_QUERY_EVIDENCE |
| gstack | $GSTACK_STATUS | root: ${GSTACK_ROOT:-not_found}; skills: $GSTACK_SKILLS |
| gstack browse | $BROWSE_STATUS | ${GSTACK_ROOT:-not_found}/browse/dist/browse |
| gstack design | $DESIGN_STATUS | ${GSTACK_ROOT:-not_found}/design/dist/design |
| gstack memory sync | $GBRAIN_SYNC_MODE | gstack-config gbrain_sync_mode |
| project protocol | $PROJECT_PROTOCOL_STATUS | harness files installed from $TEMPLATE_ROOT |
| agent team | ready | .gstack/harness/agents/TEAM.md |
| problem handling | $([ "$PROBLEM_HANDLING_REQUIRED" -eq 1 ] && printf 'required' || printf 'not_needed') | .gstack/harness/agents/problem-handling.md |
| git state | $GIT_STATUS | branch: $BRANCH |
| GitHub CLI | $GITHUB_CLI_STATUS | auth: $GITHUB_CLI_AUTH; standard remote/CI/PR path: gh CLI |
| repository baseline | $REPOSITORY_STATUS | $REPOSITORY_NEXT_ACTION |
| long-term readiness | $LONG_TERM_READINESS_STATUS | blockers: ${LONG_TERM_BLOCKERS[*]:-none} |
| runtime | $RUNTIME_STATUS | mode: $EFFECTIVE_MODE |

## Blockers

$BLOCKER_TEXT

## Warnings

$WARNING_TEXT

## Next Recommended Action

$(if [ "$FOUNDATION_VERDICT" = "ready" ]; then
  if [ "$PROBLEM_HANDLING_REQUIRED" -eq 1 ]; then
    printf 'Recipe: Problem Handling preflight, then R0 Restore / Resume Context\n\nReason: foundation is ready but a runtime warning needs Problem Handling before/alongside low-risk restore.\n'
  else
    printf 'Recipe: %s\n\nReason: foundation is ready; Orchestrator can continue from the current project operating state.\n' "$NEXT_RECIPE"
  fi
else
  printf 'Recipe: R-0.5 Foundation Remediation\n\nReason: foundation is not fully ready; resolve blockers before business recipes.\n'
fi)
EOF
)"

write_file "docs/FOUNDATION_READINESS_REPORT.md" "$READINESS_REPORT"

if [ "$DRY_RUN" -ne 1 ] && [ "$GBRAIN_STATUS" = "ready" ] && [ "$REPOSITORY_STATUS" != "needs_git_baseline" ] && [ -f "$TARGET_DIR/scripts/ai-context-bridge.mjs" ] && [ -f "$TARGET_DIR/.ai-context/project.json" ]; then
  if (cd "$TARGET_DIR" && timeout 90s node scripts/ai-context-bridge.mjs sync-gbrain --page overview --page state --page foundation_readiness --page code_context --page quality_gates --page handoff > "$TARGET_DIR/.gstack/sync-gbrain-last.json" 2> "$TARGET_DIR/.gstack/sync-gbrain-last.err"); then
    :
  else
    log "warning: initial gbrain project memory sync skipped or timed out"
  fi
fi

if [ "$DRY_RUN" -ne 1 ] && [ -x "$TARGET_DIR/.gstack/harness/bin/gstack-harness-readiness" ]; then
  timeout 45s "$TARGET_DIR/.gstack/harness/bin/gstack-harness-readiness" --target "$TARGET_DIR" --mode "$EFFECTIVE_MODE" > "$TARGET_DIR/.gstack/readiness-last.json" || true
  INITIAL_READINESS="$(node -e 'const fs=require("fs"); try { const s=JSON.parse(fs.readFileSync(process.argv[1],"utf8")); process.stdout.write(s.foundation?.readiness || "unknown"); } catch { process.stdout.write("unknown"); }' "$TARGET_DIR/.gstack/project-state.json" 2>/dev/null || printf 'unknown')"
  if [ "$INITIAL_READINESS" != "ready" ] && [ "$EFFECTIVE_MODE" != "docs-only" ] && [ "$REPOSITORY_STATUS" != "needs_git_baseline" ] && [ -x "$TARGET_DIR/.gstack/harness/bin/gstack-harness-remediate" ]; then
    if ! timeout 90s "$TARGET_DIR/.gstack/harness/bin/gstack-harness-remediate" --target "$TARGET_DIR" > "$TARGET_DIR/.gstack/remediation-last.out"; then
      printf 'Foundation remediation command exited non-zero or timed out. Initial readiness: %s\n' "$INITIAL_READINESS" >> "$TARGET_DIR/.gstack/remediation-last.out"
    fi
    timeout 45s "$TARGET_DIR/.gstack/harness/bin/gstack-harness-readiness" --target "$TARGET_DIR" --mode "$EFFECTIVE_MODE" > "$TARGET_DIR/.gstack/readiness-last.json" || true
  elif [ "$INITIAL_READINESS" != "ready" ] && [ "$EFFECTIVE_MODE" = "docs-only" ]; then
    :
  elif [ "$INITIAL_READINESS" != "ready" ] && [ "$REPOSITORY_STATUS" = "needs_git_baseline" ]; then
    printf 'Foundation remediation not run: repository baseline requires user-confirmed git initialization.\n' > "$TARGET_DIR/.gstack/remediation-last.out"
  else
    printf 'Foundation remediation not run: readiness is ready.\n' > "$TARGET_DIR/.gstack/remediation-last.out"
  fi
  if [ -x "$TARGET_DIR/.gstack/harness/bin/gstack-harness-agent-status" ]; then
    "$TARGET_DIR/.gstack/harness/bin/gstack-harness-agent-status" --target "$TARGET_DIR" --event harness_init >/dev/null 2>&1 || true
  fi
  if command -v node >/dev/null 2>&1; then
    FINAL_STATE_INFO="$(node -e 'const fs=require("fs"); const s=JSON.parse(fs.readFileSync(process.argv[1],"utf8")); if (s.repository?.status === "needs_git_baseline") { s.quality_gates = {...(s.quality_gates || {}), code_context: "blocked_until_git"}; s.long_term_readiness = {status: "blocked_until_git", blockers: ["needs_git_baseline"]}; s.next_recommended_agent = "Foundation Remediation Agent"; s.next_recommended_recipe = "Repository Baseline Gate"; fs.writeFileSync(process.argv[1], JSON.stringify(s, null, 2) + "\n"); } const vals=[s.foundation?.readiness||"",s.foundation?.gbrain||"",s.foundation?.gbrain_query||"",s.foundation?.runtime||"",s.next_recommended_agent||"",s.next_recommended_recipe||"",s.quality_gates?.code_context||""]; console.log(vals.map(v=>String(v).replace(/[\t\n\r]/g," ")).join("\t"));' "$TARGET_DIR/.gstack/project-state.json" 2>/dev/null || true)"
    IFS=$'\t' read -r FOUNDATION_VERDICT GBRAIN_STATUS GBRAIN_QUERY_STATUS RUNTIME_STATUS NEXT_AGENT NEXT_RECIPE CODE_CONTEXT_STATUS_FINAL <<< "$FINAL_STATE_INFO"
    FOUNDATION_VERDICT="${FOUNDATION_VERDICT:-ready}"
    GBRAIN_STATUS="${GBRAIN_STATUS:-unknown}"
    GBRAIN_QUERY_STATUS="${GBRAIN_QUERY_STATUS:-unknown}"
    RUNTIME_STATUS="${RUNTIME_STATUS:-unknown}"
    NEXT_AGENT="${NEXT_AGENT:-Orchestrator}"
    NEXT_RECIPE="${NEXT_RECIPE:-R0 Restore / Resume Context}"
    if [ "$REPOSITORY_STATUS" = "needs_git_baseline" ]; then
      CODE_CONTEXT_STATUS_FINAL="blocked_until_git"
      NEXT_AGENT="Foundation Remediation Agent"
      NEXT_RECIPE="Repository Baseline Gate"
      TARGET_DIR="$TARGET_DIR" node <<'NODE' >/dev/null 2>&1 || true
const fs = require('fs');
const path = require('path');
const statePath = path.join(process.env.TARGET_DIR, '.gstack/project-state.json');
const state = JSON.parse(fs.readFileSync(statePath, 'utf8'));
state.repository = {
  ...(state.repository || {}),
  status: 'needs_git_baseline',
  git: 'missing',
  branch: 'none',
  baseline_required: true,
  next_action: 'initialize git baseline after user confirmation',
};
state.long_term_readiness = {
  status: 'blocked_until_git',
  blockers: ['needs_git_baseline'],
};
state.quality_gates = {
  ...(state.quality_gates || {}),
  code_context: 'blocked_until_git',
};
state.next_recommended_agent = 'Foundation Remediation Agent';
state.next_recommended_recipe = 'Repository Baseline Gate';
fs.writeFileSync(statePath, `${JSON.stringify(state, null, 2)}\n`);
NODE
    fi
    if [ "$GBRAIN_STATUS" = "ready" ] && [ "$REPOSITORY_STATUS" != "needs_git_baseline" ] && [ -f "$TARGET_DIR/scripts/ai-context-bridge.mjs" ] && [ -f "$TARGET_DIR/.ai-context/project.json" ]; then
      (cd "$TARGET_DIR" && timeout 90s node scripts/ai-context-bridge.mjs sync-gbrain --page overview --page state --page foundation_readiness --page code_context --page quality_gates --page handoff > "$TARGET_DIR/.gstack/sync-gbrain-last.json" 2> "$TARGET_DIR/.gstack/sync-gbrain-last.err") || true
    fi
  fi
fi

if [ "$DRY_RUN" -ne 1 ] && [ "$EFFECTIVE_MODE" = "docs-only" ] && [ -x "$TARGET_DIR/.gstack/harness/bin/gstack-harness-agent-status" ]; then
  "$TARGET_DIR/.gstack/harness/bin/gstack-harness-agent-status" --target "$TARGET_DIR" --event harness_init >/dev/null 2>&1 || true
fi

if [ "$GIT_STATUS" = "ready" ]; then
  CODEX_SESSION_STEPS="$(cat <<'EOF'
15. 本轮开始时先跑 node scripts/ai-context-bridge.mjs baseline，把接管时已有 dirty worktree 记录成 baseline；再用 .gstack/harness/bin/gstack-harness-record-run --event session_start --status in_progress 记录快照。
16. 本轮结束时跑 node scripts/ai-context-bridge.mjs postchange --scope all 生成 session delta 报告；whole-worktree GitNexus risk 只作为 raw evidence，baseline 前已有脏文件只作为 warning。
17. 提交前只 stage 本轮 owned files，然后跑 node scripts/ai-context-bridge.mjs postchange --scope staged；staged report 才是 commit gate。
EOF
)"
else
  CODEX_SESSION_STEPS="$(cat <<'EOF'
15. 非 git 项目：长期多 agent 接管被 Repository Baseline Gate 阻塞；不要开始业务实现、review、ship 或 release。
16. 只允许做 README 扫描、安全 preflight、runtime detection、workspace hygiene baseline，以及向用户建议先建立 git baseline。
17. 先建立 git baseline：先运行 .gstack/harness/bin/gstack-harness-repository-baseline --target . --json 预检；经用户确认后再运行 .gstack/harness/bin/gstack-harness-repository-baseline --target . --yes --json 初始化 git、提交干净初始快照并刷新 baseline。完成前 GitNexus impact/detect-changes、postchange gate、commit automation、review/ship/release 都不可作为真实门禁。
EOF
)"
fi

CODEX_START_PROMPT="$(cat <<EOF
按 PROJECT_STATE.md、CLAUDE.md、HARNESS_PRODUCT_USAGE.md 和 ORCHESTRATOR_RUNBOOK.md 轻量接管这个项目，先判断下一步 recipe。

轻量接管原则：

- 接管只恢复导航状态，不恢复全部项目上下文。
- 默认只读取足够判断“现在在哪、卡在哪、下一步去哪”的最小状态。
- 不要展开完整代码图、长报告、长历史或大段 gbrain 内容。
- 只有进入具体任务时，才按任务展开代码、报告、gbrain 细节和 GitNexus 图谱。

请严格遵守：

1. 先读取 PROJECT_STATE.md。
2. 如果存在，读取 .gstack/project-state.json。
3. 读取 CLAUDE.md 中的 GSTACK_HARNESS managed block。
4. 读取 .gstack/harness/agents/TEAM.md 和 .gstack/harness/agents/problem-handling.md。
5. 读取 docs/PROBLEM_HANDLING_REPORT.md 和 docs/SYSTEM_TUNING_REPORT.md。
6. 读取 .ai-context/project.json 和 docs/CODE_CONTEXT_REPORT.md；docs/CODEBASE_MAP_REPORT.md 只是旧名兼容指针。
7. 读取 HARNESS_PRODUCT_USAGE.md、GSTACK_SKILL_REGISTRY.md、WORKFLOW_RECIPES.md、ORCHESTRATOR_RUNBOOK.md。
8. 如果 gbrain 可用，轻量读取 project/$PROJECT_ID/state 和 project/$PROJECT_ID/handoff；只检查 overview、foundation-readiness、code-context、quality-gates、gitnexus-index、architecture、hotspots 是否缺失或 stale，不要展开大段内容。需要刷新时只报告建议，除非用户要求，不要自动 sync。
9. 代码理解、产品判断、实现、review 或 incident 定位前，优先使用 Code Context Agent 的 GitNexus 流程：先跑 node scripts/ai-context-bridge.mjs status 和 node scripts/ai-context-bridge.mjs memory-check；如 stale 且依赖图谱准确，再 refresh；形成稳定摘要后跑 sync-gbrain。接管阶段只检查 stale，不展开完整图谱。UA 只作为 dashboard/onboarding/domain/fallback 增强。
10. 如果 gbrain query 遇到 PGLite lock 或 timeout，重试一次，仍失败就派发 Problem Handling Agent。
11. 不要重写 gstack skill 本体。
12. Foundation Readiness 如果是 unknown/stale，先跑 .gstack/harness/bin/gstack-harness-readiness --target "$TARGET_DIR"。如果是 partial/blocked，先跑 .gstack/harness/bin/gstack-harness-remediate --target "$TARGET_DIR"，再回到 readiness 复检。
13. 先输出当前 phase、Foundation Readiness、blockers/warnings、推荐 recipe、推荐 agent、是否需要刷新 memory/code context，以及简短原因。
14. 判断用户当前话语时，先结合同一个 session 内最近 1-2 次 Codex 输出，区分确认、纠正、补充需求、改变方向、指出缺失上下文或升级信号；需要长期沉淀时只记录摘要和 inferred delta，不保存完整 transcript。
$CODEX_SESSION_STEPS
18. GitHub remote/CI/PR/run 操作必须使用 \`gh\` CLI；本地 repo 状态、diff、add、commit 仍使用 \`git\`。
19. 完成状态更新后必须用 .gstack/harness/bin/gstack-harness-record-run --event session_end --status completed 记录 usage run；如有卡点、用户纠正、能力缺口、warning 或 blocker，把对应参数带上。
20. 除非我明确要求，不要开始业务代码修改。

当前安装器给出的初始判断：

- Project ID: $PROJECT_ID
- Target: $TARGET_DIR
- Install mode: $EFFECTIVE_MODE
- Foundation verdict: $FOUNDATION_VERDICT
- GitHub CLI: $GITHUB_CLI_STATUS ($GITHUB_CLI_AUTH)
- gbrain query: $GBRAIN_QUERY_STATUS
- Problem handling required: $([ "$PROBLEM_HANDLING_REQUIRED" -eq 1 ] && printf 'yes' || printf 'no')
- Next recommended agent: $NEXT_AGENT
- Readiness report: docs/FOUNDATION_READINESS_REPORT.md
EOF
)"

write_file "docs/CODEX_START_PROMPT.md" "$CODEX_START_PROMPT"

if [ "$GBRAIN_STATUS" = "ready" ] && [ "$DRY_RUN" -ne 1 ]; then
  if timeout 8s "$GBRAIN_BIN" get "project/$PROJECT_ID/overview" >/dev/null 2>&1; then
    :
  else
    PROJECT_STABLE_KEY="$TARGET_DIR"
    if git -C "$TARGET_DIR" rev-parse --show-toplevel >/dev/null 2>&1; then
      PROJECT_REMOTE_URL="$(git -C "$TARGET_DIR" config --get remote.origin.url 2>/dev/null || true)"
      [ -n "$PROJECT_REMOTE_URL" ] && PROJECT_STABLE_KEY="$PROJECT_REMOTE_URL"
    fi
    PROJECT_UID="$(printf '%s' "$PROJECT_STABLE_KEY" | sha256sum | cut -c1-16)"
    OVERVIEW_CONTENT="$(cat <<EOF
---
type: overview
title: "Project Overview: $PROJECT_ID"
project_id: "$PROJECT_ID"
project_uid: "$PROJECT_UID"
repo_path: "$TARGET_DIR"
tags:
  - scope:project
  - project:$PROJECT_ID
  - project_uid:$PROJECT_UID
  - type:overview
  - source:harness
  - status:active
---

# Project Overview: $PROJECT_ID

## Status

active

## Harness

Installed by local pggg on $DATE.

## Mode

$EFFECTIVE_MODE

## Foundation Verdict

$FOUNDATION_VERDICT

## Target

$TARGET_DIR
EOF
)"
  if timeout 30s env -u OPENAI_API_KEY GBRAIN_NO_AUTO_HOOKS=1 "$GBRAIN_BIN" put "project/$PROJECT_ID/overview" --content "$OVERVIEW_CONTENT" --no-embed --no-auto-hooks >/dev/null 2>&1; then
    timeout 10s "$GBRAIN_BIN" tag "project/$PROJECT_ID/overview" scope:project >/dev/null 2>&1 || true
    timeout 10s "$GBRAIN_BIN" tag "project/$PROJECT_ID/overview" "project:$PROJECT_ID" >/dev/null 2>&1 || true
    timeout 10s "$GBRAIN_BIN" tag "project/$PROJECT_ID/overview" type:overview >/dev/null 2>&1 || true
    timeout 10s "$GBRAIN_BIN" tag "project/$PROJECT_ID/overview" status:active >/dev/null 2>&1 || true
  else
    log "warning: gbrain overview update skipped or timed out"
  fi
  fi
fi

RECORDED_USAGE_PATH=""
record_usage_run() {
  local event="$1"
  local status="$2"
  local intent="$3"
  RECORDED_USAGE_PATH=""

  if [ "$DRY_RUN" -eq 1 ]; then
    log "DRY_RUN record usage run $event"
    return 0
  fi

  if [ ! -x "$TARGET_DIR/.gstack/harness/bin/gstack-harness-record-run" ] || ! command -v node >/dev/null 2>&1; then
    log "warning: usage run recording skipped; node or recorder missing"
    return 0
  fi

  USAGE_RECORD_ARGS=(
    --target "$TARGET_DIR"
    --event "$event"
    --status "$status"
    --agent "$NEXT_AGENT"
    --recipe "$NEXT_RECIPE"
    --intent "$intent"
    --template-source "$TEMPLATE_ROOT"
    --artifact "docs/FOUNDATION_READINESS_REPORT.md"
    --artifact "docs/FOUNDATION_REMEDIATION_REPORT.md"
    --artifact "docs/PROBLEM_HANDLING_REPORT.md"
    --artifact "docs/SYSTEM_TUNING_REPORT.md"
    --artifact "docs/CODE_CONTEXT_REPORT.md"
    --artifact "docs/CODEBASE_MAP_REPORT.md"
    --artifact ".ai-context/project.json"
    --artifact ".ai-context/gitnexus-status.json"
    --artifact ".ai-context/gitnexus-index.md"
  )
  for warning in "${WARNINGS[@]}"; do
    USAGE_RECORD_ARGS+=(--warning "$warning")
  done
  for blocker in "${BLOCKERS[@]}"; do
    USAGE_RECORD_ARGS+=(--blocker "$blocker")
  done

  if RECORDED_USAGE_PATH="$("$TARGET_DIR/.gstack/harness/bin/gstack-harness-record-run" "${USAGE_RECORD_ARGS[@]}" 2>/dev/null)"; then
    log "recorded usage run $RECORDED_USAGE_PATH"
  else
    log "warning: usage run recording failed"
    RECORDED_USAGE_PATH=""
  fi
}

record_usage_run "harness_init" "$FOUNDATION_VERDICT" "standard harness init"
USAGE_RUN_PATH="$RECORDED_USAGE_PATH"

