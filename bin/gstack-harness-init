if [ -f "$TARGET_DIR/PROJECT_STATE.md" ] && command -v node >/dev/null 2>&1; then
  PROJECT_STATE_CONTENT="$(GENERATED_PROJECT_STATE="$PROJECT_STATE_CONTENT" node - "$TARGET_DIR/PROJECT_STATE.md" <<'NODE'
const fs = require('fs');
const existingPath = process.argv[2];
const generated = process.env.GENERATED_PROJECT_STATE || '';
let existing = '';
try {
  existing = fs.readFileSync(existingPath, 'utf8');
} catch {}

function escapeRegExp(value) {
  return value.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
}

function generatedLine(label) {
  const pattern = new RegExp(`^- ${escapeRegExp(label)}: .*$`, 'm');
  return generated.match(pattern)?.[0] || null;
}

let next = existing || generated;
const ownedLabels = [
  'Phase',
  'Branch',
  'Last updated',
  'Last completed agent',
  'Next recommended agent',
  'Next recommended recipe',
  'Workspace mode',
  'Readiness',
  'Last readiness check',
  'Remediation',
  'Remediation report',
  'gbrain',
  'gbrain query',
  'gstack',
  'Project protocol',
  'Structured state',
  'Agent team',
  'Problem handling',
  'Runtime',
  'Runners',
  'Memory policy',
  'Install command',
  'Dev command',
  'Test command',
  'Lint command',
  'Typecheck command',
  'Local URL',
  'Production URL',
  'Release readiness',
  'Release blockers',
  'Release next action',
  'Foundation Readiness',
  'Code Context',
];

for (const label of ownedLabels) {
  const line = generatedLine(label);
  if (!line) continue;
  const pattern = new RegExp(`^- ${escapeRegExp(label)}: .*$`, 'm');
  const existingLine = next.match(pattern)?.[0] || '';
  const generatedValue = line.slice(line.indexOf(':') + 1).trim();
  const existingValue = existingLine.includes(':') ? existingLine.slice(existingLine.indexOf(':') + 1).trim() : '';
  if (
    ['Install command', 'Dev command', 'Test command', 'Lint command', 'Typecheck command', 'Local URL', 'Production URL'].includes(label)
    && existingValue
    && (!generatedValue || generatedValue === 'not_required')
  ) {
    continue;
  }
  if (pattern.test(next)) next = next.replace(pattern, line);
}

process.stdout.write(next.trimEnd() + '\n');
NODE
)"
fi

write_file "PROJECT_STATE.md" "$PROJECT_STATE_CONTENT"

