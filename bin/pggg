#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
pggg - one-command project harness entrypoint

Usage:
  cd /path/to/project
  pggg

This command installs, upgrades, refreshes, records usage, and hands the
current project to the Orchestrator.
EOF
}

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
INIT="$SCRIPT_DIR/gstack-harness-init"

is_complete_template_root() {
  local candidate_root
  candidate_root="$(cd "$1/.." 2>/dev/null && pwd || true)"
  [ -n "$candidate_root" ] \
    && [ -f "$candidate_root/CLAUDE_MD_TEMPLATE.md" ] \
    && [ -f "$candidate_root/WORKFLOW_RECIPES.md" ] \
    && [ -f "$candidate_root/bin/gstack-harness-init" ]
}

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
  usage
  exit 0
fi

if [ ! -x "$INIT" ] || ! is_complete_template_root "$SCRIPT_DIR"; then
  TARGET_CANDIDATE="$(cd "$SCRIPT_DIR/../../.." 2>/dev/null && pwd || true)"
  if [ -n "$TARGET_CANDIDATE" ] && [ -f "$TARGET_CANDIDATE/.gstack/project-state.json" ] && command -v node >/dev/null 2>&1; then
    TEMPLATE_SOURCE="$(node -e 'const fs=require("fs"); const p=process.argv[1]; try { const s=JSON.parse(fs.readFileSync(p,"utf8")); if (s.template_source) process.stdout.write(s.template_source); } catch {}' "$TARGET_CANDIDATE/.gstack/project-state.json" 2>/dev/null || true)"
    if [ -n "$TEMPLATE_SOURCE" ] && [ -x "$TEMPLATE_SOURCE/bin/gstack-harness-init" ]; then
      INIT="$TEMPLATE_SOURCE/bin/gstack-harness-init"
    fi
  fi
fi

if [ ! -x "$INIT" ]; then
  echo "ERROR: missing harness implementation. Expected $SCRIPT_DIR/gstack-harness-init or template_source/bin/gstack-harness-init from .gstack/project-state.json" >&2
  exit 1
fi

exec "$INIT" "$@"
