#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
gstack-harness-remediate - repair safe GStack Harness foundation gaps

Usage:
  gstack-harness-remediate [--target DIR] [--dry-run] [--skip-code-context]

Scope:
  - Creates missing harness directories and protocol placeholders.
  - Restores harness-owned bridge/recorder files from the template source when available.
  - Runs scripts/ai-context-bridge.mjs sync-gbrain when possible to refresh
    Code Context artifacts and project-scoped gbrain memory pages.
  - Updates docs/FOUNDATION_REMEDIATION_REPORT.md and .gstack/project-state.json.
  - Records a structured usage run when the recorder is available.

This command does not edit business source code, gstack skill internals, credentials,
deploy settings, or destructive configuration.
EOF
}

TARGET="."
DRY_RUN=0
SKIP_CODE_CONTEXT=0

while [ "$#" -gt 0 ]; do
  case "$1" in
    --target)
      TARGET="${2:-}"
      shift 2
      ;;
    --dry-run)
      DRY_RUN=1
      shift
      ;;
    --skip-code-context)
      SKIP_CODE_CONTEXT=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "ERROR: unknown argument: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

if ! command -v node >/dev/null 2>&1; then
  echo "ERROR: node is required for structured remediation state updates" >&2
  exit 2
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TARGET_DIR="$(mkdir -p "$TARGET" && cd "$TARGET" && pwd)"
DATE="$(date +%Y-%m-%d)"
GENERATED_AT="$(date -Iseconds)"
TMP_DIR="$(mktemp -d "${TMPDIR:-/tmp}/gstack-remediate-XXXXXX")"
trap 'rm -rf "$TMP_DIR"' EXIT

ACTIONS_FILE="$TMP_DIR/actions.tsv"
FILES_FILE="$TMP_DIR/files.tsv"
WARNINGS_FILE="$TMP_DIR/warnings.txt"
META_FILE="$TMP_DIR/meta.json"
: > "$ACTIONS_FILE"
: > "$FILES_FILE"
: > "$WARNINGS_FILE"

log() {
  printf '%s\n' "$*"
}

record_action() {
  printf '%s\t%s\t%s\n' "$1" "$2" "$3" >> "$ACTIONS_FILE"
}

record_file() {
  printf '%s\t%s\n' "$1" "$2" >> "$FILES_FILE"
}

record_warning() {
  printf '%s\n' "$1" >> "$WARNINGS_FILE"
}

json_field() {
  local file="$1"
  local expr="$2"
  local fallback="$3"
  node -e "
    const fs = require('fs');
    const file = process.argv[1];
    const fallback = process.argv[3];
    try {
      const state = JSON.parse(fs.readFileSync(file, 'utf8'));
      const value = ($expr);
      process.stdout.write(value === undefined || value === null || value === '' ? fallback : String(value));
    } catch {
      process.stdout.write(fallback);
    }
  " "$file" "$expr" "$fallback"
}

slugify() {
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9._-]/-/g; s/-*$//; s/^$/project/'
}

detect_gbrain_bin() {
  if command -v gbrain >/dev/null 2>&1; then
    command -v gbrain
    return 0
  fi
  if [ -x "$HOME/.bun/bin/gbrain" ]; then
    printf '%s\n' "$HOME/.bun/bin/gbrain"
    return 0
  fi
  return 1
}

detect_bun_bin() {
  if command -v bun >/dev/null 2>&1; then
    command -v bun
    return 0
  fi
  for candidate in \
    "${BUN_INSTALL:-}/bin/bun" \
    "$HOME/.bun/bin/bun" \
    "/usr/local/bin/bun" \
    "/opt/homebrew/bin/bun" \
    "/usr/bin/bun"
  do
    if [ -n "$candidate" ] && [ -x "$candidate" ]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  return 1
}

activate_gbrain_path() {
  local gbrain_bin="$1"
  local bun_bin=""
  PATH="$(dirname "$gbrain_bin"):$PATH"
  if bun_bin="$(detect_bun_bin 2>/dev/null)"; then
    PATH="$(dirname "$bun_bin"):$PATH"
  fi
}

STATE_PATH="$TARGET_DIR/.gstack/project-state.json"
PROJECT_ID="$(json_field "$STATE_PATH" "state.project_id" "$(slugify "$(basename "$TARGET_DIR")")")"
TEMPLATE_SOURCE="$(json_field "$STATE_PATH" "state.template_source" "")"

if [ -z "$TEMPLATE_SOURCE" ]; then
  CANDIDATE_TEMPLATE="$(cd "$SCRIPT_DIR/.." && pwd)"
  if [ -f "$CANDIDATE_TEMPLATE/scripts/ai-context-bridge.mjs" ]; then
    TEMPLATE_SOURCE="$CANDIDATE_TEMPLATE"
  fi
fi

ensure_dir() {
  local rel="$1"
  local dest="$TARGET_DIR/$rel"
  if [ -d "$dest" ]; then
    return 0
  fi
  if [ "$DRY_RUN" -eq 1 ]; then
    log "DRY_RUN mkdir $rel"
  else
    mkdir -p "$dest"
  fi
  record_action "ensure_dir" "$rel" "created missing harness directory"
  record_file "$rel" "created directory"
}

write_if_missing() {
  local rel="$1"
  local content="$2"
  local dest="$TARGET_DIR/$rel"
  if [ -e "$dest" ]; then
    return 0
  fi
  if [ "$DRY_RUN" -eq 1 ]; then
    log "DRY_RUN write $rel"
  else
    mkdir -p "$(dirname "$dest")"
    printf '%s\n' "$content" > "$dest"
  fi
  record_action "write_missing_file" "$rel" "created safe harness placeholder"
  record_file "$rel" "created missing file"
}

copy_from_template_if_missing() {
  local src_rel="$1"
  local dest_rel="$2"
  local dest="$TARGET_DIR/$dest_rel"
  if [ -e "$dest" ]; then
    return 0
  fi
  if [ -z "$TEMPLATE_SOURCE" ] || [ ! -f "$TEMPLATE_SOURCE/$src_rel" ]; then
    record_warning "template_source_missing_for_$dest_rel"
    return 0
  fi
  if [ "$DRY_RUN" -eq 1 ]; then
    log "DRY_RUN copy $src_rel -> $dest_rel"
  else
    mkdir -p "$(dirname "$dest")"
    cp "$TEMPLATE_SOURCE/$src_rel" "$dest"
    case "$dest_rel" in
      bin/*|.gstack/harness/bin/*|scripts/*.mjs) chmod +x "$dest" 2>/dev/null || true ;;
    esac
  fi
  record_action "restore_template_file" "$dest_rel" "restored from template source"
  record_file "$dest_rel" "restored from template"
}

copy_from_template_if_missing_any() {
  local dest_rel="$1"
  shift
  local src_rel
  for src_rel in "$@"; do
    if [ -n "$TEMPLATE_SOURCE" ] && [ -f "$TEMPLATE_SOURCE/$src_rel" ]; then
      copy_from_template_if_missing "$src_rel" "$dest_rel"
      return 0
    fi
  done
  record_warning "template_source_missing_for_$dest_rel"
}

ensure_dir ".gstack"
ensure_dir ".gstack/harness"
ensure_dir ".gstack/harness/bin"
ensure_dir ".gstack/harness/agents"
ensure_dir ".gstack/usage-runs"
ensure_dir ".ai-context"
ensure_dir ".ai-context/runs"
ensure_dir "docs"
ensure_dir "scripts"

copy_from_template_if_missing "scripts/ai-context-bridge.mjs" "scripts/ai-context-bridge.mjs"
copy_from_template_if_missing "bin/gstack-harness-record-run" ".gstack/harness/bin/gstack-harness-record-run"
copy_from_template_if_missing "bin/gstack-harness-readiness" ".gstack/harness/bin/gstack-harness-readiness"
copy_from_template_if_missing_any ".gstack/harness/bin/gstack-harness-agent-status" "bin/gstack-harness-agent-status" ".gstack/harness/bin/gstack-harness-agent-status"

write_if_missing ".gstack/usage-runs/README.md" "# Usage Runs

Structured harness usage runs are written here by gstack-harness-record-run."

write_if_missing "docs/FOUNDATION_READINESS_REPORT.md" "# Foundation Readiness Report

Generated: $DATE
Project: $PROJECT_ID
Verdict: unknown

This placeholder was created by Foundation Remediation because the readiness report was missing."

write_if_missing "docs/CODE_CONTEXT_REPORT.md" "# Code Context Report

Generated: $DATE
Project: $PROJECT_ID
Status: missing

Run node scripts/ai-context-bridge.mjs status to refresh GitNexus-first code context artifacts."

write_if_missing "PROJECT_STATE.md" "# Project State

## Current

- Phase: foundation
- Last updated: $DATE
- Last completed agent: Foundation Remediation Agent
- Next recommended agent: Foundation Readiness Agent
- Next recommended recipe: R-1 Foundation Readiness Check

## Foundation

- Readiness: unknown
- Last readiness check: docs/FOUNDATION_READINESS_REPORT.md
- Remediation: partial
- Remediation report: docs/FOUNDATION_REMEDIATION_REPORT.md

## Quality Gates

- Foundation Readiness: unknown
- Code Context: missing

## Artifacts

- Foundation readiness report: docs/FOUNDATION_READINESS_REPORT.md
- Foundation remediation report: docs/FOUNDATION_REMEDIATION_REPORT.md
- Code context report: docs/CODE_CONTEXT_REPORT.md"

if [ ! -f "$TARGET_DIR/.ai-context/project.json" ]; then
  if [ -f "$TARGET_DIR/scripts/ai-context-bridge.mjs" ] && [ "$DRY_RUN" -ne 1 ]; then
    if (cd "$TARGET_DIR" && node scripts/ai-context-bridge.mjs init --project-id "$PROJECT_ID" --repo "$TARGET_DIR" >/dev/null 2>"$TMP_DIR/bridge-init.err"); then
      record_action "init_code_context_bridge" ".ai-context/project.json" "created GitNexus-first bridge config"
      record_file ".ai-context/project.json" "created by bridge init"
    else
      record_warning "ai_context_bridge_init_failed"
    fi
  fi
fi

if [ ! -f "$TARGET_DIR/.ai-context/project.json" ]; then
  if [ "$DRY_RUN" -eq 1 ]; then
    log "DRY_RUN write .ai-context/project.json"
  else
    TARGET_DIR="$TARGET_DIR" PROJECT_ID="$PROJECT_ID" node <<'NODE'
const fs = require('fs');
const path = require('path');
const target = process.env.TARGET_DIR;
const projectId = process.env.PROJECT_ID;
const config = {
  schema_version: '0.1.0',
  project_id: projectId,
  repo_path: target,
  base_branch: 'main',
  code_context_provider: 'gitnexus',
  gitnexus: {
    repo: projectId,
    command: ['gitnexus'],
    fallback_command: ['npx', '-y', 'gitnexus@latest'],
    prefer_local: true,
    owns: ['source_code', 'symbols', 'imports', 'calls', 'execution_flows', 'impact', 'diff_analysis'],
    embeddings: true,
    skip_agents_md: true,
    no_stats: true,
  },
  gbrain: {
    owns: ['memory', 'decisions', 'state', 'summaries', 'reports', 'handoffs'],
    store_gitnexus_outputs: 'summaries_only',
    never_import_paths: ['src/', 'app/', 'lib/', 'packages/', 'tests/', '.gitnexus/', '.understand-anything/', 'docs/agents/'],
    pages: {
      overview: `project/${projectId}/overview`,
      state: `project/${projectId}/state`,
      foundation_readiness: `project/${projectId}/foundation-readiness`,
      architecture: `project/${projectId}/architecture`,
      decisions: `project/${projectId}/decisions`,
      assumptions: `project/${projectId}/assumptions`,
      hotspots: `project/${projectId}/hotspots`,
      code_context: `project/${projectId}/code-context`,
      quality_gates: `project/${projectId}/quality-gates`,
      handoff: `project/${projectId}/handoff`,
      gitnexus_index: `project/${projectId}/gitnexus-index`,
    },
  },
  optional_providers: {
    understand_anything: {
      use_for: ['visual_dashboard', 'onboarding', 'domain_graph', 'fallback'],
      artifacts: {
        knowledge_graph: '.understand-anything/knowledge-graph.json',
        domain_graph: '.understand-anything/domain-graph.json',
        diff_overlay: '.understand-anything/diff-overlay.json',
      },
    },
  },
  quality_gates: {
    test_commands: [],
    dev_commands: [],
    must_run_before_finish: [],
    impact_required_for: ['api', 'schema', 'auth', 'shared', 'billing', 'permissions', 'core-flow'],
  },
  automation: {
    auto_refresh_gitnexus: true,
    write_gbrain_change_notes: false,
    write_gbrain_index_status: false,
  },
};
fs.mkdirSync(path.join(target, '.ai-context'), { recursive: true });
fs.writeFileSync(path.join(target, '.ai-context/project.json'), JSON.stringify(config, null, 2) + '\n');
NODE
  fi
  record_action "write_ai_context_config" ".ai-context/project.json" "created GitNexus local-first config"
  record_file ".ai-context/project.json" "created missing config"
fi

seed_gbrain_page() {
  local slug="$1"
  local title="$2"
  local body="$3"
  local page_type="${4:-project}"
  local gbrain_bin
  if ! gbrain_bin="$(detect_gbrain_bin 2>/dev/null)"; then
    record_warning "gbrain_unavailable"
    return 0
  fi
  activate_gbrain_path "$gbrain_bin"
  if ! "$gbrain_bin" --version >/dev/null 2>&1; then
    record_warning "gbrain_unavailable"
    return 0
  fi
  if [ "$DRY_RUN" -eq 1 ]; then
    log "DRY_RUN gbrain put $slug"
    record_action "seed_gbrain_page" "$slug" "would seed core gbrain page"
    return 0
  fi
  if timeout 6s "$gbrain_bin" list 2>/dev/null | grep -Fq "$slug"; then
    record_action "verify_gbrain_page" "$slug" "core gbrain page already present"
    return 0
  fi
  local gbrain_rc
  local content
  local project_uid
  local project_stable_key
  local remote_url
  project_stable_key="$TARGET_DIR"
  if git -C "$TARGET_DIR" rev-parse --show-toplevel >/dev/null 2>&1; then
    remote_url="$(git -C "$TARGET_DIR" config --get remote.origin.url 2>/dev/null || true)"
    [ -n "$remote_url" ] && project_stable_key="$remote_url"
  fi
  project_uid="$(printf '%s' "$project_stable_key" | sha256sum | cut -c1-16)"
  if [ "${slug#project/}" != "$slug" ]; then
    content="$(cat <<EOF
---
type: $page_type
title: "$title"
project_id: "$PROJECT_ID"
project_uid: "$project_uid"
repo_path: "$TARGET_DIR"
tags:
  - scope:project
  - project:$PROJECT_ID
  - project_uid:$project_uid
  - type:$page_type
  - source:harness
  - status:active
---

# $title

$body
EOF
)"
  else
    content="$(cat <<EOF
---
type: $page_type
title: "$title"
tags:
  - scope:system
  - type:$page_type
  - source:harness
  - status:active
---

# $title

$body
EOF
)"
  fi
  if timeout 8s env -u OPENAI_API_KEY GBRAIN_NO_AUTO_HOOKS=1 "$gbrain_bin" put "$slug" --content "$content" --no-embed --no-auto-hooks >/dev/null 2>&1; then
    if [ "${slug#project/}" != "$slug" ]; then
      timeout 4s "$gbrain_bin" tag "$slug" scope:project >/dev/null 2>&1 || true
      timeout 4s "$gbrain_bin" tag "$slug" "project:$PROJECT_ID" >/dev/null 2>&1 || true
      timeout 4s "$gbrain_bin" tag "$slug" "project_uid:$project_uid" >/dev/null 2>&1 || true
    else
      timeout 4s "$gbrain_bin" tag "$slug" scope:system >/dev/null 2>&1 || true
    fi
    timeout 4s "$gbrain_bin" tag "$slug" "type:$page_type" >/dev/null 2>&1 || true
    timeout 4s "$gbrain_bin" tag "$slug" source:harness >/dev/null 2>&1 || true
    timeout 4s "$gbrain_bin" tag "$slug" status:active >/dev/null 2>&1 || true
    record_action "seed_gbrain_page" "$slug" "seeded core gbrain page"
  else
    gbrain_rc="$?"
    if [ "$gbrain_rc" -eq 124 ]; then
      record_warning "gbrain_seed_timeout"
    else
      record_warning "gbrain_seed_failed"
    fi
  fi
}

seed_gbrain_page "system/orchestration-principles" "Orchestration Principles" "Use gstack skills as the capability layer, GitNexus as the current code-fact layer, and gbrain as durable memory. Do not rewrite gstack skill internals from target projects." "concept"
seed_gbrain_page "system/harness-product-usage" "Harness Product Usage" "The normal user path is cd target-project && pggg. The harness installs protocol files, runs readiness, routes remediation, records usage, and hands off to Orchestrator." "concept"
seed_gbrain_page "system/capability-gap-backlog" "Capability Gap Backlog" "Record repeated warnings, blockers, and handoff failures here so System Tuning can turn them into harness or workflow improvements." "concept"
seed_gbrain_page "project/$PROJECT_ID/overview" "Project Overview: $PROJECT_ID" "Harness project id: $PROJECT_ID. Target path: $TARGET_DIR" "overview"
seed_gbrain_page "project/$PROJECT_ID/state" "Project State: $PROJECT_ID" "Local machine-readable state lives in .gstack/project-state.json. Human-readable state lives in PROJECT_STATE.md." "state"
seed_gbrain_page "project/$PROJECT_ID/foundation-readiness" "Foundation Readiness: $PROJECT_ID" "Readiness is diagnosed by .gstack/harness/bin/gstack-harness-readiness and summarized in docs/FOUNDATION_READINESS_REPORT.md." "foundation-readiness"
seed_gbrain_page "project/$PROJECT_ID/code-context" "Code Context: $PROJECT_ID" "GitNexus is the default Code Context provider. UA is optional for dashboard, onboarding, domain graph, and fallback." "code-context"
seed_gbrain_page "project/$PROJECT_ID/quality-gates" "Quality Gates: $PROJECT_ID" "Quality gates are stored in .gstack/project-state.json and evidenced by reports under docs/." "quality-gates"

GBRAIN_BIN="$(detect_gbrain_bin 2>/dev/null || true)"
if [ -n "$GBRAIN_BIN" ]; then
  activate_gbrain_path "$GBRAIN_BIN"
fi
if [ "$SKIP_CODE_CONTEXT" -ne 1 ] && [ -f "$TARGET_DIR/scripts/ai-context-bridge.mjs" ] && [ -f "$TARGET_DIR/.ai-context/project.json" ]; then
  if [ "$DRY_RUN" -eq 1 ]; then
    log "DRY_RUN node scripts/ai-context-bridge.mjs sync-gbrain"
  elif [ -n "$GBRAIN_BIN" ] && "$GBRAIN_BIN" --version >/dev/null 2>&1 && (cd "$TARGET_DIR" && node scripts/ai-context-bridge.mjs sync-gbrain > "$TMP_DIR/sync-gbrain.out" 2> "$TMP_DIR/sync-gbrain.err"); then
    SYNC_STATUS="$(json_field "$TMP_DIR/sync-gbrain.out" "state.status" "unknown")"
    record_action "sync_gbrain_project_memory" "project/$PROJECT_ID" "ran GitNexus bridge sync-gbrain ($SYNC_STATUS)"
    if [ "$SYNC_STATUS" != "synced" ]; then
      while IFS= read -r sync_warning; do
        [ -n "$sync_warning" ] && record_warning "$sync_warning"
      done < <(node -e 'const fs=require("fs"); try { const s=JSON.parse(fs.readFileSync(process.argv[1],"utf8")); for (const w of (s.warnings||[])) console.log(String(w)); } catch {}' "$TMP_DIR/sync-gbrain.out")
      record_file ".ai-context/gbrain-fallback" "captured gbrain fallback artifacts from bridge sync-gbrain"
    fi
    record_file "docs/CODE_CONTEXT_REPORT.md" "refreshed by bridge sync-gbrain"
    record_file ".ai-context/gitnexus-status.json" "refreshed by bridge sync-gbrain"
    record_file ".ai-context/gitnexus-index.json" "refreshed by bridge sync-gbrain"
    record_file ".ai-context/gitnexus-index.md" "refreshed by bridge sync-gbrain"
  elif (cd "$TARGET_DIR" && node scripts/ai-context-bridge.mjs status > "$TMP_DIR/code-context-status.out" 2> "$TMP_DIR/code-context-status.err"); then
    record_action "refresh_code_context_status" "docs/CODE_CONTEXT_REPORT.md" "ran GitNexus bridge status"
    record_file "docs/CODE_CONTEXT_REPORT.md" "refreshed by bridge status"
    record_file ".ai-context/gitnexus-status.json" "refreshed by bridge status"
    record_warning "gbrain_project_memory_sync_failed"
  else
    record_warning "code_context_status_failed"
  fi
fi

TARGET_DIR="$TARGET_DIR" \
PROJECT_ID="$PROJECT_ID" \
TEMPLATE_SOURCE="$TEMPLATE_SOURCE" \
GENERATED_AT="$GENERATED_AT" \
DATE="$DATE" \
DRY_RUN="$DRY_RUN" \
ACTIONS_FILE="$ACTIONS_FILE" \
FILES_FILE="$FILES_FILE" \
WARNINGS_FILE="$WARNINGS_FILE" \
META_FILE="$META_FILE" \
node <<'NODE'
const fs = require('fs');
const path = require('path');

const target = process.env.TARGET_DIR;
const projectId = process.env.PROJECT_ID;
const generatedAt = process.env.GENERATED_AT;
const date = process.env.DATE;
const dryRun = process.env.DRY_RUN === '1';
const statePath = path.join(target, '.gstack/project-state.json');
const reportPath = path.join(target, 'docs/FOUNDATION_REMEDIATION_REPORT.md');
const projectStateMdPath = path.join(target, 'PROJECT_STATE.md');

function readJson(file, fallback) {
  try {
    return JSON.parse(fs.readFileSync(file, 'utf8'));
  } catch {
    return fallback;
  }
}

function readTsv(file, width) {
  try {
    return fs.readFileSync(file, 'utf8')
      .split(/\r?\n/)
      .filter(Boolean)
      .map((line) => {
        const parts = line.split('\t');
        while (parts.length < width) parts.push('');
        return parts;
      });
  } catch {
    return [];
  }
}

function readLines(file) {
  try {
    return fs.readFileSync(file, 'utf8')
      .split(/\r?\n/)
      .map((line) => line.trim())
      .filter(Boolean);
  } catch {
    return [];
  }
}

function unique(items) {
  return Array.from(new Set(items.filter(Boolean)));
}

function yamlList(items, render) {
  if (!items.length) return '    []';
  return items.map(render).join('\n');
}

const actions = readTsv(process.env.ACTIONS_FILE, 3)
  .map(([action, targetName, evidence]) => ({ action, target: targetName, evidence }));
const filesChanged = readTsv(process.env.FILES_FILE, 2)
  .map(([file, reason]) => ({ path: file, reason }));
const warningsFromRun = readLines(process.env.WARNINGS_FILE);
const state = readJson(statePath, {});
const existingReadiness = state.foundation?.readiness || state.quality_gates?.foundation_readiness || 'unknown';
const fixedBlockers = new Set([
  'project_protocol_missing',
  'project_state_missing',
  'structured_state_missing',
  'local_instructions_missing',
  'ai_context_missing',
  'code_context_report_missing',
  'usage_runs_missing',
  'harness_runner_missing',
]);
const existingBlockers = Array.isArray(state.blockers) ? state.blockers : [];
const remainingBlockers = existingBlockers.filter((blocker) => !fixedBlockers.has(String(blocker)));
const transientWarnings = new Set([
  'gbrain_empty',
  'gbrain_core_pages_missing',
  'gbrain_query_timeout',
  'gbrain_query_failed',
  'gbrain_sync_off',
  'runtime_missing',
  'not_git_repo',
  'browse_missing',
  'code_context_status_failed',
  'gbrain_seed_failed',
  'gbrain_seed_timeout',
  'gbrain_project_memory_missing',
  'gbrain_project_memory_stale',
  'gbrain_project_memory_sync_failed',
]);
const existingWarnings = (Array.isArray(state.warnings) ? state.warnings : [])
  .filter((warning) => !transientWarnings.has(String(warning)));
const warnings = unique([...existingWarnings, ...warningsFromRun]);
const hardBlockers = remainingBlockers.filter((blocker) =>
  ['gbrain_unavailable', 'gstack_unavailable'].includes(String(blocker)));

function hasCompletedAcceptance(state) {
  const gates = state.quality_gates || {};
  const completed = new Set(['accepted', 'complete', 'completed', 'done', 'passed', 'ready', 'shipped', 'released']);
  const phase = String(state.phase || '').toLowerCase();
  if (['acceptance', 'release', 'released', 'completed', 'maintenance'].includes(phase)) return true;
  if (completed.has(String(state.status || '').toLowerCase())) return true;
  return ['health', 'browser_qa', 'review', 'security', 'performance', 'deployment']
    .some((key) => completed.has(String(gates[key] || '').toLowerCase()));
}

function isCompletedGate(value) {
  return ['accepted', 'complete', 'completed', 'done', 'passed', 'passing', 'ready', 'released', 'shipped']
    .includes(String(value || '').toLowerCase());
}

let remediationStatus;
if (hardBlockers.length) {
  remediationStatus = 'blocked';
} else if (existingReadiness === 'unknown') {
  remediationStatus = 'partial';
} else if (existingReadiness === 'ready' && remainingBlockers.length === 0 && actions.length === 0 && warningsFromRun.length === 0) {
  remediationStatus = 'not_needed';
} else if (
  remainingBlockers.length ||
  warnings.includes('runtime_missing') ||
  warnings.includes('code_context_status_failed') ||
  warnings.includes('gbrain_seed_failed') ||
  warnings.includes('gbrain_seed_timeout') ||
  warnings.includes('gbrain_project_memory_missing') ||
  warnings.includes('gbrain_project_memory_stale') ||
  warnings.includes('gbrain_project_memory_sync_failed') ||
  warnings.includes('gbrain_core_pages_missing')
) {
  remediationStatus = 'partial';
} else {
  remediationStatus = existingReadiness === 'ready' ? 'fixed' : 'fixed';
}

let nextReadiness = existingReadiness;
if (remediationStatus === 'fixed' && remainingBlockers.length === 0) nextReadiness = 'ready';
if (remediationStatus === 'blocked') nextReadiness = 'blocked';
if (remediationStatus === 'partial' && nextReadiness === 'unknown') nextReadiness = 'partial';

const nextAgent = ['blocked', 'partial'].includes(remediationStatus)
  ? 'Foundation Readiness Agent'
  : 'Orchestrator';
const nextRecipe = ['blocked', 'partial'].includes(remediationStatus)
  ? 'R-1 Foundation Readiness Check'
  : 'R0 Restore / Resume Context';

const nextState = { ...state };
nextState.schema = nextState.schema || 'gstack-harness.project_state.v1';
nextState.generated_at = nextState.generated_at || generatedAt;
nextState.project_id = nextState.project_id || projectId;
nextState.workspace_mode = nextState.workspace_mode || 'target_project';
nextState.template_source = nextState.template_source || process.env.TEMPLATE_SOURCE || '';
nextState.target = nextState.target || target;
nextState.phase = nextState.phase || 'foundation';
nextState.last_completed_agent = hasCompletedAcceptance(state)
  ? state.last_completed_agent || nextState.last_completed_agent || 'Foundation Remediation Agent'
  : 'Foundation Remediation Agent';

nextState.foundation = {
  ...(state.foundation || {}),
  readiness: nextReadiness,
  report: state.foundation?.report || 'docs/FOUNDATION_READINESS_REPORT.md',
  remediation: remediationStatus,
  remediation_report: 'docs/FOUNDATION_REMEDIATION_REPORT.md',
  last_remediation_at: generatedAt,
  remediation_actions: actions,
};
nextState.quality_gates = {
  ...(state.quality_gates || {}),
  foundation_readiness: nextReadiness,
  code_context: state.quality_gates?.code_context || 'missing',
};
const releaseBlockers = Array.isArray(state.release?.blockers) ? state.release.blockers : [];
const existingDeployment = state.quality_gates?.deployment || 'not_started';
if (releaseBlockers.length && !isCompletedGate(existingDeployment)) {
  nextState.quality_gates.deployment = 'blocked';
  nextState.release = {
    ...(state.release || {}),
    status: 'blocked_by_environment',
    blockers: releaseBlockers,
    next_action: state.release?.next_action || 'configure a remote repository and deploy target before release',
  };
}
nextState.artifacts = {
  ...(state.artifacts || {}),
  foundation_readiness_report: 'docs/FOUNDATION_READINESS_REPORT.md',
  foundation_remediation_report: 'docs/FOUNDATION_REMEDIATION_REPORT.md',
  code_context_report: 'docs/CODE_CONTEXT_REPORT.md',
  ai_context_project: '.ai-context/project.json',
  gitnexus_status: '.ai-context/gitnexus-status.json',
  gitnexus_index: '.ai-context/gitnexus-index.md',
  gitnexus_runs: '.ai-context/runs',
  usage_runs: '.gstack/usage-runs',
  agents_status_report: 'docs/AGENTS_STATUS.md',
  agents_status_dir: 'docs/agents',
  agent_status_runner: '.gstack/harness/bin/gstack-harness-agent-status',
};
nextState.blockers = remainingBlockers;
nextState.warnings = warnings;
nextState.next_recommended_agent = nextAgent;
nextState.next_recommended_recipe = nextRecipe;
nextState.problem_handling_required = Boolean(state.problem_handling_required || warnings.length || remainingBlockers.length);

const report = `# Foundation Remediation Report

Generated: ${date}
Project: ${nextState.project_id}
Status: ${remediationStatus}

## Latest Foundation Remediation

\`\`\`yaml
foundation_remediation:
  status: ${remediationStatus}
  source_readiness_report: docs/FOUNDATION_READINESS_REPORT.md
  generated_at: ${generatedAt}
  actions_taken:
${yamlList(actions, (item) => `    - action: ${item.action}
      target: ${item.target}
      evidence: ${item.evidence}`)}
  files_changed:
${yamlList(filesChanged, (item) => `    - path: ${item.path}
      reason: ${item.reason}`)}
  gbrain_pages_seeded: []
  remaining_blockers:
${yamlList(remainingBlockers, (blocker) => `    - id: ${blocker}
      owner: Foundation Remediation Agent
      handoff: manual setup or dedicated gstack skill required`)}
  warnings:
${yamlList(warnings, (warning) => `    - ${warning}`)}
  post_remediation_readiness: ${nextReadiness}
  next_recommended_recipe:
    id: ${nextRecipe}
    reason: ${['blocked', 'partial'].includes(remediationStatus) ? 'rerun readiness with remaining blockers/warnings visible' : 'foundation protocol is ready for orchestration'}
\`\`\`

## Scope

- Remediated only harness-owned protocol, reports, bridge config, usage-run directories, and local runner artifacts.
- Did not modify business source code, gstack skill internals, credentials, deploy settings, or destructive configuration.
`;

if (!dryRun) {
  fs.mkdirSync(path.dirname(statePath), { recursive: true });
  fs.writeFileSync(statePath, JSON.stringify(nextState, null, 2) + '\n');
  fs.mkdirSync(path.dirname(reportPath), { recursive: true });
  fs.writeFileSync(reportPath, report, 'utf8');

  if (fs.existsSync(projectStateMdPath)) {
    let md = fs.readFileSync(projectStateMdPath, 'utf8');
    const preserveLastCompleted = hasCompletedAcceptance(state);
    const replacements = [
      [/^- Last completed agent: .*$/m, preserveLastCompleted ? null : '- Last completed agent: Foundation Remediation Agent'],
      [/^- Next recommended agent: .*$/m, `- Next recommended agent: ${nextAgent}`],
      [/^- Next recommended recipe: .*$/m, `- Next recommended recipe: ${nextRecipe}`],
      [/^- Last updated: .*$/m, `- Last updated: ${date}`],
      [/^- Readiness: .*$/m, `- Readiness: ${nextReadiness}`],
      [/^- Remediation: .*$/m, `- Remediation: ${remediationStatus}`],
      [/^- Foundation Readiness: .*$/m, `- Foundation Readiness: ${nextReadiness}`],
    ];
    for (const [pattern, value] of replacements) {
      if (value === null) continue;
      if (pattern.test(md)) md = md.replace(pattern, value);
    }
    if (!/^- Remediation report: /m.test(md)) {
      md = md.replace(/^- Remediation: .*$/m, `$&\n- Remediation report: docs/FOUNDATION_REMEDIATION_REPORT.md`);
    }
    if (!/^- Foundation remediation report: /m.test(md)) {
      md = md.replace(/^## Artifacts\s*$/m, '## Artifacts\n\n- Foundation remediation report: docs/FOUNDATION_REMEDIATION_REPORT.md');
    }
    fs.writeFileSync(projectStateMdPath, md, 'utf8');
  }
}

fs.writeFileSync(process.env.META_FILE, JSON.stringify({
  status: remediationStatus,
  readiness: nextReadiness,
  next_agent: nextAgent,
  next_recipe: nextRecipe,
  blockers: remainingBlockers,
  warnings,
}, null, 2) + '\n');
NODE

REMEDIATION_STATUS="$(json_field "$META_FILE" "state.status" "unknown")"

if [ "$DRY_RUN" -ne 1 ]; then
  if [ -x "$TARGET_DIR/.gstack/harness/bin/gstack-harness-readiness" ]; then
    timeout 45s "$TARGET_DIR/.gstack/harness/bin/gstack-harness-readiness" --target "$TARGET_DIR" > "$TARGET_DIR/.gstack/readiness-last.json" || true
  fi
  if [ -x "$TARGET_DIR/.gstack/harness/bin/gstack-harness-agent-status" ]; then
    "$TARGET_DIR/.gstack/harness/bin/gstack-harness-agent-status" --target "$TARGET_DIR" --event foundation_remediation >/dev/null 2>&1 || true
  fi
  RECORDER="$TARGET_DIR/.gstack/harness/bin/gstack-harness-record-run"
  if [ -x "$RECORDER" ]; then
    RECORD_ARGS=(
      --target "$TARGET_DIR"
      --event "foundation_remediation"
      --status "$REMEDIATION_STATUS"
      --agent "Foundation Remediation Agent"
      --recipe "R-0.5 Foundation Remediation"
      --intent "repair harness foundation gaps"
      --artifact "docs/FOUNDATION_REMEDIATION_REPORT.md"
      --artifact "docs/FOUNDATION_READINESS_REPORT.md"
      --artifact "docs/CODE_CONTEXT_REPORT.md"
      --artifact ".ai-context/project.json"
      --artifact ".ai-context/gitnexus-status.json"
    )
    while IFS= read -r warning; do
      [ -n "$warning" ] && RECORD_ARGS+=(--warning "$warning")
    done < "$WARNINGS_FILE"
    "$RECORDER" "${RECORD_ARGS[@]}" >/dev/null 2>&1 || record_warning "usage_record_failed"
  fi
fi

log "Foundation remediation status: $REMEDIATION_STATUS"
log "Report: docs/FOUNDATION_REMEDIATION_REPORT.md"
