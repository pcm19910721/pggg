#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
gstack-harness-readiness - diagnose GStack Harness foundation readiness

Usage:
  gstack-harness-readiness [--target DIR] [--mode auto|app|docs-only] [--dry-run] [--skip-code-context] [--json]

This command is read-only with respect to business code. It updates only harness
state and reports: PROJECT_STATE.md, .gstack/project-state.json,
docs/FOUNDATION_READINESS_REPORT.md, and Code Context artifacts.
EOF
}

TARGET="."
MODE="auto"
DRY_RUN=0
SKIP_CODE_CONTEXT=0
PRINT_JSON=0

while [ "$#" -gt 0 ]; do
  case "$1" in
    --target)
      TARGET="${2:-}"
      shift 2
      ;;
    --mode)
      MODE="${2:-}"
      shift 2
      ;;
    --dry-run)
      DRY_RUN=1
      shift
      ;;
    --skip-code-context)
      SKIP_CODE_CONTEXT=1
      shift
      ;;
    --json)
      PRINT_JSON=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "ERROR: unknown argument: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

case "$MODE" in
  auto|app|docs-only) ;;
  *)
    echo "ERROR: --mode must be auto, app, or docs-only" >&2
    exit 2
    ;;
esac

if ! command -v node >/dev/null 2>&1; then
  echo "ERROR: node is required for readiness state updates" >&2
  exit 2
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TARGET_DIR="$(mkdir -p "$TARGET" && cd "$TARGET" && pwd)"
DATE="$(date +%Y-%m-%d)"
GENERATED_AT="$(date -Iseconds)"
TMP_DIR="$(mktemp -d "${TMPDIR:-/tmp}/gstack-readiness-XXXXXX")"
trap 'rm -rf "$TMP_DIR"' EXIT

detect_gbrain_bin() {
  if command -v gbrain >/dev/null 2>&1; then
    command -v gbrain
    return 0
  fi
  if [ -x "$HOME/.bun/bin/gbrain" ]; then
    printf '%s\n' "$HOME/.bun/bin/gbrain"
    return 0
  fi
  return 1
}

detect_bun_bin() {
  if command -v bun >/dev/null 2>&1; then
    command -v bun
    return 0
  fi
  for candidate in \
    "${BUN_INSTALL:-}/bin/bun" \
    "$HOME/.bun/bin/bun" \
    "/usr/local/bin/bun" \
    "/opt/homebrew/bin/bun" \
    "/usr/bin/bun"
  do
    if [ -n "$candidate" ] && [ -x "$candidate" ]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  return 1
}

activate_gbrain_path() {
  local gbrain_bin="$1"
  local bun_bin=""
  PATH="$(dirname "$gbrain_bin"):$PATH"
  if bun_bin="$(detect_bun_bin 2>/dev/null)"; then
    PATH="$(dirname "$bun_bin"):$PATH"
  fi
}

STATE_PATH="$TARGET_DIR/.gstack/project-state.json"
PROJECT_ID="$(node -e '
const fs = require("fs");
const path = require("path");
const file = process.argv[1];
const target = process.argv[2];
function slug(value) {
  return String(value || "project").toLowerCase().replace(/[^a-z0-9._-]+/g, "-").replace(/-+$/g, "") || "project";
}
try {
  const state = JSON.parse(fs.readFileSync(file, "utf8"));
  process.stdout.write(state.project_id || slug(path.basename(target)));
} catch {
  process.stdout.write(slug(path.basename(target)));
}
' "$STATE_PATH" "$TARGET_DIR")"

GSTACK_ROOT=""
detect_gstack_root() {
  for root in \
    "$HOME/.claude/skills/gstack" \
    "$HOME/.codex-gstack/skills/gstack" \
    "$HOME/.codex/skills/gstack" \
    "$HOME/.claude/skills/gstack/.agents/skills/gstack"
  do
    if [ -d "$root" ] && [ -f "$root/SKILL.md" ]; then
      printf '%s\n' "$root"
      return 0
    fi
  done
  return 1
}

GSTACK_STATUS="unavailable"
GSTACK_SKILLS="0"
BROWSE_STATUS="missing_browser"
DESIGN_STATUS="missing"
GBRAIN_SYNC_MODE="unknown"
if GSTACK_ROOT="$(detect_gstack_root 2>/dev/null)"; then
  GSTACK_STATUS="ready"
  GSTACK_SKILLS="$(find "$GSTACK_ROOT" -maxdepth 2 -name SKILL.md 2>/dev/null | wc -l | tr -d ' ')"
  [ -x "$GSTACK_ROOT/browse/dist/browse" ] && BROWSE_STATUS="ready"
  [ -x "$GSTACK_ROOT/design/dist/design" ] && DESIGN_STATUS="ready"
  if [ -x "$GSTACK_ROOT/bin/gstack-config" ]; then
    GBRAIN_SYNC_MODE="$("$GSTACK_ROOT/bin/gstack-config" get gbrain_sync_mode 2>/dev/null || echo unknown)"
  fi
fi

GIT_STATUS="missing"
BRANCH="none"
if git -C "$TARGET_DIR" rev-parse --show-toplevel >/dev/null 2>&1; then
  GIT_STATUS="ready"
  BRANCH="$(git -C "$TARGET_DIR" branch --show-current 2>/dev/null || true)"
  BRANCH="${BRANCH:-unknown}"
fi

GBRAIN_STATUS="unavailable"
GBRAIN_PAGES="0"
GBRAIN_QUERY_STATUS="not_run"
GBRAIN_QUERY_EVIDENCE="gbrain unavailable"
GBRAIN_CORE_PRESENT="0"
GBRAIN_CORE_MISSING=""
GBRAIN_MEMORY_MISSING=""
GBRAIN_MEMORY_STALE=""
GBRAIN_BIN=""
if GBRAIN_BIN="$(detect_gbrain_bin 2>/dev/null)"; then
  activate_gbrain_path "$GBRAIN_BIN"
fi
if [ -n "$GBRAIN_BIN" ] && "$GBRAIN_BIN" --version >/dev/null 2>&1; then
  GBRAIN_STATUS="empty"
  if GBRAIN_LIST_OUTPUT="$(timeout 6s "$GBRAIN_BIN" list 2>&1)"; then
    if [ -n "$GBRAIN_LIST_OUTPUT" ]; then
      GBRAIN_PAGES="$(printf '%s\n' "$GBRAIN_LIST_OUTPUT" | wc -l | tr -d ' ')"
    else
      GBRAIN_PAGES="0"
    fi
  else
    GBRAIN_PAGES="unknown"
    GBRAIN_STATUS="empty"
  fi

  GBRAIN_CORE_PRESENT="1"
  for core_slug in \
    "project/$PROJECT_ID/overview" \
    "project/$PROJECT_ID/state" \
    "project/$PROJECT_ID/foundation-readiness" \
    "project/$PROJECT_ID/code-context" \
    "project/$PROJECT_ID/quality-gates"
  do
    if ! timeout 8s "$GBRAIN_BIN" get "$core_slug" >/dev/null 2>&1; then
      GBRAIN_CORE_PRESENT="0"
      GBRAIN_CORE_MISSING="${GBRAIN_CORE_MISSING}${GBRAIN_CORE_MISSING:+,}$core_slug"
    fi
  done
  CODE_CONTEXT_INDEXED_COMMIT="$(node -e '
const fs = require("fs");
try {
  const s = JSON.parse(fs.readFileSync(process.argv[1], "utf8"));
  process.stdout.write(s.last_commit || "");
} catch {}
' "$TARGET_DIR/.ai-context/gitnexus-status.json" 2>/dev/null || true)"
  for memory_slug in \
    "project/$PROJECT_ID/gitnexus-index" \
    "project/$PROJECT_ID/architecture" \
    "project/$PROJECT_ID/hotspots" \
    "project/$PROJECT_ID/handoff"
  do
    if MEMORY_PAGE="$(timeout 8s "$GBRAIN_BIN" get "$memory_slug" 2>/dev/null)"; then
      if [ -n "$CODE_CONTEXT_INDEXED_COMMIT" ] && [ -n "$MEMORY_PAGE" ] && [ "$memory_slug" = "project/$PROJECT_ID/gitnexus-index" ] && printf '%s\n' "$MEMORY_PAGE" | grep -Fq "type: gitnexus_index"; then
        if ! printf '%s\n' "$MEMORY_PAGE" | grep -Fq "$CODE_CONTEXT_INDEXED_COMMIT"; then
          GBRAIN_MEMORY_STALE="${GBRAIN_MEMORY_STALE}${GBRAIN_MEMORY_STALE:+,}$memory_slug"
        fi
      fi
    else
      GBRAIN_MEMORY_MISSING="${GBRAIN_MEMORY_MISSING}${GBRAIN_MEMORY_MISSING:+,}$memory_slug"
    fi
  done
  if [ "$GBRAIN_PAGES" != "0" ] && [ "$GBRAIN_PAGES" != "unknown" ] && [ "$GBRAIN_CORE_PRESENT" = "1" ]; then
    GBRAIN_STATUS="ready"
  fi

  if GBRAIN_QUERY_OUTPUT="$(timeout 20s "$GBRAIN_BIN" query "gbrain healthcheck project memory" --no-expand --limit 1 2>&1)"; then
    if [ "$GBRAIN_STATUS" = "ready" ]; then
      GBRAIN_QUERY_STATUS="ready"
      GBRAIN_QUERY_EVIDENCE="health query completed"
    else
      GBRAIN_QUERY_STATUS="empty"
      GBRAIN_QUERY_EVIDENCE="health query completed but core project pages are missing"
    fi
  else
    GBRAIN_QUERY_RC="$?"
    if [ "$GBRAIN_QUERY_RC" -eq 124 ]; then
      GBRAIN_QUERY_STATUS="timeout"
      GBRAIN_QUERY_EVIDENCE="query timed out; possible PGLite lock"
    else
      GBRAIN_QUERY_STATUS="failed"
      GBRAIN_QUERY_EVIDENCE="query failed with exit code $GBRAIN_QUERY_RC"
    fi
  fi
fi

CODE_CONTEXT_STATUS="missing"
if [ "$SKIP_CODE_CONTEXT" -ne 1 ] && [ "$DRY_RUN" -ne 1 ] && [ -f "$TARGET_DIR/scripts/ai-context-bridge.mjs" ] && [ -f "$TARGET_DIR/.ai-context/project.json" ]; then
  (cd "$TARGET_DIR" && node scripts/ai-context-bridge.mjs status > "$TMP_DIR/code-context-status.out" 2> "$TMP_DIR/code-context-status.err") || true
fi

TARGET_DIR="$TARGET_DIR" \
PROJECT_ID="$PROJECT_ID" \
MODE="$MODE" \
DATE="$DATE" \
GENERATED_AT="$GENERATED_AT" \
DRY_RUN="$DRY_RUN" \
GSTACK_STATUS="$GSTACK_STATUS" \
GSTACK_ROOT="$GSTACK_ROOT" \
GSTACK_SKILLS="$GSTACK_SKILLS" \
BROWSE_STATUS="$BROWSE_STATUS" \
DESIGN_STATUS="$DESIGN_STATUS" \
GBRAIN_SYNC_MODE="$GBRAIN_SYNC_MODE" \
GIT_STATUS="$GIT_STATUS" \
BRANCH="$BRANCH" \
GBRAIN_STATUS="$GBRAIN_STATUS" \
GBRAIN_PAGES="$GBRAIN_PAGES" \
GBRAIN_CORE_MISSING="$GBRAIN_CORE_MISSING" \
GBRAIN_MEMORY_MISSING="$GBRAIN_MEMORY_MISSING" \
GBRAIN_MEMORY_STALE="$GBRAIN_MEMORY_STALE" \
GBRAIN_QUERY_STATUS="$GBRAIN_QUERY_STATUS" \
GBRAIN_QUERY_EVIDENCE="$GBRAIN_QUERY_EVIDENCE" \
GIT_REMOTE_URL="$(git -C "$TARGET_DIR" config --get remote.origin.url 2>/dev/null || true)" \
node <<'NODE'
const fs = require('fs');
const path = require('path');

const env = process.env;
const target = env.TARGET_DIR;
const statePath = path.join(target, '.gstack/project-state.json');
const projectStatePath = path.join(target, 'PROJECT_STATE.md');
const readinessReportPath = path.join(target, 'docs/FOUNDATION_READINESS_REPORT.md');
const readinessLastPath = path.join(target, '.gstack/readiness-last.json');

function readJson(file, fallback = {}) {
  try {
    return JSON.parse(fs.readFileSync(file, 'utf8'));
  } catch {
    return fallback;
  }
}

function writeJson(file, value) {
  fs.mkdirSync(path.dirname(file), { recursive: true });
  fs.writeFileSync(file, JSON.stringify(value, null, 2) + '\n');
}

function findRuntimeRoot() {
  const manifestFiles = ['package.json', 'pyproject.toml', 'go.mod', 'Cargo.toml', 'Makefile'];
  const candidateDirs = ['', 'backend', 'frontend', 'app', 'api', 'server', 'web'];
  for (const rel of candidateDirs) {
    const dir = path.join(target, rel);
    if (!fs.existsSync(dir)) continue;
    for (const file of manifestFiles) {
      if (fs.existsSync(path.join(dir, file))) return { dir, rel };
    }
  }
  return null;
}

function commandPrefix(runtimeRoot) {
  return runtimeRoot?.rel ? `cd ${runtimeRoot.rel} && ` : '';
}

function detectMode(mode) {
  if (mode !== 'auto') return mode;
  return findRuntimeRoot() ? 'app' : 'docs-only';
}

function detectRuntime(mode) {
  const runtime = {
    install: '',
    dev: '',
    test: '',
    lint: '',
    typecheck: '',
    local_url: '',
    production_url: '',
  };
  if (mode === 'docs-only') {
    return {
      ...runtime,
      install: 'not_required',
      dev: 'not_required',
      test: 'not_required',
      lint: 'not_required',
      typecheck: 'not_required',
      local_url: 'not_required',
      production_url: 'not_required',
      status: 'not_required',
    };
  }

  const runtimeRoot = findRuntimeRoot() || { dir: target, rel: '' };
  const root = runtimeRoot.dir;
  const prefix = commandPrefix(runtimeRoot);
  const pkgPath = path.join(root, 'package.json');
  if (fs.existsSync(pkgPath)) {
    const pkg = readJson(pkgPath, {});
    const scripts = pkg.scripts || {};
    let runner = 'npm run';
    runtime.install = `${prefix}npm install`;
    if (fs.existsSync(path.join(root, 'pnpm-lock.yaml'))) {
      runner = 'pnpm';
      runtime.install = `${prefix}pnpm install`;
    } else if (fs.existsSync(path.join(root, 'yarn.lock'))) {
      runner = 'yarn';
      runtime.install = `${prefix}yarn install`;
    } else if (fs.existsSync(path.join(root, 'bun.lock')) || fs.existsSync(path.join(root, 'bun.lockb'))) {
      runner = 'bun run';
      runtime.install = `${prefix}bun install`;
    }
    if (scripts.dev) runtime.dev = `${prefix}${runner} dev`;
    if (scripts.test) runtime.test = prefix
      ? `${prefix}${runner === 'npm run' ? 'npm test' : `${runner} test`}`
      : (runner === 'npm run' ? 'npm test' : `${runner} test`);
    if (scripts.lint) runtime.lint = `${prefix}${runner} lint`;
    if (scripts.typecheck) runtime.typecheck = `${prefix}${runner} typecheck`;
  } else if (fs.existsSync(path.join(root, 'pyproject.toml'))) {
    const pyproject = fs.readFileSync(path.join(root, 'pyproject.toml'), 'utf8');
    runtime.install = pyproject.includes('[project.optional-dependencies]') && pyproject.includes('dev =')
      ? `${prefix}pip install -e '.[dev]'`
      : `${prefix}pip install -e .`;
    if (fs.existsSync(path.join(root, 'app', 'main.py')) && pyproject.includes('fastapi')) {
      runtime.dev = `${prefix}uvicorn app.main:app --reload`;
    }
    runtime.test = `${prefix}pytest`;
  } else if (fs.existsSync(path.join(root, 'go.mod'))) {
    runtime.test = `${prefix}go test ./...`;
  } else if (fs.existsSync(path.join(root, 'Cargo.toml'))) {
    runtime.test = `${prefix}cargo test`;
  } else if (fs.existsSync(path.join(root, 'Makefile'))) {
    runtime.install = `${prefix}make install`;
    runtime.test = `${prefix}make test`;
  }

  runtime.status = Object.values(runtime).some(Boolean) ? 'ready' : 'missing_commands';
  return runtime;
}

function readCodeContextStatus(state) {
  const statusPath = path.join(target, '.ai-context/gitnexus-status.json');
  const reportPath = path.join(target, 'docs/CODE_CONTEXT_REPORT.md');
  const status = readJson(statusPath, null);
  if (status?.stale) return 'stale';
  if (status?.indexed) return 'ready';
  if (fs.existsSync(reportPath)) {
    const match = fs.readFileSync(reportPath, 'utf8').match(/^Status:\s*(\S+)/m);
    if (match) return match[1];
  }
  return state.quality_gates?.code_context || 'missing';
}

function unique(items) {
  return Array.from(new Set(items.filter(Boolean)));
}

function withoutReadinessWarnings(items) {
  const readinessWarnings = new Set([
    'gbrain_unavailable',
    'gbrain_empty',
    'gbrain_core_pages_missing',
    'gbrain_query_timeout',
    'gbrain_query_failed',
    'gbrain_sync_off',
    'runtime_missing',
    'not_git_repo',
    'browse_missing',
    'code_context_status_failed',
    'gbrain_seed_failed',
    'gbrain_seed_timeout',
    'gbrain_project_memory_missing',
    'gbrain_project_memory_stale',
  ]);
  return items.filter((item) => !readinessWarnings.has(String(item)));
}

function mdList(items) {
  return items.length ? items.map((item) => `- ${item}`).join('\n') : 'None';
}

function replaceOrAppend(content, pattern, line, section) {
  if (pattern.test(content)) return content.replace(pattern, line);
  if (section && content.includes(section)) return content.replace(section, `${section}\n${line}`);
  return `${content.trimEnd()}\n${line}\n`;
}

const state = readJson(statePath, {});
const mode = detectMode(env.MODE || 'auto');
const runtime = detectRuntime(mode);
const blockers = [];
const warnings = [];

if (env.GBRAIN_STATUS === 'unavailable') blockers.push('gbrain_unavailable');
if (env.GBRAIN_STATUS === 'empty') warnings.push('gbrain_empty');
if (env.GBRAIN_CORE_MISSING) warnings.push('gbrain_core_pages_missing');
if (env.GBRAIN_MEMORY_MISSING) warnings.push('gbrain_project_memory_missing');
if (env.GBRAIN_MEMORY_STALE) warnings.push('gbrain_project_memory_stale');
if (env.GBRAIN_QUERY_STATUS === 'timeout') warnings.push('gbrain_query_timeout');
if (env.GBRAIN_QUERY_STATUS === 'failed') warnings.push('gbrain_query_failed');
if (env.GBRAIN_SYNC_MODE === 'off') warnings.push('gbrain_sync_off');
if (env.GSTACK_STATUS !== 'ready') blockers.push('gstack_unavailable');
if (runtime.status === 'missing_commands' && mode === 'app') warnings.push('runtime_missing');
if (env.GIT_STATUS !== 'ready' && mode === 'app') warnings.push('not_git_repo');
if (env.BROWSE_STATUS !== 'ready') warnings.push('browse_missing');

const codeContextStatus = readCodeContextStatus(state);
let verdict = 'ready';
if (blockers.length) verdict = 'blocked';
else if (
  warnings.includes('gbrain_empty') ||
  warnings.includes('gbrain_project_memory_missing') ||
  warnings.includes('gbrain_project_memory_stale') ||
  warnings.includes('runtime_missing') ||
  warnings.includes('not_git_repo')
) verdict = 'partial';

let nextAgent = 'Orchestrator';
let nextRecipe = 'R0 Restore / Resume Context';
const remediableWarnings = new Set([
  'gbrain_empty',
  'gbrain_core_pages_missing',
  'gbrain_project_memory_missing',
  'gbrain_project_memory_stale',
  'runtime_missing',
  'browse_missing',
]);
const needsFoundationRemediation = verdict === 'blocked' || warnings.some((warning) => remediableWarnings.has(warning));
if (needsFoundationRemediation) {
  nextAgent = 'Foundation Remediation Agent';
  nextRecipe = 'R-0.5 Foundation Remediation';
} else if (verdict !== 'ready') {
  nextAgent = 'Problem Handling Agent';
  nextRecipe = 'Problem Handling preflight, then R0 Restore / Resume Context';
} else if (warnings.includes('gbrain_query_timeout') || warnings.includes('gbrain_query_failed')) {
  nextAgent = 'Problem Handling Agent';
  nextRecipe = 'Problem Handling preflight, then R0 Restore / Resume Context';
}

const nextState = { ...state };
nextState.schema = nextState.schema || 'gstack-harness.project_state.v1';
nextState.generated_at = nextState.generated_at || env.GENERATED_AT;
nextState.project_id = nextState.project_id || env.PROJECT_ID;
nextState.workspace_mode = nextState.workspace_mode || 'target_project';
nextState.target = nextState.target || target;
nextState.phase = nextState.phase || 'foundation';
nextState.foundation = {
  ...(state.foundation || {}),
  readiness: verdict,
  report: 'docs/FOUNDATION_READINESS_REPORT.md',
  remediation: state.foundation?.remediation || 'not_needed',
  remediation_report: 'docs/FOUNDATION_REMEDIATION_REPORT.md',
  gbrain: env.GBRAIN_STATUS,
  gbrain_pages: env.GBRAIN_PAGES,
  gbrain_project_memory_missing: env.GBRAIN_MEMORY_MISSING ? env.GBRAIN_MEMORY_MISSING.split(',') : [],
  gbrain_project_memory_stale: env.GBRAIN_MEMORY_STALE ? env.GBRAIN_MEMORY_STALE.split(',') : [],
  gbrain_query: env.GBRAIN_QUERY_STATUS,
  gstack: env.GSTACK_STATUS,
  project_protocol: 'ready',
  runtime: runtime.status,
  runners: env.BROWSE_STATUS,
  memory_policy: env.GBRAIN_STATUS === 'ready' ? 'ready' : env.GBRAIN_STATUS,
  last_readiness_check: env.GENERATED_AT,
  problem_handling_required: ['timeout', 'failed'].includes(env.GBRAIN_QUERY_STATUS),
};
function mergeRuntimeValue(nextValue, previousValue) {
  const hasPrevious = previousValue !== undefined && previousValue !== null && previousValue !== '';
  if (hasPrevious && (nextValue === undefined || nextValue === null || nextValue === '' || nextValue === 'not_required')) {
    return previousValue;
  }
  return nextValue || '';
}

function isCompletedGate(value) {
  return ['accepted', 'complete', 'completed', 'done', 'passed', 'passing', 'ready', 'released', 'shipped']
    .includes(String(value || '').toLowerCase());
}

nextState.runtime = {
  ...(state.runtime || {}),
  install: mergeRuntimeValue(runtime.install, state.runtime?.install),
  dev: mergeRuntimeValue(runtime.dev, state.runtime?.dev),
  test: mergeRuntimeValue(runtime.test, state.runtime?.test),
  lint: mergeRuntimeValue(runtime.lint, state.runtime?.lint),
  typecheck: mergeRuntimeValue(runtime.typecheck, state.runtime?.typecheck),
  local_url: mergeRuntimeValue(runtime.local_url, state.runtime?.local_url),
  production_url: mergeRuntimeValue(runtime.production_url, state.runtime?.production_url),
};
const releaseBlockers = [];
const remoteUrl = env.GIT_REMOTE_URL || state.release?.remote_url || '';
if (!remoteUrl) releaseBlockers.push('no_remote_repository');
if (!nextState.runtime.production_url || nextState.runtime.production_url === 'not_required') releaseBlockers.push('no_deploy_target');
const existingDeployment = state.quality_gates?.deployment || 'not_started';
const deploymentGate = releaseBlockers.length && !isCompletedGate(existingDeployment) ? 'blocked' : existingDeployment;
nextState.release = {
  ...(state.release || {}),
  status: releaseBlockers.length && !isCompletedGate(existingDeployment)
    ? 'blocked_by_environment'
    : (isCompletedGate(existingDeployment) ? 'completed' : state.release?.status || 'not_started'),
  blockers: releaseBlockers,
  remote_url: remoteUrl,
  production_url: nextState.runtime.production_url || '',
  next_action: releaseBlockers.length
    ? 'configure a remote repository and deploy target before release'
    : state.release?.next_action || 'none',
};
nextState.quality_gates = {
  ...(state.quality_gates || {}),
  foundation_readiness: verdict,
  code_context: codeContextStatus,
  deployment: deploymentGate,
};
nextState.artifacts = {
  ...(state.artifacts || {}),
  foundation_readiness_report: 'docs/FOUNDATION_READINESS_REPORT.md',
  foundation_remediation_report: 'docs/FOUNDATION_REMEDIATION_REPORT.md',
  code_context_report: 'docs/CODE_CONTEXT_REPORT.md',
  ai_context_project: '.ai-context/project.json',
  gitnexus_status: '.ai-context/gitnexus-status.json',
  gitnexus_index: '.ai-context/gitnexus-index.md',
  gitnexus_runs: '.ai-context/runs',
  usage_runs: '.gstack/usage-runs',
  agents_status_report: 'docs/AGENTS_STATUS.md',
  agents_status_dir: 'docs/agents',
  agent_status_runner: '.gstack/harness/bin/gstack-harness-agent-status',
};
nextState.blockers = unique([...blockers]);
nextState.warnings = unique([
  ...withoutReadinessWarnings(Array.isArray(state.warnings) ? state.warnings : []),
  ...warnings,
]);
nextState.problem_handling_required = Boolean(nextState.foundation.problem_handling_required || nextState.blockers.length);
nextState.next_recommended_agent = nextAgent;
nextState.next_recommended_recipe = nextRecipe;

const report = `# Foundation Readiness Report

Generated: ${env.DATE}
Project: ${nextState.project_id}
Workspace mode: target_project
Install mode: ${mode}
Verdict: ${verdict}

## Capability Sources

| Area | Status | Evidence |
|---|---|---|
| gbrain | ${env.GBRAIN_STATUS} | pages visible: ${env.GBRAIN_PAGES}; core missing: ${env.GBRAIN_CORE_MISSING || 'none'} |
| gbrain project memory | ${env.GBRAIN_MEMORY_MISSING || env.GBRAIN_MEMORY_STALE ? 'partial' : env.GBRAIN_STATUS} | missing: ${env.GBRAIN_MEMORY_MISSING || 'none'}; stale: ${env.GBRAIN_MEMORY_STALE || 'none'} |
| gbrain query | ${env.GBRAIN_QUERY_STATUS} | ${env.GBRAIN_QUERY_EVIDENCE} |
| gstack | ${env.GSTACK_STATUS} | root: ${env.GSTACK_ROOT || 'not_found'}; skills: ${env.GSTACK_SKILLS} |
| gstack browse | ${env.BROWSE_STATUS} | ${env.GSTACK_ROOT || 'not_found'}/browse/dist/browse |
| gstack design | ${env.DESIGN_STATUS} | ${env.GSTACK_ROOT || 'not_found'}/design/dist/design |
| gstack memory sync | ${env.GBRAIN_SYNC_MODE} | gstack-config gbrain_sync_mode |
| project protocol | ready | harness state and reports present |
| git state | ${env.GIT_STATUS} | branch: ${env.BRANCH} |
| runtime | ${runtime.status} | mode: ${mode}; test: ${runtime.test || ''}; dev: ${runtime.dev || ''} |
| code context | ${codeContextStatus} | docs/CODE_CONTEXT_REPORT.md / .ai-context/gitnexus-status.json |

## Blockers

${mdList(nextState.blockers)}

## Warnings

${mdList(nextState.warnings)}

## Next Recommended Action

Recipe: ${nextRecipe}

Agent: ${nextAgent}
`;

if (!env.DRY_RUN || env.DRY_RUN !== '1') {
  writeJson(statePath, nextState);
  fs.mkdirSync(path.dirname(readinessReportPath), { recursive: true });
  fs.writeFileSync(readinessReportPath, report, 'utf8');
  if (fs.existsSync(projectStatePath)) {
    let md = fs.readFileSync(projectStatePath, 'utf8');
    md = replaceOrAppend(md, /^- Readiness: .*$/m, `- Readiness: ${verdict}`, '## Foundation');
    md = replaceOrAppend(md, /^- Last readiness check: .*$/m, '- Last readiness check: docs/FOUNDATION_READINESS_REPORT.md', '## Foundation');
    md = replaceOrAppend(md, /^- gbrain: .*$/m, `- gbrain: ${env.GBRAIN_STATUS}`, '## Foundation');
    md = replaceOrAppend(md, /^- gbrain query: .*$/m, `- gbrain query: ${env.GBRAIN_QUERY_STATUS}`, '## Foundation');
    md = replaceOrAppend(md, /^- Runtime: .*$/m, `- Runtime: ${runtime.status}`, '## Foundation');
    md = replaceOrAppend(md, /^- Runners: .*$/m, `- Runners: ${env.BROWSE_STATUS}`, '## Foundation');
    md = replaceOrAppend(md, /^- Foundation Readiness: .*$/m, `- Foundation Readiness: ${verdict}`, '## Quality Gates');
    md = replaceOrAppend(md, /^- Code Context: .*$/m, `- Code Context: ${codeContextStatus}`, '## Quality Gates');
    md = replaceOrAppend(md, /^- Next recommended agent: .*$/m, `- Next recommended agent: ${nextAgent}`, '## Current');
    md = replaceOrAppend(md, /^- Next recommended recipe: .*$/m, `- Next recommended recipe: ${nextRecipe}`, '## Current');
    md = replaceOrAppend(md, /^- Last updated: .*$/m, `- Last updated: ${env.DATE}`, '## Current');
    fs.writeFileSync(projectStatePath, md, 'utf8');
  }
}

const summary = {
  status: verdict,
  project_id: nextState.project_id,
  target,
  mode,
  gbrain: env.GBRAIN_STATUS,
  gbrain_core_missing: env.GBRAIN_CORE_MISSING ? env.GBRAIN_CORE_MISSING.split(',') : [],
  gbrain_project_memory_missing: env.GBRAIN_MEMORY_MISSING ? env.GBRAIN_MEMORY_MISSING.split(',') : [],
  gbrain_project_memory_stale: env.GBRAIN_MEMORY_STALE ? env.GBRAIN_MEMORY_STALE.split(',') : [],
  gbrain_query: env.GBRAIN_QUERY_STATUS,
  gstack: env.GSTACK_STATUS,
  git: env.GIT_STATUS,
  runtime: runtime.status,
  code_context: codeContextStatus,
  blockers: nextState.blockers,
  warnings: nextState.warnings,
  next_recommended_agent: nextAgent,
  next_recommended_recipe: nextRecipe,
};

if (!env.DRY_RUN || env.DRY_RUN !== '1') {
  writeJson(readinessLastPath, summary);
}

process.stdout.write(JSON.stringify(summary, null, 2) + '\n');
process.exitCode = verdict === 'blocked' ? 1 : 0;
NODE

if [ "$DRY_RUN" -ne 1 ] && [ -x "$TARGET_DIR/.gstack/harness/bin/gstack-harness-agent-status" ]; then
  "$TARGET_DIR/.gstack/harness/bin/gstack-harness-agent-status" --target "$TARGET_DIR" --event foundation_readiness >/dev/null 2>&1 || true
fi
