  RELEASE_NEXT_ACTION="none"
elif [ "$EXISTING_DEPLOYMENT_GATE" = "blocked" ]; then
  RELEASE_STATUS="blocked_by_environment"
  DEPLOYMENT_GATE="blocked"
fi

