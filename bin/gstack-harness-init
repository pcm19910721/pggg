  "usage_run": "$(json_escape "$USAGE_RUN_PATH")",
  "usage_runs": ".gstack/usage-runs",
  "usage_report_timer": ".gstack/harness/bin/gstack-harness-enable-report-timer",
  "problem_handling_required": $([ "$PROBLEM_HANDLING_REQUIRED" -eq 1 ] && printf 'true' || printf 'false'),
  "codex_start_prompt": "docs/CODEX_START_PROMPT.md",
  "start_codex": $([ "$START_CODEX" -eq 1 ] && printf 'true' || printf 'false'),
  "next_recommended_agent": "$(json_escape "$NEXT_AGENT")"
}
EOF
)"

log "$SUMMARY_JSON"
if [ "$DRY_RUN" -ne 1 ]; then
  write_file ".gstack/install-summary.json" "$SUMMARY_JSON"
fi
say "Install summary"
say "- Status: $FOUNDATION_VERDICT"
say "- Project: $PROJECT_ID"
say "- Mode: $EFFECTIVE_MODE"
say "- Git: $GIT_STATUS"
say "- Runtime: $RUNTIME_STATUS"
say "- Next: $NEXT_AGENT"
say "- Preflight: .gstack/install-preflight.json"
say "- Details: .gstack/install-log.txt"
if [ "$DRY_RUN" -eq 1 ]; then
  say "DRY_RUN summary only; detailed planned writes are in .gstack/install-log.txt"
fi

if [ "$START_CODEX" -eq 1 ]; then
  if [ "$DRY_RUN" -eq 1 ]; then
    log "DRY_RUN start codex -C \"$TARGET_DIR\" \"$(printf '%s' "$CODEX_START_PROMPT" | head -c 80)...\""
  elif ! command -v codex >/dev/null 2>&1; then
    log "warning: Codex start requested but codex was not found on PATH"
  else
    log "starting Codex in $TARGET_DIR"
    record_usage_run "codex_session_start" "in_progress" "codex orchestration session"
    set +e
    codex -C "$TARGET_DIR" --no-alt-screen "$CODEX_START_PROMPT"
    CODEX_RC="$?"
    set -e
    if [ "$CODEX_RC" -eq 0 ]; then
      record_usage_run "codex_session_end" "completed" "codex orchestration session exited"
    else
      record_usage_run "codex_session_end" "failed" "codex orchestration session exited with non-zero status"
    fi
    exit "$CODEX_RC"
  fi
fi

if [ "$FOUNDATION_VERDICT" = "blocked" ]; then
  exit 1
fi
