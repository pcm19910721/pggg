EXISTING_MARKDOWN_EVIDENCE_JSON='{}'
if [ -f "$TARGET_DIR/PROJECT_STATE.md" ] && command -v node >/dev/null 2>&1; then
  EXISTING_MARKDOWN_EVIDENCE_JSON="$(node - "$TARGET_DIR/PROJECT_STATE.md" <<'NODE'
const fs = require('fs');
const file = process.argv[2];
let text = '';
try {
  text = fs.readFileSync(file, 'utf8');
} catch {}

function lineValue(label) {
  const escaped = label.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  const match = text.match(new RegExp(`^- ${escaped}:[ \\t]*(.*)$`, 'm'));
  return match ? match[1].trim() : '';
}

function evidenceValue(section, label) {
  const evidenceStart = text.indexOf('## Gate Evidence');
  const evidenceText = evidenceStart === -1 ? text : text.slice(evidenceStart);
  const start = evidenceText.indexOf(`- ${section}:`);
  if (start === -1) return '';
  const rest = evidenceText.slice(start);
  const end = rest.slice(1).search(/\n- [^:\n]+:\s*$/m);
  const block = end === -1 ? rest : rest.slice(0, end + 1);
  const escaped = label.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  const match = block.match(new RegExp(`^[ \\t]+- ${escaped}:[ \\t]*(.*)$`, 'm'));
  return match ? match[1].trim() : '';
}

const artifacts = {};
const artifactLabels = {
  qa_report: 'QA report',
  review_report: 'Review report',
  security_report: 'Security report',
  performance_report: 'Performance report',
  release_status: 'Release status',
};
for (const [key, label] of Object.entries(artifactLabels)) {
  const value = lineValue(label);
  if (value) artifacts[key] = value;
}

const gateEvidence = {};
for (const section of ['Health', 'Browser QA', 'Review', 'Security', 'Performance']) {
  const evidence = {};
  for (const label of ['Command', 'URL', 'Base', 'Exit code', 'Artifact', 'Skip reason']) {
    const value = evidenceValue(section, label);
    if (value) evidence[label.toLowerCase().replace(/ /g, '_')] = value;
  }
  if (Object.keys(evidence).length) gateEvidence[section.toLowerCase().replace(/ /g, '_')] = evidence;
}

const result = {
  phase: lineValue('Phase'),
  goal: lineValue('Goal'),
  last_completed_agent: lineValue('Last completed agent'),
  quality_gates: {
    health: lineValue('Health'),
    browser_qa: lineValue('Browser QA'),
    windows_qa: lineValue('Windows QA'),
    review: lineValue('Review'),
    security: lineValue('Security'),
    performance: lineValue('Performance'),
    deployment: lineValue('Deployment'),
  },
  runtime: {
    install: lineValue('Install command'),
    dev: lineValue('Dev command'),
    test: lineValue('Test command'),
    lint: lineValue('Lint command'),
    typecheck: lineValue('Typecheck command'),
    local_url: lineValue('Local URL'),
    production_url: lineValue('Production URL'),
  },
  artifacts,
  gate_evidence: gateEvidence,
};
process.stdout.write(JSON.stringify(result));
NODE
)"
fi

