  IFS='|' read -r EXISTING_PHASE EXISTING_NEXT_AGENT EXISTING_NEXT_RECIPE EXISTING_LAST_COMPLETED_AGENT EXISTING_HEALTH_GATE EXISTING_BROWSER_QA_GATE EXISTING_WINDOWS_QA_GATE EXISTING_REVIEW_GATE EXISTING_SECURITY_GATE EXISTING_PERFORMANCE_GATE EXISTING_DEPLOYMENT_GATE EXISTING_INSTALL_COMMAND EXISTING_DEV_COMMAND EXISTING_TEST_COMMAND EXISTING_LINT_COMMAND EXISTING_TYPECHECK_COMMAND EXISTING_LOCAL_URL EXISTING_PRODUCTION_URL <<< "$EXISTING_STATE_INFO"

