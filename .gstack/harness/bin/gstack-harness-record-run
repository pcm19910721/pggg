#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
gstack-harness-record-run - record a structured GStack Harness usage event

Usage:
  gstack-harness-record-run [options]

Options:
  --target DIR             Target project directory. Default: current directory.
  --event NAME             Event name. Default: manual_snapshot.
  --status STATUS          Run status/verdict.
  --agent NAME             Agent used or recommended. Repeatable.
  --skill NAME             Skill used during the run. Repeatable.
  --tool NAME              Tool or command used during the run. Repeatable.
  --recipe NAME            Workflow recipe used or recommended.
  --intent TEXT            User intent or run purpose.
  --where-stalled TEXT     Where the run stalled.
  --user-correction TEXT   User correction captured during the run.
  --capability-gap TEXT    Capability gap observed. Repeatable.
  --artifact PATH          Artifact path to include. Repeatable.
  --warning TEXT           Warning to include. Repeatable.
  --blocker TEXT           Blocker to include. Repeatable.
  --notes TEXT             Additional notes.
  --template-source DIR    Template source directory.
  --no-registry            Do not append to the global project registry.
  -h, --help               Show help.

Environment:
  GSTACK_HARNESS_REGISTRY  Registry JSONL path. Default: ~/.gstack-harness/projects.jsonl
EOF
}

TARGET="."
EVENT="manual_snapshot"
STATUS=""
RECIPE=""
INTENT=""
WHERE_STALLED=""
USER_CORRECTION=""
NOTES=""
TEMPLATE_SOURCE=""
NO_REGISTRY=0
AGENTS=()
SKILLS=()
TOOLS=()
CAPABILITY_GAPS=()
ARTIFACTS=()
WARNINGS=()
BLOCKERS=()

while [ "$#" -gt 0 ]; do
  case "$1" in
    --target)
      TARGET="${2:-}"
      shift 2
      ;;
    --event)
      EVENT="${2:-}"
      shift 2
      ;;
    --status)
      STATUS="${2:-}"
      shift 2
      ;;
    --agent)
      AGENTS+=("${2:-}")
      shift 2
      ;;
    --skill)
      SKILLS+=("${2:-}")
      shift 2
      ;;
    --tool)
      TOOLS+=("${2:-}")
      shift 2
      ;;
    --recipe)
      RECIPE="${2:-}"
      shift 2
      ;;
    --intent)
      INTENT="${2:-}"
      shift 2
      ;;
    --where-stalled)
      WHERE_STALLED="${2:-}"
      shift 2
      ;;
    --user-correction)
      USER_CORRECTION="${2:-}"
      shift 2
      ;;
    --capability-gap)
      CAPABILITY_GAPS+=("${2:-}")
      shift 2
      ;;
    --artifact)
      ARTIFACTS+=("${2:-}")
      shift 2
      ;;
    --warning)
      WARNINGS+=("${2:-}")
      shift 2
      ;;
    --blocker)
      BLOCKERS+=("${2:-}")
      shift 2
      ;;
    --notes)
      NOTES="${2:-}"
      shift 2
      ;;
    --template-source)
      TEMPLATE_SOURCE="${2:-}"
      shift 2
      ;;
    --no-registry)
      NO_REGISTRY=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "ERROR: unknown argument: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

if ! command -v node >/dev/null 2>&1; then
  echo "ERROR: node is required to write structured usage run JSON" >&2
  exit 2
fi

TARGET_DIR="$(mkdir -p "$TARGET" && cd "$TARGET" && pwd)"
RUNS_DIR="$TARGET_DIR/.gstack/usage-runs"
GENERATED_AT="$(date -Iseconds)"
RUN_ID_PREFIX="$(date -u +%Y%m%dT%H%M%SZ)"
EVENT_SLUG="$(printf '%s' "$EVENT" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9._-' '-')"
EVENT_SLUG="${EVENT_SLUG%-}"
EVENT_SLUG="${EVENT_SLUG:-event}"
RUN_ID="${RUN_ID_PREFIX}-${EVENT_SLUG}-$$"
REGISTRY_PATH="${GSTACK_HARNESS_REGISTRY:-$HOME/.gstack-harness/projects.jsonl}"

join_lines() {
  local item
  for item in "$@"; do
    printf '%s\n' "$item"
  done
}

GIT_BRANCH="none"
GIT_DIRTY="unknown"
if git -C "$TARGET_DIR" rev-parse --show-toplevel >/dev/null 2>&1; then
  GIT_BRANCH="$(git -C "$TARGET_DIR" branch --show-current 2>/dev/null || true)"
  GIT_BRANCH="${GIT_BRANCH:-detached}"
  if [ -n "$(git -C "$TARGET_DIR" status --porcelain 2>/dev/null || true)" ]; then
    GIT_DIRTY="dirty"
  else
    GIT_DIRTY="clean"
  fi
fi

PRIMARY_AGENT=""
if [ "${#AGENTS[@]}" -gt 0 ]; then
  PRIMARY_AGENT="${AGENTS[0]}"
fi

export TARGET_DIR RUNS_DIR GENERATED_AT RUN_ID EVENT STATUS RECIPE INTENT
export WHERE_STALLED USER_CORRECTION NOTES TEMPLATE_SOURCE REGISTRY_PATH NO_REGISTRY
export GIT_BRANCH GIT_DIRTY
export AGENT="$PRIMARY_AGENT"
export GSTACK_RECORD_AGENTS="$(join_lines "${AGENTS[@]}")"
export GSTACK_RECORD_SKILLS="$(join_lines "${SKILLS[@]}")"
export GSTACK_RECORD_TOOLS="$(join_lines "${TOOLS[@]}")"
export GSTACK_RECORD_CAPABILITY_GAPS="$(join_lines "${CAPABILITY_GAPS[@]}")"
export GSTACK_RECORD_ARTIFACTS="$(join_lines "${ARTIFACTS[@]}")"
export GSTACK_RECORD_WARNINGS="$(join_lines "${WARNINGS[@]}")"
export GSTACK_RECORD_BLOCKERS="$(join_lines "${BLOCKERS[@]}")"

node <<'NODE'
const fs = require('fs');
const path = require('path');

const env = process.env;
const target = env.TARGET_DIR;
const runsDir = env.RUNS_DIR;
const statePath = path.join(target, '.gstack/project-state.json');

function readJson(file) {
  try {
    return JSON.parse(fs.readFileSync(file, 'utf8'));
  } catch {
    return {};
  }
}

function lines(name) {
  return String(env[name] || '')
    .split('\n')
    .map((item) => item.trim())
    .filter(Boolean);
}

function unique(items) {
  return Array.from(new Set(items.filter(Boolean)));
}

function needsProblemHandling(warnings, blockers) {
  const problemWarnings = new Set([
    'gbrain_query_timeout',
    'gbrain_query_failed',
    'code_context_status_failed',
    'gbrain_seed_failed',
  ]);
  return blockers.length > 0 || warnings.some((warning) => problemWarnings.has(String(warning)));
}

function rel(file) {
  return path.relative(target, file).split(path.sep).join('/');
}

const state = readJson(statePath);
const projectId = state.project_id || path.basename(target).toLowerCase().replace(/[^a-z0-9._-]+/g, '-').replace(/-$/, '') || 'project';
const event = env.EVENT || 'manual_snapshot';
const status = env.STATUS || state.foundation?.readiness || 'unknown';
const recipe = env.RECIPE || state.next_recommended_recipe || '';
const agents = unique([
  ...lines('GSTACK_RECORD_AGENTS'),
  env.AGENT || '',
  state.next_recommended_agent || '',
]);
const skills = unique(lines('GSTACK_RECORD_SKILLS'));
const tools = unique(lines('GSTACK_RECORD_TOOLS'));
const agent = agents[0] || '';
const extraWarnings = lines('GSTACK_RECORD_WARNINGS');
const extraBlockers = lines('GSTACK_RECORD_BLOCKERS');
const warnings = unique([...(Array.isArray(state.warnings) ? state.warnings : []), ...extraWarnings]);
const blockers = unique([...(Array.isArray(state.blockers) ? state.blockers : []), ...extraBlockers]);
const problemHandlingRequired = Boolean(
  state.problem_handling_required ||
  state.foundation?.problem_handling_required ||
  needsProblemHandling(warnings, blockers)
);
const artifacts = unique([
  ...Object.values(state.artifacts || {}).filter((value) => typeof value === 'string' && value),
  ...lines('GSTACK_RECORD_ARTIFACTS'),
]);
const capabilityGaps = unique([
  ...((state.system_tuning?.capability_gaps || []).map((gap) => typeof gap === 'string' ? gap : gap.id).filter(Boolean)),
  ...lines('GSTACK_RECORD_CAPABILITY_GAPS'),
]);

fs.mkdirSync(runsDir, { recursive: true });

const run = {
  schema: 'gstack-harness.usage_run.v1',
  run_id: env.RUN_ID,
  generated_at: env.GENERATED_AT,
  event,
  project_id: projectId,
  target,
  template_source: env.TEMPLATE_SOURCE || state.template_source || '',
  source: 'gstack-harness-record-run',
  git: {
    branch: env.GIT_BRANCH || 'none',
    state: env.GIT_DIRTY || 'unknown',
  },
  status,
  phase: state.phase || '',
  foundation: state.foundation || {},
  quality_gates: state.quality_gates || {},
  chosen_recipe: recipe,
  agents_used: agents,
  skills_used: skills,
  tools_used: tools,
  warnings,
  blockers,
  problem_handling_required: problemHandlingRequired,
  observations: {
    user_intent: env.INTENT || '',
    where_it_stalled: env.WHERE_STALLED || '',
    user_correction: env.USER_CORRECTION || '',
    missing_context: '',
    bad_handoff: '',
    gate_issue: '',
    capability_gaps: capabilityGaps,
    notes: env.NOTES || '',
  },
  artifacts,
  next_recommended_agent: state.next_recommended_agent || '',
  next_recommended_recipe: state.next_recommended_recipe || '',
};

const runFile = path.join(runsDir, `${env.RUN_ID}.json`);
fs.writeFileSync(runFile, JSON.stringify(run, null, 2) + '\n');

const indexPath = path.join(runsDir, 'index.jsonl');
const summary = {
  run_id: run.run_id,
  generated_at: run.generated_at,
  event: run.event,
  project_id: run.project_id,
  target: run.target,
  status: run.status,
  recipe: run.chosen_recipe,
  agent,
  agents,
  skills,
  tools,
  warnings,
  blockers,
  file: rel(runFile),
};
fs.appendFileSync(indexPath, JSON.stringify(summary) + '\n');

const nextState = { ...state };
nextState.schema = nextState.schema || 'gstack-harness.project_state.v1';
nextState.project_id = nextState.project_id || projectId;
nextState.target = nextState.target || target;
nextState.warnings = warnings;
nextState.blockers = blockers;
nextState.problem_handling_required = problemHandlingRequired;
if (capabilityGaps.length) {
  const existingGaps = Array.isArray(nextState.system_tuning?.capability_gaps)
    ? nextState.system_tuning.capability_gaps
    : [];
  const existingIds = new Set(existingGaps.map((gap) => typeof gap === 'string' ? gap : gap.id).filter(Boolean));
  const newGaps = capabilityGaps
    .filter((gap) => !existingIds.has(gap))
    .map((gap) => ({ id: gap, status: 'open', source: 'usage_run', latest_run: rel(runFile) }));
  nextState.system_tuning = {
    ...(nextState.system_tuning || {}),
    capability_gaps: [...existingGaps, ...newGaps],
  };
}
nextState.usage = {
  ...(nextState.usage || {}),
  runs_dir: '.gstack/usage-runs',
  index: '.gstack/usage-runs/index.jsonl',
  latest_run: rel(runFile),
  latest_event: event,
  latest_recorded_at: run.generated_at,
  latest_agents: agents,
  latest_skills: skills,
  latest_tools: tools,
};

if (env.NO_REGISTRY !== '1') {
  const registry = env.REGISTRY_PATH;
  try {
    fs.mkdirSync(path.dirname(registry), { recursive: true });
    fs.appendFileSync(registry, JSON.stringify({
      registered_at: run.generated_at,
      project_id: run.project_id,
      target: run.target,
      template_source: run.template_source,
      latest_run: rel(runFile),
    }) + '\n');
  } catch (err) {
    const warning = 'usage_global_registry_write_failed';
    if (!nextState.warnings.includes(warning)) nextState.warnings.push(warning);
    const registryErrorPath = path.join(runsDir, `${env.RUN_ID}-registry-error.txt`);
    fs.writeFileSync(registryErrorPath, `${err instanceof Error ? err.message : String(err)}\n`);
  }
}

fs.mkdirSync(path.dirname(statePath), { recursive: true });
fs.writeFileSync(statePath, JSON.stringify(nextState, null, 2) + '\n');

process.stdout.write(rel(runFile) + '\n');
NODE
