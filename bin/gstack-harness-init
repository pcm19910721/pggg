preserve_runtime_value() {
  local current="$1"
  local existing="$2"
  if [ -n "$existing" ] && { [ -z "$current" ] || [ "$current" = "not_required" ]; }; then
    printf '%s\n' "$existing"
  else
    printf '%s\n' "$current"
  fi
}

INSTALL_COMMAND="$(preserve_runtime_value "${INSTALL_COMMAND:-}" "$EXISTING_INSTALL_COMMAND")"
