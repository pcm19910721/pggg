    "provider": "gitnexus",
    "config": ".ai-context/project.json",
    "status_file": ".ai-context/gitnexus-status.json",
    "index_summary": ".ai-context/gitnexus-index.md",
    "runs": ".ai-context/runs",
    "optional_ua_knowledge_graph": ".understand-anything/knowledge-graph.json",
    "optional_ua_domain_graph": ".understand-anything/domain-graph.json",
    "optional_ua_diff_overlay": ".understand-anything/diff-overlay.json"
  },
  "problem_handling_agent": ".gstack/harness/agents/problem-handling.md",
  "problem_handling_report": "docs/PROBLEM_HANDLING_REPORT.md",
  "system_tuning_report": "docs/SYSTEM_TUNING_REPORT.md",
  "code_context_report": "docs/CODE_CONTEXT_REPORT.md",
