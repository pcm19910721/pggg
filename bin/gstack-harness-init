      if is_readiness_warning "$existing_warning"; then
        continue
      fi
      WARNINGS+=("$existing_warning")
    fi
  done < <(node -e 'const fs=require("fs"); const p=process.argv[1]; const s=JSON.parse(fs.readFileSync(p,"utf8")); for (const w of (s.warnings||[])) console.log(String(w));' "$TARGET_DIR/.gstack/project-state.json" 2>/dev/null || true)

  EXISTING_PROBLEM_HANDLING_JSON="$(node -e 'const fs=require("fs"); const p=process.argv[1]; const s=JSON.parse(fs.readFileSync(p,"utf8")); console.log(JSON.stringify(s.problem_handling || null));' "$TARGET_DIR/.gstack/project-state.json" 2>/dev/null || printf 'null')"
  EXISTING_SYSTEM_TUNING_JSON="$(node -e 'const fs=require("fs"); const p=process.argv[1]; const s=JSON.parse(fs.readFileSync(p,"utf8")); console.log(JSON.stringify(s.system_tuning || {active_issue:null,capability_gaps:[]}));' "$TARGET_DIR/.gstack/project-state.json" 2>/dev/null || printf '{"active_issue":null,"capability_gaps":[]}' )"
