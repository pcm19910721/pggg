#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
gstack-harness-usage-report - aggregate GStack Harness usage runs

Usage:
  gstack-harness-usage-report [options]

Options:
  --target DIR             Target project to scan. Repeatable.
  --registry FILE          Project registry JSONL. Default: ~/.gstack-harness/projects.jsonl
  --output FILE            Markdown report output. Default: docs/USAGE_FEEDBACK_REPORT.md in template source.
  --json-output FILE       Optional machine-readable summary output.
  --stdout                 Print markdown report instead of writing it.
  -h, --help               Show help.
EOF
}

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TEMPLATE_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
if [ ! -f "$TEMPLATE_ROOT/HARNESS_PRODUCT_USAGE.md" ] && command -v node >/dev/null 2>&1; then
  TARGET_CANDIDATE="$(cd "$SCRIPT_DIR/../../.." 2>/dev/null && pwd || true)"
  if [ -n "$TARGET_CANDIDATE" ] && [ -f "$TARGET_CANDIDATE/.gstack/project-state.json" ]; then
    DETECTED_TEMPLATE_ROOT="$(node -e 'const fs=require("fs"); const p=process.argv[1]; try { const s=JSON.parse(fs.readFileSync(p,"utf8")); if (s.template_source) process.stdout.write(s.template_source); } catch {}' "$TARGET_CANDIDATE/.gstack/project-state.json" 2>/dev/null || true)"
    if [ -n "$DETECTED_TEMPLATE_ROOT" ] && [ -d "$DETECTED_TEMPLATE_ROOT" ]; then
      TEMPLATE_ROOT="$DETECTED_TEMPLATE_ROOT"
    fi
  fi
fi
REGISTRY="${GSTACK_HARNESS_REGISTRY:-$HOME/.gstack-harness/projects.jsonl}"
OUTPUT="$TEMPLATE_ROOT/docs/USAGE_FEEDBACK_REPORT.md"
JSON_OUTPUT=""
PRINT_STDOUT=0
TARGETS=()

while [ "$#" -gt 0 ]; do
  case "$1" in
    --target)
      TARGETS+=("${2:-}")
      shift 2
      ;;
    --registry)
      REGISTRY="${2:-}"
      shift 2
      ;;
    --output)
      OUTPUT="${2:-}"
      shift 2
      ;;
    --json-output)
      JSON_OUTPUT="${2:-}"
      shift 2
      ;;
    --stdout)
      PRINT_STDOUT=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "ERROR: unknown argument: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

if ! command -v node >/dev/null 2>&1; then
  echo "ERROR: node is required to aggregate usage run JSON" >&2
  exit 2
fi

join_lines() {
  local item
  for item in "$@"; do
    printf '%s\n' "$item"
  done
}

export TEMPLATE_ROOT REGISTRY OUTPUT JSON_OUTPUT PRINT_STDOUT
export GSTACK_REPORT_TARGETS="$(join_lines "${TARGETS[@]}")"

node <<'NODE'
const fs = require('fs');
const path = require('path');

const env = process.env;

function lines(value) {
  return String(value || '').split('\n').map((line) => line.trim()).filter(Boolean);
}

function readJson(file) {
  try {
    return JSON.parse(fs.readFileSync(file, 'utf8'));
  } catch {
    return null;
  }
}

function readRegistry(file) {
  if (!file || !fs.existsSync(file)) return [];
  return fs.readFileSync(file, 'utf8')
    .split(/\r?\n/)
    .filter(Boolean)
    .map((line) => {
      try {
        return JSON.parse(line);
      } catch {
        return null;
      }
    })
    .filter(Boolean)
    .map((entry) => entry.target)
    .filter(Boolean);
}

function absTarget(target) {
  return path.resolve(target);
}

function count(items) {
  const map = new Map();
  for (const item of items.filter(Boolean)) {
    map.set(item, (map.get(item) || 0) + 1);
  }
  return Array.from(map.entries())
    .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
    .map(([name, total]) => ({ name, total }));
}

function tableRows(rows, columns) {
  if (rows.length === 0) return '_None._\n';
  const header = `| ${columns.join(' | ')} |`;
  const divider = `| ${columns.map(() => '---').join(' | ')} |`;
  const body = rows.map((row) => `| ${columns.map((column) => String(row[column] ?? '').replace(/\|/g, '\\|')).join(' | ')} |`);
  return [header, divider, ...body].join('\n') + '\n';
}

const explicitTargets = lines(env.GSTACK_REPORT_TARGETS).map(absTarget);
const registryTargets = readRegistry(env.REGISTRY).map(absTarget);
const targets = Array.from(new Set([...explicitTargets, ...registryTargets]));

const runs = [];
const missingTargets = [];

for (const target of targets) {
  const runsDir = path.join(target, '.gstack/usage-runs');
  if (!fs.existsSync(runsDir)) {
    missingTargets.push(target);
    continue;
  }
  for (const name of fs.readdirSync(runsDir)) {
    if (!name.endsWith('.json')) continue;
    const file = path.join(runsDir, name);
    const run = readJson(file);
    if (!run) continue;
    runs.push({ ...run, file });
  }
}

runs.sort((a, b) => String(b.generated_at || '').localeCompare(String(a.generated_at || '')));

const warnings = count(runs.flatMap((run) => Array.isArray(run.warnings) ? run.warnings : []));
const blockers = count(runs.flatMap((run) => Array.isArray(run.blockers) ? run.blockers : []));
const recipes = count(runs.map((run) => run.chosen_recipe || run.next_recommended_recipe || 'unknown'));
const events = count(runs.map((run) => run.event || 'unknown'));
const statuses = count(runs.map((run) => run.status || run.foundation?.readiness || 'unknown'));
const stalls = count(runs.map((run) => run.observations?.where_it_stalled || '').filter(Boolean));
const corrections = count(runs.map((run) => run.observations?.user_correction || '').filter(Boolean));
const capabilityGaps = count(runs.flatMap((run) => run.observations?.capability_gaps || []));

const recommendations = [];
const warningNames = warnings.map((item) => item.name);
if (warningNames.some((name) => name.includes('gbrain_query'))) {
  recommendations.push('Keep gbrain timeout handling in the required Problem Handling path, and consider adding retry/backoff evidence to the run record.');
}
if (warningNames.includes('runtime_missing')) {
  recommendations.push('Improve runtime command detection or add a Foundation Remediation step for missing test/lint/dev commands.');
}
if (warningNames.includes('browse_missing')) {
  recommendations.push('Route browser runner setup to Foundation Remediation before user-visible QA recipes.');
}
if (warningNames.includes('not_git_repo')) {
  recommendations.push('Clarify target_project git requirements before review, release, and ship recipes.');
}
if (stalls.length > 0) {
  recommendations.push('Promote repeated stall points into handoff contract changes or workflow recipe changes.');
}
if (capabilityGaps.length > 0) {
  recommendations.push('Review repeated capability gaps and decide whether they need a new agent, stricter gate, or better handoff artifact.');
}
if (recommendations.length === 0) {
  recommendations.push(runs.length === 0 ? 'No usage runs found yet. Run gstack-harness-init in target projects or record snapshots with .gstack/harness/bin/gstack-harness-record-run.' : 'No recurring automation issue is visible from the current run set.');
}

const recentRows = runs.slice(0, 15).map((run) => ({
  Time: run.generated_at || '',
  Project: run.project_id || '',
  Event: run.event || '',
  Status: run.status || run.foundation?.readiness || '',
  Recipe: run.chosen_recipe || run.next_recommended_recipe || '',
  Warnings: (run.warnings || []).join(', '),
}));

const countRows = (items) => items.slice(0, 12).map((item) => ({ Name: item.name, Count: item.total }));

const generatedAt = new Date().toISOString();
const md = `# Usage Feedback Report

Generated: ${generatedAt}

## Summary

- Projects scanned: ${targets.length}
- Usage runs found: ${runs.length}
- Targets without usage runs: ${missingTargets.length}

## Recommended Template Source Actions

${recommendations.map((item) => `- ${item}`).join('\n')}

## Warning Counts

${tableRows(countRows(warnings), ['Name', 'Count'])}
## Blocker Counts

${tableRows(countRows(blockers), ['Name', 'Count'])}
## Recipe Counts

${tableRows(countRows(recipes), ['Name', 'Count'])}
## Event Counts

${tableRows(countRows(events), ['Name', 'Count'])}
## Status Counts

${tableRows(countRows(statuses), ['Name', 'Count'])}
## Stall Points

${tableRows(countRows(stalls), ['Name', 'Count'])}
## User Corrections

${tableRows(countRows(corrections), ['Name', 'Count'])}
## Capability Gaps

${tableRows(countRows(capabilityGaps), ['Name', 'Count'])}
## Recent Runs

${tableRows(recentRows, ['Time', 'Project', 'Event', 'Status', 'Recipe', 'Warnings'])}
## Scanned Targets

${targets.length === 0 ? '_None._' : targets.map((target) => `- ${target}`).join('\n')}
`;

const summary = {
  schema: 'gstack-harness.usage_feedback.v1',
  generated_at: generatedAt,
  registry: env.REGISTRY,
  projects_scanned: targets.length,
  usage_runs_found: runs.length,
  targets,
  missing_targets: missingTargets,
  counts: {
    warnings,
    blockers,
    recipes,
    events,
    statuses,
    stalls,
    user_corrections: corrections,
    capability_gaps: capabilityGaps,
  },
  recommendations,
  recent_runs: runs.slice(0, 50).map((run) => ({
    run_id: run.run_id,
    generated_at: run.generated_at,
    project_id: run.project_id,
    event: run.event,
    status: run.status,
    recipe: run.chosen_recipe || run.next_recommended_recipe || '',
    warnings: run.warnings || [],
    blockers: run.blockers || [],
    file: run.file,
  })),
};

if (env.JSON_OUTPUT) {
  fs.mkdirSync(path.dirname(env.JSON_OUTPUT), { recursive: true });
  fs.writeFileSync(env.JSON_OUTPUT, JSON.stringify(summary, null, 2) + '\n');
}

if (env.PRINT_STDOUT === '1') {
  process.stdout.write(md);
} else {
  fs.mkdirSync(path.dirname(env.OUTPUT), { recursive: true });
  fs.writeFileSync(env.OUTPUT, md);
  process.stdout.write(`${env.OUTPUT}\n`);
}
NODE
